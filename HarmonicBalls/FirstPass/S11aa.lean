import HarmonicBalls.Defs.LQGMetric

/-!
# Universe lift of the LQG metric axioms I and III (blocker U of n2; task fp-S11aa-lqg-metric-universe-lift)

`IsLQGMetric.satisfiesLQGMetricAxioms` (`Defs/LQGMetric.lean`) quantifies over `Ω : Type`, while the decoder statements
(`LocalMetricReplacementStmt`, `FirstPass/S11r/LocalMetricReplacement.lean`) quantify over `Ω : Type u`. This file proves,
for `Ω : Type u`, the two almost sure statements n2 needs, without changing the Defs (option (b) of the operator decision):

* (I)   `∀ᵐ ω, IsEuclideanLengthMetric (𝔇 (addFunPairing (hC ω) f))` for a continuous `f`;
* (III) `∀ᵐ ω, ∀ f continuous, ∀ u v, ENNReal.ofReal (𝔇 (addFunPairing (hC ω) f) u v) = weylScaling (𝔇 (hC ω)) ξ f u v`.

Transport to a Type-0 model. Let `G0 ⊆ Ω` be measurable of full measure on which the circle process is continuous on
`(0, ∞) × ℂ` (`ae_continuousOn_circle`). The sample `sample ω : CircleSample` is `(hC ω, posCircle hcirc ω)` on `G0`, where
`posCircle` replaces the circle averages of radius `r ≤ 0` by `0` (they are not observables, `GFFObservable.IsAdmissible`),
and the constant sample `(0, 0)` off `G0`. `CircleSample` is the subtype of `PairingFun × (ℝ → ℂ → ℝ)` of pairs whose circle
component is continuous on `(0, ∞) × ℂ`; it has the product σ-algebra, so every observable is a coordinate, hence measurable.
Because the default is continuous, the image lies in `CircleSample` everywhere, and no measurability of the continuity event
is needed. This is a modification on a null set of the transport in notes/fp-gaps/CHATGPT-z4-weylshift-frozen.md §5, which
completes `P` instead.
The push-forward `P.map sample` is a whole-plane GFF on `CircleSample` (all six clauses of `IsWholePlaneGFF` transfer),
the axioms are applied to it with `Ω := CircleSample : Type`, and the conclusions are pulled back along `sample` (`ae_of_ae_map`).
-/

open HarmonicBalls MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal

namespace FirstPassS11aa

universe u

/-- Pairing functionals `(ℂ → ℝ) → ℝ` with the σ-algebra `HarmonicBalls.distributionMeasurableSpace` generated by the
test-function pairings (Gwynne-Miller, Section 1.2). A type synonym, so that the σ-algebra is attached to this name. -/
def PairingFun : Type := (ℂ → ℝ) → ℝ

/-- The pairing functional viewed in `PairingFun`. -/
def toPairingFun (T : (ℂ → ℝ) → ℝ) : PairingFun := T

/-- The σ-algebra of `PairingFun`: generated by the test-function pairings, as `HarmonicBalls.distributionMeasurableSpace`
(stated directly on `PairingFun`, so that no unfolding of the type synonym is needed). -/
@[instance_reducible]
def pairingFunSigma : MeasurableSpace PairingFun :=
  ⨆ (φ : ℂ → ℝ) (_ : IsTestFunction (univ : Set ℂ) φ), MeasurableSpace.comap (fun T : PairingFun => T φ) inferInstance

noncomputable instance : MeasurableSpace PairingFun := pairingFunSigma

/-- Pairs (pairing functional, circle process) whose circle process is continuous on `(0, ∞) × ℂ`: a Type-0 space for the
transported whole-plane GFF (Duplantier-Sheffield, circle average process). -/
abbrev CircleSample : Type :=
  {p : PairingFun × (ℝ → ℂ → ℝ) // ContinuousOn (fun q : ℝ × ℂ => p.2 q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ))}

/-- Evaluation at a test function is measurable on the pairing functionals. -/
lemma measurable_evalPairing {φ : ℂ → ℝ} (hφ : IsTestFunction (univ : Set ℂ) φ) :
    Measurable fun T : PairingFun => T φ := by
  refine measurable_iff_comap_le.2 ?_
  exact le_iSup₂ (f := fun (ψ : ℂ → ℝ) (_ : IsTestFunction (univ : Set ℂ) ψ) =>
    MeasurableSpace.comap (fun T : PairingFun => T ψ) inferInstance) φ hφ

/-- A family of pairings with test functions, measurable in `ω`, is measurable as a map into `PairingFun`. -/
lemma measurable_toPairingFun {Ω : Type*} [MeasurableSpace Ω] {hC : Ω → (ℂ → ℝ) → ℝ}
    (h : ∀ φ, IsTestFunction (univ : Set ℂ) φ → Measurable fun ω => hC ω φ) :
    Measurable fun ω => toPairingFun (hC ω) := by
  refine measurable_iff_comap_le.2 ?_
  show MeasurableSpace.comap _ pairingFunSigma ≤ _
  unfold pairingFunSigma
  simp only [MeasurableSpace.comap_iSup]
  refine iSup₂_le fun φ hφ => ?_
  rw [MeasurableSpace.comap_comp]
  exact (h φ hφ).comap_le

/-- Circle process with the radii `r ≤ 0` replaced by `0`. -/
noncomputable def posCircle {Ω : Type*} (hcirc : Ω → ℝ → ℂ → ℝ) (ω : Ω) : ℝ → ℂ → ℝ :=
  fun r z => if 0 < r then hcirc ω r z else 0

lemma measurable_posCircle {Ω : Type*} [MeasurableSpace Ω] {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : ∀ r z, 0 < r → Measurable fun ω => hcirc ω r z) :
    Measurable fun ω => posCircle hcirc ω := by
  refine measurable_pi_iff.2 fun r => measurable_pi_iff.2 fun z => ?_
  by_cases hr : 0 < r
  · simpa [posCircle, hr] using h r z hr
  · simp [posCircle, hr]

lemma measurable_circleCoord (r : ℝ) (z : ℂ) : Measurable fun s : CircleSample => s.1.2 r z := by
  have h1 : Measurable fun g : ℝ → ℂ → ℝ => g r := measurable_pi_apply r
  have h2 : Measurable fun g : ℂ → ℝ => g z := measurable_pi_apply z
  exact (h2.comp h1).comp (measurable_snd.comp measurable_subtype_coe)

/-- Every admissible observable is a measurable function of the sample. -/
lemma measurable_evalObs (o : GFFObservable.Admissible) :
    Measurable fun s : CircleSample => o.1.eval s.1.1 s.1.2 := by
  obtain ⟨o, ho⟩ := o
  cases o with
  | pairing φ => exact (measurable_evalPairing ho).comp (measurable_fst.comp measurable_subtype_coe)
  | circle r z => exact measurable_circleCoord r z

/-- A measurable full-measure set on which the circle process is continuous on `(0, ∞) × ℂ`. -/
lemma exists_good_set {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : ∀ᵐ ω ∂P, ContinuousOn (fun q : ℝ × ℂ => hcirc ω q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ))) :
    ∃ G0 : Set Ω, MeasurableSet G0 ∧ (∀ᵐ ω ∂P, ω ∈ G0) ∧
      ∀ ω ∈ G0, ContinuousOn (fun q : ℝ × ℂ => hcirc ω q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ)) := by
  obtain ⟨t, hsub, htm, ht0⟩ := exists_measurable_superset_of_null (ae_iff.1 h)
  refine ⟨tᶜ, htm.compl, ?_, fun ω hω => ?_⟩
  · refine ae_iff.2 ?_
    simpa using ht0
  · by_contra hc
    exact hω (hsub hc)

open Classical in
/-- The sample map: `(hC ω, posCircle hcirc ω)` on `G0`, the constant sample `(0, 0)` off `G0`. -/
noncomputable def sampleFun {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) (G0 : Set Ω) (ω : Ω) :
    PairingFun × (ℝ → ℂ → ℝ) :=
  if ω ∈ G0 then (toPairingFun (hC ω), posCircle hcirc ω)
  else (toPairingFun (fun _ => (0 : ℝ)), fun _ _ => 0)

lemma sampleFun_mem {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) {G0 : Set Ω}
    (hG0 : ∀ ω ∈ G0, ContinuousOn (fun q : ℝ × ℂ => hcirc ω q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ))) (ω : Ω) :
    ContinuousOn (fun q : ℝ × ℂ => (sampleFun hC hcirc G0 ω).2 q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ)) := by
  unfold sampleFun
  split_ifs with hω
  · refine (hG0 ω hω).congr fun q hq => ?_
    simp [posCircle, show (0 : ℝ) < q.1 from hq.1]
  · exact continuousOn_const

/-- The transported sample map `Ω → CircleSample`. -/
noncomputable def sample {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) (G0 : Set Ω)
    (hG0 : ∀ ω ∈ G0, ContinuousOn (fun q : ℝ × ℂ => hcirc ω q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ))) :
    Ω → CircleSample :=
  fun ω => ⟨sampleFun hC hcirc G0 ω, sampleFun_mem hC hcirc hG0 ω⟩

lemma measurable_sampleFun {Ω : Type*} [MeasurableSpace Ω] {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    {G0 : Set Ω} (hG0m : MeasurableSet G0)
    (hC_meas : ∀ φ, IsTestFunction (univ : Set ℂ) φ → Measurable fun ω => hC ω φ)
    (hcirc_meas : ∀ r z, 0 < r → Measurable fun ω => hcirc ω r z) :
    Measurable (sampleFun hC hcirc G0) := by
  unfold sampleFun
  refine Measurable.ite hG0m ?_ measurable_const
  exact (measurable_toPairingFun hC_meas).prodMk (measurable_posCircle hcirc_meas)

lemma measurable_sample {Ω : Type*} [MeasurableSpace Ω] {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    {G0 : Set Ω} (hG0m : MeasurableSet G0)
    (hC_meas : ∀ φ, IsTestFunction (univ : Set ℂ) φ → Measurable fun ω => hC ω φ)
    (hcirc_meas : ∀ r z, 0 < r → Measurable fun ω => hcirc ω r z)
    (hG0 : ∀ ω ∈ G0, ContinuousOn (fun q : ℝ × ℂ => hcirc ω q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ))) :
    Measurable (sample hC hcirc G0 hG0) :=
  (measurable_sampleFun hG0m hC_meas hcirc_meas).subtype_mk

lemma sampleFun_of_mem {Ω : Type*} {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {G0 : Set Ω} {ω : Ω}
    (hω : ω ∈ G0) : sampleFun hC hcirc G0 ω = (toPairingFun (hC ω), posCircle hcirc ω) := by
  unfold sampleFun
  simp [hω]

/-- On `G0`, the sample carries the original pairing functional. -/
lemma sample_fst_eq {Ω : Type*} {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {G0 : Set Ω}
    (hG0 : ∀ ω ∈ G0, ContinuousOn (fun q : ℝ × ℂ => hcirc ω q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ)))
    {ω : Ω} (hω : ω ∈ G0) : (sample hC hcirc G0 hG0 ω).1.1 = hC ω :=
  congrArg Prod.fst (sampleFun_of_mem hω)

/-- On `G0`, every admissible observable of the sample agrees with the original one. -/
lemma eval_sample_eq {Ω : Type*} {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {G0 : Set Ω} {ω : Ω}
    (hω : ω ∈ G0) (o : GFFObservable.Admissible) :
    o.1.eval (hC ω) (hcirc ω) = o.1.eval (sampleFun hC hcirc G0 ω).1 (sampleFun hC hcirc G0 ω).2 := by
  obtain ⟨o, ho⟩ := o
  cases o with
  | pairing φ => simp [sampleFun, hω, GFFObservable.eval, toPairingFun]
  | circle r z =>
    have hr : 0 < r := ho
    simp [sampleFun, hω, GFFObservable.eval, posCircle, hr]

/-- `∫ g d(P.map S) = ∫ g ∘ S dP`. -/
lemma integral_map_of_measurable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω}
    {S : Ω → Ω'} (hS : Measurable S) {g : Ω' → ℝ} (hg : Measurable g) :
    ∫ s, g s ∂(P.map S) = ∫ ω, g (S ω) ∂P :=
  integral_map hS.aemeasurable hg.aestronglyMeasurable

/-- Covariances are preserved by a push-forward that agrees almost surely with the observables. -/
lemma covariance_map_of_ae {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] {P : Measure Ω}
    {S : Ω → Ω'} (hS : Measurable S) {X' Y' : Ω' → ℝ} (hX' : Measurable X') (hY' : Measurable Y')
    {X Y : Ω → ℝ} (hX : ∀ᵐ ω ∂P, X' (S ω) = X ω) (hY : ∀ᵐ ω ∂P, Y' (S ω) = Y ω) :
    covariance X' Y' (P.map S) = covariance X Y P := by
  have hmX : ∫ s, X' s ∂(P.map S) = ∫ ω, X ω ∂P :=
    (integral_map_of_measurable hS hX').trans (integral_congr_ae hX)
  have hmY : ∫ s, Y' s ∂(P.map S) = ∫ ω, Y ω ∂P :=
    (integral_map_of_measurable hS hY').trans (integral_congr_ae hY)
  have key : ∀ c d : ℝ, ∫ s, (X' s - c) * (Y' s - d) ∂(P.map S) = ∫ ω, (X ω - c) * (Y ω - d) ∂P := by
    intro c d
    refine (integral_map_of_measurable hS ((hX'.sub measurable_const).mul (hY'.sub measurable_const))).trans
      (integral_congr_ae ?_)
    filter_upwards [hX, hY] with ω h1 h2
    show (X' (S ω) - c) * (Y' (S ω) - d) = (X ω - c) * (Y ω - d)
    rw [h1, h2]
  unfold covariance
  rw [hmX, hmY]
  exact key _ _

/-- Transport of Gaussian laws along a measurable map: `HasGaussianLaw (X ∘ S) P` gives `HasGaussianLaw X (P.map S)`. -/
lemma hasGaussianLaw_map_of_comp {Ω Ω' E : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    [MeasurableSpace E] [TopologicalSpace E] [AddCommMonoid E] [Module ℝ E] {P : Measure Ω}
    {S : Ω → Ω'} (hS : Measurable S) {X : Ω' → E} (hX : Measurable X)
    (h : HasGaussianLaw (fun ω => X (S ω)) P) : HasGaussianLaw X (P.map S) where
  aemeasurable := hX.aemeasurable
  isGaussian_map := by
    rw [Measure.map_map hX hS]
    exact h.isGaussian_map

/-- The transported model: the push-forward of `P` along `sample` is a whole-plane GFF on `CircleSample`, with
pairing observable `s ↦ s.1.1` and circle process `s ↦ s.1.2`. -/
theorem isWholePlaneGFF_map_sample {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hC : Ω → (ℂ → ℝ) → ℝ}
    {hcirc : Ω → ℝ → ℂ → ℝ} (hGFF : IsWholePlaneGFF P hC hcirc) {G0 : Set Ω} (hG0m : MeasurableSet G0)
    (hG0 : ∀ᵐ ω ∂P, ω ∈ G0)
    (hG0c : ∀ ω ∈ G0, ContinuousOn (fun q : ℝ × ℂ => hcirc ω q.1 q.2) (Ioi (0 : ℝ) ×ˢ (univ : Set ℂ))) :
    IsWholePlaneGFF (P.map (sample hC hcirc G0 hG0c)) (fun s : CircleSample => s.1.1)
      (fun s : CircleSample => s.1.2) := by
  have hSm : Measurable (sample hC hcirc G0 hG0c) :=
    measurable_sample hG0m hGFF.measurable_pairing hGFF.measurable_circle hG0c
  refine
    { measurable_pairing := fun φ hφ => (measurable_evalPairing hφ).comp (measurable_fst.comp measurable_subtype_coe)
      measurable_circle := fun r z _ => measurable_circleCoord r z
      isGaussianProcess := ⟨fun I => ?_⟩
      integral_eq_zero := fun o ho => ?_
      covariance_eq := fun o o' ho ho' => ?_
      ae_continuousOn_circle := Filter.Eventually.of_forall fun s => s.2 }
  · -- the finite-dimensional laws of the observables agree with those of `P`
    refine hasGaussianLaw_map_of_comp hSm ?_ ?_
    · refine Measurable.of_eval fun i => ?_
      exact measurable_evalObs i.1
    · refine (hGFF.isGaussianProcess.hasGaussianLaw I).congr ?_
      filter_upwards [hG0] with ω hω
      funext i
      exact eval_sample_eq hω i.1
  · have hm : Measurable fun s : CircleSample => o.eval s.1.1 s.1.2 := by
      have := measurable_evalObs ⟨o, ho⟩
      exact this
    have hae : (fun ω => o.eval (sample hC hcirc G0 hG0c ω).1.1 (sample hC hcirc G0 hG0c ω).1.2) =ᵐ[P]
        fun ω => o.eval (hC ω) (hcirc ω) := by
      filter_upwards [hG0] with ω hω
      exact (eval_sample_eq hω ⟨o, ho⟩).symm
    exact ((integral_map_of_measurable hSm hm).trans (integral_congr_ae hae)).trans
      (hGFF.integral_eq_zero o ho)
  · have hm : Measurable fun s : CircleSample => o.eval s.1.1 s.1.2 := by
      have := measurable_evalObs ⟨o, ho⟩
      exact this
    have hm' : Measurable fun s : CircleSample => o'.eval s.1.1 s.1.2 := by
      have := measurable_evalObs ⟨o', ho'⟩
      exact this
    refine (covariance_map_of_ae hSm hm hm' ?_ ?_).trans (hGFF.covariance_eq o o' ho ho')
    · filter_upwards [hG0] with ω hω
      exact (eval_sample_eq hω ⟨o, ho⟩).symm
    · filter_upwards [hG0] with ω hω
      exact (eval_sample_eq hω ⟨o', ho'⟩).symm

/-- `addFunPairing T 0 = T`. -/
lemma addFunPairing_zero_fun (T : PairingFun) : addFunPairing T (fun _ => (0 : ℝ)) = T := by
  funext φ
  simp [addFunPairing]

/-- **Universe lift of axiom I** (n2 blocker U, option (b)). For `Ω : Type u` with a whole-plane GFF `(P, hC, hcirc)` and an
LQG metric `𝔇` of Weyl exponent `ξ` (`IsLQGMetric`), and a continuous `f`, almost surely the metric of `hC ω + f` is a
Euclidean length metric. -/
theorem ae_isEuclideanLengthMetric_universe {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}
    (h𝔇 : IsLQGMetric γ ξ 𝔇) {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hGFF : IsWholePlaneGFF P hC hcirc)
    (f : ℂ → ℝ) (hf : Continuous f) :
    ∀ᵐ ω ∂P, IsEuclideanLengthMetric (𝔇 (addFunPairing (hC ω) f)) := by
  obtain ⟨G0, hG0m, hG0, hG0c⟩ := exists_good_set hGFF.ae_continuousOn_circle
  have hGFF' := isWholePlaneGFF_map_sample hGFF hG0m hG0 hG0c
  have hax := h𝔇.satisfiesLQGMetricAxioms CircleSample (P.map (sample hC hcirc G0 hG0c))
    (fun s => s.1.1) (fun s => s.1.2) (fun _ => f) hGFF' (fun _ => hf) (fun _ => measurable_const)
  have h1 := ae_of_ae_map (measurable_sample hG0m hGFF.measurable_pairing hGFF.measurable_circle hG0c).aemeasurable
    (p := fun s : CircleSample => IsEuclideanLengthMetric (𝔇 (addFunPairing s.1.1 f)))
    hax.ae_isEuclideanLengthMetric
  filter_upwards [h1, hG0] with ω hω hωG
  simpa only [sample_fst_eq hG0c hωG] using hω

/-- **Universe lift of axiom III** (n2 blocker U, option (b)). For `Ω : Type u` with a whole-plane GFF `(P, hC, hcirc)` and an
LQG metric `𝔇` of Weyl exponent `ξ`, almost surely for every continuous `f` and all `u, v`, the metric of `hC ω + f` is
the Weyl scaling `e^{ξ f}` of the metric of `hC ω`. -/
theorem ae_weylScaling_universe {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}
    (h𝔇 : IsLQGMetric γ ξ 𝔇) {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hGFF : IsWholePlaneGFF P hC hcirc) :
    ∀ᵐ ω ∂P, ∀ f : ℂ → ℝ, Continuous f → ∀ u v : ℂ,
      ENNReal.ofReal (𝔇 (addFunPairing (hC ω) f) u v) = weylScaling (𝔇 (hC ω)) ξ f u v := by
  obtain ⟨G0, hG0m, hG0, hG0c⟩ := exists_good_set hGFF.ae_continuousOn_circle
  have hGFF' := isWholePlaneGFF_map_sample hGFF hG0m hG0 hG0c
  have hax := h𝔇.satisfiesLQGMetricAxioms CircleSample (P.map (sample hC hcirc G0 hG0c))
    (fun s => s.1.1) (fun s => s.1.2) (fun _ => fun _ => (0 : ℝ)) hGFF' (fun _ => continuous_const)
    (fun _ => measurable_const)
  have h2 : ∀ᵐ s ∂(P.map (sample hC hcirc G0 hG0c)), ∀ g : ℂ → ℝ, Continuous g → ∀ u v : ℂ,
      ENNReal.ofReal (𝔇 (addFunPairing s.1.1 g) u v) = weylScaling (𝔇 s.1.1) ξ g u v := by
    filter_upwards [hax.ae_weylScaling] with s hs
    simpa only [addFunPairing_zero_fun] using hs
  have h1 := ae_of_ae_map (measurable_sample hG0m hGFF.measurable_pairing hGFF.measurable_circle hG0c).aemeasurable
    (p := fun s : CircleSample => ∀ g : ℂ → ℝ, Continuous g → ∀ u v : ℂ,
      ENNReal.ofReal (𝔇 (addFunPairing s.1.1 g) u v) = weylScaling (𝔇 s.1.1) ξ g u v) h2
  filter_upwards [h1, hG0] with ω hω hωG
  simpa only [sample_fst_eq hG0c hωG] using hω

end FirstPassS11aa

#print axioms FirstPassS11aa.ae_isEuclideanLengthMetric_universe
#print axioms FirstPassS11aa.ae_weylScaling_universe
