/-!
# First pass, Section 11: measurability of the third pinch event (fp-S11h, owner n2)

Step N2 of `firstPass_11_17` (paper `lemma:third-event-proof`, corrected draft lines 3630-3633: each pinch event is measurable
with respect to the field). This file holds the field-level helpers and the α = 0 internal-metric measurability. The
third-event null-measurability for insertion `α₀ < Q` is in `FirstPass/S11h/ThirdEventAlpha.lean`. The former α = 0
measurability theorems that used `LQGInternalMetricContinuousFrozen` and `LQGMetricLengthIdentityFrozen` were removed
(operator 21:18 UTC: those inputs are false as typed; corrected forms `LQGInternalMetricContinuousAlphaGFFFrozen`,
`LQGMetricLengthIdentityAlphaGFFFrozen` in `Frozen/S11g.lean`). General steps: `CountableSup.lean`.
The Cameron-Martin transfer is not in this file.
-/

namespace HarmonicBalls

open MeasureTheory Set Filter Topology Metric
open scoped ENNReal

universe u

/-- Adding the zero function to a pairing functional does nothing. -/
theorem addFunPairing_const_zero (T : (ℂ → ℝ) → ℝ) : addFunPairing T (fun _ => 0) = T := by
  funext φ
  simp [addFunPairing]

/-- The whole-plane field `hC` is measurable for the distribution σ-algebra (generated by the pairings). -/
theorem measurable_hC_distribution {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hC : Ω → (ℂ → ℝ) → ℝ}
    {hcirc : Ω → ℝ → ℂ → ℝ} (hgff : IsWholePlaneGFF P hC hcirc) :
    @Measurable Ω ((ℂ → ℝ) → ℝ) _ distributionMeasurableSpace hC := by
  rw [measurable_iff_comap_le]
  unfold distributionMeasurableSpace
  simp only [MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  exact iSup₂_le fun φ hφ => (hgff.measurable_pairing φ hφ).comap_le

/-- Field-level a.s. measurability of the internal metric `ω ↦ D^W(q, q')` of an LQG metric `D` of `hC`
(`LQGInternalMetricWeylAeMeasurableFrozen` at `f = 0`, with `D = toReal (weylScaling 𝔇(hC))` almost surely). -/
theorem aemeasurable_internalMetric {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {γ ξ : ℝ} {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {D : Ω → ℂ → ℂ → ℝ}
    (hAe : LQGInternalMetricWeylAeMeasurableFrozen.{u}) (hgff : IsWholePlaneGFF P hC hcirc)
    (hγ : 0 < γ) (hγ2 : γ < 2) (hD : IsLQGMetricOfField P γ ξ 0 hC D)
    {W : Set ℂ} (hW : IsOpen W) (q q' : ℂ) :
    AEMeasurable (fun ω => internalMetric (D ω) W q q') P := by
  obtain ⟨𝔇, h𝔇, hDae⟩ := hD
  obtain ⟨Φ, hΦm, hΦ⟩ :=
    hAe γ ξ 0 Ω P hC hcirc 𝔇 hgff hγ hγ2 (by unfold lqgQ; positivity) h𝔇 W hW q q'
  have hDeq : ∀ᵐ ω ∂P, D ω = fun u v => (weylScaling (𝔇 (hC ω)) ξ (fun x => -0 * Real.log ‖x‖) u v).toReal := by
    filter_upwards [hDae] with ω hω
    funext u v
    obtain ⟨hnn, heq⟩ := hω u v
    rw [← heq, ENNReal.toReal_ofReal hnn]
  have h0 : ∀ᵐ ω ∂P, Φ (hC ω) =
      internalMetric (fun u v => (weylScaling (𝔇 (hC ω)) ξ (fun x => -0 * Real.log ‖x‖) u v).toReal) W q q' := by
    filter_upwards [hΦ (fun _ => 0) continuous_const] with ω hω
    rw [addFunPairing_const_zero] at hω
    exact hω
  have hmeasΦ : Measurable fun ω => Φ (hC ω) := hΦm.comp (measurable_hC_distribution hgff)
  refine hmeasΦ.aemeasurable.congr ?_
  filter_upwards [h0, hDeq] with ω h0ω hDω
  show Φ (hC ω) = internalMetric (D ω) W q q'
  rw [hDω, h0ω]

/-- Bridge: for a continuous `D` and nonempty compact `S₁, S₂`, `ofReal (setDist D S₁ S₂)` is the infimum of
`ofReal (D x y)` over `S₁ ×ˢ S₂` (the infimum defining `setDist` is attained on the compact `image2`). -/
theorem ofReal_setDist_eq_iInf {D : ℂ → ℂ → ℝ} (hcont : Continuous (fun p : ℂ × ℂ => D p.1 p.2))
    {S₁ S₂ : Set ℂ} (h₁ : IsCompact S₁) (h₂ : IsCompact S₂) (hne₁ : S₁.Nonempty) (hne₂ : S₂.Nonempty) :
    ENNReal.ofReal (setDist D S₁ S₂) = ⨅ p ∈ S₁ ×ˢ S₂, ENNReal.ofReal (D p.1 p.2) := by
  have himg : image2 D S₁ S₂ = (fun p : ℂ × ℂ => D p.1 p.2) '' (S₁ ×ˢ S₂) := by
    ext z
    constructor
    · rintro ⟨x, hx, y, hy, rfl⟩
      exact ⟨(x, y), ⟨hx, hy⟩, rfl⟩
    · rintro ⟨⟨x, y⟩, ⟨hx, hy⟩, rfl⟩
      exact ⟨x, hx, y, hy, rfl⟩
  have hX : IsCompact (image2 D S₁ S₂) := by
    rw [himg]
    exact (h₁.prod h₂).image hcont
  have hXne : (image2 D S₁ S₂).Nonempty := hne₁.image2 hne₂
  obtain ⟨x0, hx0, y0, hy0, hxy0⟩ := hX.sInf_mem hXne
  unfold setDist
  apply le_antisymm
  · refine le_iInf₂ fun p hp => ENNReal.ofReal_le_ofReal (csInf_le hX.bddBelow ⟨p.1, hp.1, p.2, hp.2, rfl⟩)
  · refine le_trans (iInf₂_le (x0, y0) ⟨hx0, hy0⟩) ?_
    exact le_of_eq (congrArg ENNReal.ofReal hxy0)

/-- A.e. measurability of `ω ↦ ofReal (setDist (D ω) S₁ S₂)` for compact nonempty `S₁, S₂`. -/
theorem aemeasurable_ofReal_setDist {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (D : Ω → ℂ → ℂ → ℝ)
    (hmeas : ∀ z w, AEMeasurable (fun ω => ENNReal.ofReal (D ω z w)) P)
    (hcont : ∀ᵐ ω ∂P, Continuous (fun p : ℂ × ℂ => D ω p.1 p.2))
    {S₁ S₂ : Set ℂ} (h₁ : IsCompact S₁) (h₂ : IsCompact S₂) (hne₁ : S₁.Nonempty) (hne₂ : S₂.Nonempty) :
    AEMeasurable (fun ω => ENNReal.ofReal (setDist (D ω) S₁ S₂)) P := by
  have hEq : (fun ω => ENNReal.ofReal (setDist (D ω) S₁ S₂)) =ᵐ[P]
      fun ω => ⨅ p ∈ S₁ ×ˢ S₂, ENNReal.ofReal (D ω p.1 p.2) := by
    filter_upwards [hcont] with ω hω
    exact ofReal_setDist_eq_iInf hω h₁ h₂ hne₁ hne₂
  refine AEMeasurable.congr ?_ hEq.symm
  exact aemeasurable_iInf_countable P (S₁ ×ˢ S₂) (fun ω p => ENNReal.ofReal (D ω p.1 p.2))
    (fun p => hmeas p.1 p.2)
    (hcont.mono fun ω hω => (ENNReal.continuous_ofReal.comp hω).continuousOn)


end HarmonicBalls
