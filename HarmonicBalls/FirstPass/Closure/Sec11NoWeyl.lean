import HarmonicBalls.FirstPass.Closure.Sec11
import HarmonicBalls.FirstPass.S8c.WeylOffOriginDerived

/-! # Section 11 closures without the Weyl hypothesis

`LocalLQGInsertionWeylOffOrigin` (`hWeyl`, `FirstPass/Frozen/S8c.lean`) is derived, with no hypotheses, by
`localLQGInsertionWeylOffOrigin_derived` (`FirstPass/S8c/WeylOffOriginDerived.lean`). Each `<name>_noWeyl` below drops the
binder `hWeyl` from the closure `<name>` of `FirstPass/Closure/Sec11.lean` and applies that closure to
`localLQGInsertionWeylOffOrigin_derived`. The original closures are unchanged. The remaining hypotheses are exactly those
of the original closures: `closure_11_11_noWeyl` keeps the open input `hStep8 : Step8IdentificationStmt` of
`closure_11_13`. Not covered here: `closure_11_16` and `closure_11_17`, whose `hWeyl` is a different Proposed-type Prop. -/

namespace HarmonicBalls.Closure

open MeasureTheory

universe u

/-- **Lemma 11.6 without `hWeyl`.** `closure_11_6` with the Weyl relation off the origin given by
`localLQGInsertionWeylOffOrigin_derived`. -/
theorem closure_11_6_noWeyl
    (hDG : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), WholePlaneLQGBallMassBounds P γ hC hcirc)
    (hCC : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ α₀ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), LQGMeasureCoordChange P γ α₀ hC hcirc)
    (hE : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ α : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), LQGMeasureExistence P γ α hC hcirc)
    (hW : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), LQGMeasureWeylScaling P γ 0 hC hcirc)
    (hN : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ α₀ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), LQGMeasureNonatomic P γ α₀ hC hcirc)
    (hL1 : LocalRootedFieldMeasureDomination.{u})
    (hE1 : LQGMeasureOfProfileMeasurableFrozen.{u}) (hE3 : PhaseTorusDoublingProductErgodicFrozen.{0})
    (hB : BirkhoffPointwiseErgodic.{0}) :
    AnnulusMassBoundByHarmonicChainStmt.{u} :=
  closure_11_6 hDG hCC hE hW hN hL1 localLQGInsertionWeylOffOrigin_derived.{u} hE1 hE3 hB

