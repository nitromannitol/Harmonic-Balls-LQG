import HarmonicBalls.Defs.GFF


/-!
# Transfer of the whole-plane GFF to a Type-0 carrier

For Lemma 11.15 (paper `lemma:first-event-proof`, line 3277) the existing Type proof
`IsCorrectedPinchConfiguration.positive_open_first` (`Proofs/Sec11/CorrectedPinchFirstPositive.lean:12`) is applied to a
model `PinchCarrier : Type` of the field: the pairing `pair : (ℂ → ℝ) → ℝ` and a continuous circle-average family
`circ`. The GFF law is pushed forward to this carrier; the carrier σ-algebra is generated by the test-function pairings
and the positive-radius circle averages, so every GFF field of `IsWholePlaneGFF` is measurable on it.

This file: (1) the generic transfer of `IsGaussianProcess` along a measurable map, (2) the carrier and its σ-algebra.
-/

namespace HarmonicBalls

open MeasureTheory ProbabilityTheory Set

/-- Transfer of `IsGaussianProcess` along a measurable map: `g t ∘ Φ = X t` gives `IsGaussianProcess g (P.map Φ)`. -/
lemma isGaussianProcess_map_of {T Ω Y : Type*} [MeasurableSpace Ω] [MeasurableSpace Y] {P : Measure Ω}
    {Φ : Ω → Y} (hΦ : Measurable Φ) (g : T → Y → ℝ) (hg : ∀ t, Measurable (g t))
    (hX : IsGaussianProcess (fun t ω => g t (Φ ω)) P) :
    IsGaussianProcess g (P.map Φ) := by
  refine ⟨fun I => ?_⟩
  have h := hX.hasGaussianLaw I
  have hG : Measurable fun y : Y => I.restrict fun x => g x y :=
    measurable_pi_iff.2 fun i => hg (i : T)
  refine ⟨hG.aemeasurable, ?_⟩
  rw [Measure.map_map hG hΦ]
  exact h.isGaussian_map

/-! ### The Type-0 carrier of the field -/

/-- The Type-0 carrier of a whole-plane GFF field: a pairing `pair` (a functional on test-function pairings) and a
circle-average family `circ` that is continuous on `(0, ∞) × ℂ`. -/
structure PinchCarrier : Type where
  pair : (ℂ → ℝ) → ℝ
  circ : ℝ → ℂ → ℝ
  circ_cont : ContinuousOn (fun p : ℝ × ℂ => circ p.1 p.2) (Ioi 0 ×ˢ univ)

/-- The σ-algebra of `PinchCarrier`: generated by the test-function pairings and the positive-radius circle averages. -/
instance : MeasurableSpace PinchCarrier :=
  (⨆ (φ : ℂ → ℝ) (_ : IsTestFunction univ φ),
      MeasurableSpace.comap (fun y : PinchCarrier => y.pair φ) inferInstance) ⊔
    ⨆ (r : ℝ) (_ : 0 < r) (z : ℂ), MeasurableSpace.comap (fun y : PinchCarrier => y.circ r z) inferInstance

lemma measurable_pinchCarrier_pair {φ : ℂ → ℝ} (hφ : IsTestFunction univ φ) :
    Measurable fun y : PinchCarrier => y.pair φ :=
  Measurable.of_comap_le (le_sup_of_le_left (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl)))

lemma measurable_pinchCarrier_circ {r : ℝ} (hr : 0 < r) (z : ℂ) :
    Measurable fun y : PinchCarrier => y.circ r z :=
  Measurable.of_comap_le (le_sup_of_le_right (le_iSup_of_le r (le_iSup_of_le hr (le_iSup_of_le z le_rfl))))

/-- A map into `PinchCarrier` is measurable as soon as its pairings and positive-radius circle averages are. -/
lemma measurable_into_pinchCarrier {Ω : Type*} [MeasurableSpace Ω] (f : Ω → PinchCarrier)
    (hp : ∀ φ : ℂ → ℝ, IsTestFunction univ φ → Measurable fun ω => (f ω).pair φ)
    (hc : ∀ (r : ℝ) (z : ℂ), 0 < r → Measurable fun ω => (f ω).circ r z) : Measurable f := by
  refine Measurable.of_comap_le ?_
  show MeasurableSpace.comap f ((⨆ (φ : ℂ → ℝ) (_ : IsTestFunction univ φ),
      MeasurableSpace.comap (fun y : PinchCarrier => y.pair φ) inferInstance) ⊔
    ⨆ (r : ℝ) (_ : 0 < r) (z : ℂ), MeasurableSpace.comap (fun y : PinchCarrier => y.circ r z) inferInstance) ≤ _
  rw [MeasurableSpace.comap_sup]
  refine sup_le ?_ ?_
  · simp only [MeasurableSpace.comap_iSup]
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    rw [MeasurableSpace.comap_comp]
    exact (hp φ hφ).comap_le
  · simp only [MeasurableSpace.comap_iSup]
    refine iSup_le fun r => iSup_le fun hr => iSup_le fun z => ?_
    rw [MeasurableSpace.comap_comp]
    exact (hc r z hr).comap_le

/-! ### The GFF transferred to the carrier -/

lemma measurable_eval_pinchCarrier (o : GFFObservable) (ho : o.IsAdmissible) :
    Measurable fun y : PinchCarrier => o.eval y.pair y.circ := by
  cases o with
  | pairing φ => exact measurable_pinchCarrier_pair ho
  | circle r z => exact measurable_pinchCarrier_circ ho z

lemma covariance_congr_ae {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {X Y X' Y' : Ω → ℝ}
    (hX : X =ᵐ[μ] X') (hY : Y =ᵐ[μ] Y') : covariance X Y μ = covariance X' Y' μ := by
  have hmX : ∫ ω, X ω ∂μ = ∫ ω, X' ω ∂μ := integral_congr_ae hX
  have hmY : ∫ ω, Y ω ∂μ = ∫ ω, Y' ω ∂μ := integral_congr_ae hY
  unfold covariance
  rw [hmX, hmY]
  refine integral_congr_ae ?_
  filter_upwards [hX, hY] with ω h1 h2
  rw [h1, h2]

open scoped Classical in
/-- The carrier map: `ω ↦ (hC ω, hcirc ω)`, with the circle averages replaced by `0` on the null set `N₀`
(where the circle averages need not be continuous). -/
noncomputable def carrierMap {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) (N₀ : Set Ω)
    (hcont : ∀ ω, ω ∉ N₀ → ContinuousOn (fun p : ℝ × ℂ => hcirc ω p.1 p.2) (Ioi 0 ×ˢ univ)) :
    Ω → PinchCarrier :=
  fun ω => ⟨hC ω, fun r z => if ω ∈ N₀ then 0 else hcirc ω r z, by
    by_cases hω : ω ∈ N₀
    · simp only [hω, ↓reduceIte]
      exact continuousOn_const
    · simp only [hω, ↓reduceIte]
      exact hcont ω hω⟩

open scoped Classical in
lemma measurable_carrierMap {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hC : Ω → (ℂ → ℝ) → ℝ}
    {hcirc : Ω → ℝ → ℂ → ℝ} (hG : IsWholePlaneGFF P hC hcirc) (N₀ : Set Ω) (hN₀ : MeasurableSet N₀)
    (hcont : ∀ ω, ω ∉ N₀ → ContinuousOn (fun p : ℝ × ℂ => hcirc ω p.1 p.2) (Ioi 0 ×ˢ univ)) :
    Measurable (carrierMap hC hcirc N₀ hcont) := by
  refine measurable_into_pinchCarrier _ (fun φ hφ => hG.measurable_pairing φ hφ) (fun r z hr => ?_)
  exact Measurable.ite hN₀ measurable_const (hG.measurable_circle r z hr)

open scoped Classical in
/-- The whole-plane GFF, transferred to the Type-0 carrier along `carrierMap` (`P.map carrierMap` is the law of the
field). Every field of `IsWholePlaneGFF` is checked: the pairings and circle averages are measurable by construction, the
Gaussian and covariance clauses are transferred by `isGaussianProcess_map_of` and `covariance_map`, and the circle
continuity holds surely on `PinchCarrier`. -/
theorem isWholePlaneGFF_carrierMap {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hC : Ω → (ℂ → ℝ) → ℝ}
    {hcirc : Ω → ℝ → ℂ → ℝ} (hG : IsWholePlaneGFF P hC hcirc) (N₀ : Set Ω) (hN₀ : MeasurableSet N₀)
    (hN₀P : P N₀ = 0)
    (hcont : ∀ ω, ω ∉ N₀ → ContinuousOn (fun p : ℝ × ℂ => hcirc ω p.1 p.2) (Ioi 0 ×ˢ univ)) :
    IsWholePlaneGFF (P.map (carrierMap hC hcirc N₀ hcont)) (fun y : PinchCarrier => y.pair)
      (fun y : PinchCarrier => y.circ) := by
  have hΦ : Measurable (carrierMap hC hcirc N₀ hcont) := measurable_carrierMap hG N₀ hN₀ hcont
  have hN : ∀ᵐ ω ∂P, ω ∉ N₀ := by
    rw [ae_iff]
    simpa using hN₀P
  have hae : ∀ o : GFFObservable, (fun ω => o.eval (hC ω) (hcirc ω)) =ᵐ[P]
      (fun ω => o.eval (carrierMap hC hcirc N₀ hcont ω).pair (carrierMap hC hcirc N₀ hcont ω).circ) := by
    intro o
    filter_upwards [hN] with ω hω
    show o.eval (hC ω) (hcirc ω) = o.eval (hC ω) (fun r z => if ω ∈ N₀ then 0 else hcirc ω r z)
    simp [hω]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro φ hφ
    exact measurable_pinchCarrier_pair hφ
  · intro r z hr
    exact measurable_pinchCarrier_circ hr z
  · have hX : IsGaussianProcess (fun (o : GFFObservable.Admissible) ω =>
        o.1.eval (hC ω) (carrierMap hC hcirc N₀ hcont ω).circ) P :=
      hG.isGaussianProcess.congr fun o => hae o.1
    exact isGaussianProcess_map_of hΦ (fun (o : GFFObservable.Admissible) (y : PinchCarrier) => o.1.eval y.pair y.circ)
      (fun o => measurable_eval_pinchCarrier o.1 o.2) hX
  · intro o ho
    rw [integral_map hΦ.aemeasurable (measurable_eval_pinchCarrier o ho).aestronglyMeasurable]
    exact (integral_congr_ae (hae o).symm).trans (hG.integral_eq_zero o ho)
  · intro o o' ho ho'
    rw [covariance_map (measurable_eval_pinchCarrier o ho).aestronglyMeasurable
      (measurable_eval_pinchCarrier o' ho').aestronglyMeasurable hΦ.aemeasurable]
    rw [← hG.covariance_eq o o' ho ho']
    exact covariance_congr_ae P (hae o).symm (hae o').symm
  · exact Filter.Eventually.of_forall fun y => y.circ_cont

#print axioms isWholePlaneGFF_carrierMap

end HarmonicBalls
