import HarmonicBalls.FirstPass.Phase2.AlphaCanonLaw
import HarmonicBalls.Steps.Sec11.PinchInequalities
import HarmonicBalls.Steps.Sec11.ApproximatePaths

/-!
# Printed forms of the mixing lemma and of the deterministic obstruction (Section 11)

Source: corrected paper `paper/lqg_harmonic_ball-corrected.tex`.

* `s11-pinch:lem:mixing` (lines 3841-3847), second sentence: the dilation `𝒯 g = g(·/2)` is mixing, hence ergodic,
  also on the law of `h^α = h^ℂ - α log|·|` modulo constants, for every fixed `α`. On the canonical space
  `ModConstTestPairings univ` (pairings with mean-zero test functions) the law of `h^α` is `P.map (alphaCanon α hC)`, the
  translate of the canonical law of `h^ℂ` by the deterministic logarithmic drift `logDrift α`. The drift is dilation
  invariant on mean-zero tests (`logDrift_dilOp`, the identity `-α log|w/2| = -α log|w| + α log 2` of lines 3882-3884),
  so the translation conjugates the dilation to itself (`dilOp_iterate_transl`), and the mixing and the ergodicity of
  the canonical law of `h^ℂ` (`coordinateSigmaMixing_canonical`, `ergodic_dilOp`) transfer.
* `s11-pinch:lem:obstruction` (lines 3999-4008), inner inclusion: if the pinch-point event holds at scale `r` around `z`,
  `D` is a length metric inducing the Euclidean topology, `c ∉ B_{10r}(z)` and `D(c, z) = u > 0`, then
  `T_r(z) ⊂ {x : D(c, x) < u}`. This is the argument of `pinchPointEvent_keyhole_subset_metricBall`
  (`Proofs/Sec11/PinchInner.lean`), which uses its hypothesis `z ∈ ∂𝓑_u(c; D)` only through `D(c, z) = u`; the
  nonnegativity of `D` follows from the metric axioms.
-/

namespace HarmonicBalls

open MeasureTheory ProbabilityTheory Filter Topology Set Metric
open scoped ENNReal

/-- Lemma 11.23 (`s11-pinch:lem:mixing`, lines 3844-3846), second sentence: for every whole-plane GFF model and every
fixed `α`, the law of the field `h^α = h^ℂ - α log|·|` modulo constants, i.e. the law `P.map (alphaCanon α hC)` of its
pairings with mean-zero test functions, is mixing for the dilation `𝒯 g = g(·/2)` (the dual dilation `dilOp` of the
canonical space) on the σ-algebra generated by the pairings, and the dilation is ergodic for it. -/
def canonicalMixingAlphaLawStmt : Prop :=
  ∀ (Ω : Type*) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
    IsWholePlaneGFF P hC hcirc → ∀ α : ℝ,
    coordinateSigmaMixing (P.map (alphaCanon α hC)) (fun (i : CanonIdx) (L : CanonIdx → ℝ) => L i) dilOp ∧
      Ergodic (dilOp : ModConstTestPairings (univ : Set ℂ) → ModConstTestPairings (univ : Set ℂ))
        (P.map (alphaCanon α hC))

/-- Lemma 11.23, second sentence: the dilation is mixing and ergodic on the law of `h^α` modulo constants. -/
theorem canonicalMixingAlphaLaw_holds : canonicalMixingAlphaLawStmt := by
  intro Ω _ P hC hcirc hh α
  have := hh.isProbabilityMeasure
  have hlaw : P.map (alphaCanon α hC) = (canonicalLaw hC P).map (transl (logDrift α)) := by
    have h : alphaCanon α hC = transl (logDrift α) ∘ (fun ω (i : CanonIdx) => hC ω i.1) :=
      funext (alphaCanon_eq α hC)
    rw [h, ← Measure.map_map (measurable_transl _) (measurable_canonical hh)]
    rfl
  have hσ : ∀ s : Set (ModConstTestPairings (univ : Set ℂ)), MeasurableSet s →
      MeasurableSet[coordinateSigma (fun (i : CanonIdx) (L : CanonIdx → ℝ) => L i)] s := by
    intro s hs
    rw [coordinateSigma_eq_comap]
    exact ⟨s, hs, rfl⟩
  have hmix : coordinateSigmaMixing (P.map (alphaCanon α hC))
      (fun (i : CanonIdx) (L : CanonIdx → ℝ) => L i) dilOp := by
    intro A B hA hB
    have hAm : MeasurableSet A := by
      rw [coordinateSigma_eq_comap] at hA
      obtain ⟨s, hs, rfl⟩ := hA
      exact hs
    have hBm : MeasurableSet B := by
      rw [coordinateSigma_eq_comap] at hB
      obtain ⟨s, hs, rfl⟩ := hB
      exact hs
    have hA' : MeasurableSet (transl (logDrift α) ⁻¹' A) := measurable_transl _ hAm
    have hB' : MeasurableSet (transl (logDrift α) ⁻¹' B) := measurable_transl _ hBm
    have h := coordinateSigmaMixing_canonical hh _ _ (hσ _ hA') (hσ _ hB')
    have hset : ∀ n : ℕ, transl (logDrift α) ⁻¹' (A ∩ (dilOp^[n]) ⁻¹' B) =
        transl (logDrift α) ⁻¹' A ∩ (dilOp^[n]) ⁻¹' (transl (logDrift α) ⁻¹' B) := by
      intro n
      ext L
      simp only [Set.mem_preimage, Set.mem_inter_iff, dilOp_iterate_transl]
    have hval : ∀ n : ℕ, (canonicalLaw hC P (transl (logDrift α) ⁻¹' A ∩
        (dilOp^[n]) ⁻¹' (transl (logDrift α) ⁻¹' B))).toReal =
        (((canonicalLaw hC P).map (transl (logDrift α))) (A ∩ (dilOp^[n]) ⁻¹' B)).toReal := by
      intro n
      rw [Measure.map_apply (measurable_transl _) (hAm.inter (measurable_dilOp.iterate n hBm)), hset n]
    rw [hlaw, Measure.map_apply (measurable_transl _) hAm, Measure.map_apply (measurable_transl _) hBm]
    exact Tendsto.congr hval h
  have hmp : MeasurePreserving dilOp (P.map (alphaCanon α hC)) (P.map (alphaCanon α hC)) := by
    refine ⟨measurable_dilOp, ?_⟩
    have hcomm : dilOp ∘ transl (logDrift α) = transl (logDrift α) ∘ dilOp := funext (dilOp_transl α)
    rw [hlaw, Measure.map_map measurable_dilOp (measurable_transl _), hcomm,
      ← Measure.map_map (measurable_transl _) measurable_dilOp, (measurePreserving_dilOp hh).map_eq]
  refine ⟨hmix, hmp, ⟨fun s hs hinv => ?_⟩⟩
  have hiter : ∀ n : ℕ, (dilOp^[n]) ⁻¹' s = s := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih => rw [Function.iterate_succ, Set.preimage_comp, ih, hinv]
  have h := hmix s s (hσ s hs) (hσ s hs)
  simp only [hiter, Set.inter_self] at h
  have hx := tendsto_nhds_unique tendsto_const_nhds h
  have : IsProbabilityMeasure (P.map (alphaCanon α hC)) :=
    (Measure.isProbabilityMeasure_map_iff (measurable_alphaCanon hh α).aemeasurable).2 inferInstance
  have hmul : ((P.map (alphaCanon α hC)) s).toReal * (((P.map (alphaCanon α hC)) s).toReal - 1) = 0 := by
    linear_combination -hx
  rw [eventuallyEmptyOrUniv_iff']
  rcases mul_eq_zero.1 hmul with h0 | h1
  · left
    rw [ae_eq_empty]
    exact ((ENNReal.toReal_eq_zero_iff _).1 h0).resolve_right (measure_ne_top _ _)
  · right
    rw [ae_eq_univ]
    have h1' : (P.map (alphaCanon α hC)) s = 1 := (ENNReal.toReal_eq_one_iff _).1 (by linarith)
    exact (prob_compl_eq_zero_iff hs).2 h1'

/-- Lemma 11.24 (`s11-pinch:lem:obstruction`, lines 3999-4008), inner inclusion in the printed form: if the pinch-point
event holds at scale `r` around `z` for the configuration `(U, T, Q', Q)`, `D` is a length metric inducing the
Euclidean topology, `c ∉ B_{10r}(z)` and `D(c, z) = u > 0`, then `T_r(z) ⊂ {x : D(c, x) < u}`. -/
def pinchKeyholeMetricBallPrintedStmt : Prop :=
  ∀ (μ : Measure ℂ) (D : ℂ → ℂ → ℝ) (U T Q' Q : Set ℂ) (M r u : ℝ) (c z : ℂ),
    IsPinchPointConfiguration U T Q' Q → IsEuclideanLengthMetric D →
    pinchPointEvent μ D U T Q' Q M r z → 0 < r → c ∉ ball z (10 * r) →
    D c z = u → 0 < u →
    rescaledSet T r z ⊆ {x | D c x < u}

/-- Lemma 11.24, inner inclusion as printed (hypothesis `D(c, z) = u > 0`): nearly minimizing paths from `c` to `z` cross
`∂B_{5r}(z)` in the closure of `T_r(z)`, and the strict diameter gap of the pinch-point event closes the estimate. -/
theorem pinchKeyholeMetricBallPrinted_holds : pinchKeyholeMetricBallPrintedStmt := by
  intro μ D U T Q' Q M r u c z hconfig hD hp hr hc hu _hu0
  have hnonneg : ∀ x y, 0 ≤ D x y := by
    intro x y
    have h := hD.triangle x y x
    rw [hD.self_eq_zero, hD.symm y x] at h
    linarith
  let S : ℝ≥0∞ := ⨆ a ∈ rescaledSet T r z,
    ⨆ b ∈ rescaledSet T r z, ENNReal.ofReal (D a b)
  let b := setDist D {z} (sphere z (5 * r))
  have hS : S < ENNReal.ofReal b := hp.2.1
  have hb : 0 < b := ENNReal.ofReal_pos.mp (lt_of_le_of_lt bot_le hS)
  have hStop : S ≠ ⊤ := ne_top_of_lt (lt_of_lt_of_le hS le_top)
  have hgap : S.toReal < b := by
    have hh := (ENNReal.toReal_lt_toReal hStop ENNReal.ofReal_ne_top).2 hS
    simpa only [ENNReal.toReal_ofReal hb.le] using hh
  let ε := (b - S.toReal) / 2
  have hε : 0 < ε := by dsimp [ε]; linarith
  obtain ⟨p, hp⟩ := hD.exists_pathLength_lt hnonneg c z hε
  have hdist : 5 * r ≤ dist c z := by
    have hh : 10 * r ≤ dist c z := le_of_not_gt hc
    linarith
  obtain ⟨t, ht, hq⟩ := path_meets_sphere_of_dist_le p (by positivity) hdist
  let q := p.extend t
  have hqT : q ∈ closure (rescaledSet T r z) :=
    sphere_subset_closure_rescaledSet hconfig hr z hq
  have hrad : b ≤ D z q := setDist_le_of_nonneg D hnonneg (Set.mem_singleton z) hq
  have hpath := lt_of_le_of_lt (hD.ofReal_two_segment_le_pathLength hnonneg p ht) hp
  have hpath' : D c q + D q z < D c z + ε :=
    (ENNReal.ofReal_lt_ofReal_iff_of_nonneg
      (add_nonneg (hnonneg c q) (hnonneg q z))).mp hpath
  intro y hy
  have hbound : D q y ≤ S.toReal := by
    apply closure_minimal (s := rescaledSet T r z) _
      (isClosed_le (hD.continuous_left y) continuous_const) hqT
    intro a ha
    change D a y ≤ S.toReal
    have haS : ENNReal.ofReal (D a y) ≤ S :=
      le_iSup_of_le a (le_iSup_of_le ha (le_iSup_of_le y (le_iSup_of_le hy le_rfl)))
    have hh := ENNReal.toReal_mono hStop haS
    simpa only [ENNReal.toReal_ofReal (hnonneg a y)] using hh
  have htri := hD.triangle c q y
  rw [hD.symm q z] at hpath'
  change D c y < u
  dsimp [ε] at hpath'
  linarith

end HarmonicBalls
