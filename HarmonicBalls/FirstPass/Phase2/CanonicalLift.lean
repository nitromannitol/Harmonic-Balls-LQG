import HarmonicBalls.FirstPass.Phase2.DecoderInputsDerived
import HarmonicBalls.Proofs.GFF.LQGMetricUniquenessDerived
import HarmonicBalls.Steps.Sec11.PairingCovarianceLinearity
import HarmonicBalls.FirstPass.S11i.AlphaCanonical

/-!
# The lift of a canonical field to pairing functionals

A point `L` of the canonical space `S11n.CanonSpace` (pairings with mean-zero test functions) records a field modulo
additive constants. For the field `h^α₀ = h^ℂ - α₀ log|·|` of a whole-plane GFF model, the canonical field is
`alphaCanon α₀ hC ω` (`S11i/AlphaCanonical.lean:89`). The lift `canonLift α₀ L` removes the log drift and then extends the
pairings to all test functions by `φ ↦ L (φ - (∫ φ) · unitTest)` (`DecoderInputsDerived.rawOfCanon`).

On a whole-plane GFF model the lift of the canonical field is, almost surely on each test function, the field
`h^ℂ - (h^ℂ, unitTest)`, i.e. `h^ℂ` shifted by a random additive constant (`ae_canonLift_alphaCanon_apply`); hence every
functional of `h^ℂ` measurable for the σ-algebra generated by the test pairings takes the same value, almost surely, at
the lift of the canonical field and at the shifted field (`ae_comp_canonLift_alphaCanon`). This is the first step of the
construction of the canonical decoders: a γ-LQG metric applied to the lift recovers the metric of `h^ℂ` up to the factor
`e^{-ξ (h^ℂ, unitTest)}` (Weyl scaling by a constant).
-/

namespace HarmonicBalls

open MeasureTheory Set
open HarmonicBalls.DecoderInputsDerived

/-- The lift of a canonical field to pairing functionals: remove the log drift `-α₀ log|·|`, then extend to all test
functions through `rawOfCanon`. -/
noncomputable def canonLift (α₀ : ℝ) (L : S11n.CanonSpace) : (ℂ → ℝ) → ℝ :=
  rawOfCanon (transl (logDrift (-α₀)) L)

/-- Removing the log drift from the canonical field of `h^ℂ - α₀ log|·|` gives the mean-zero pairings of `h^ℂ`. -/
theorem transl_logDrift_neg_alphaCanon {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (ω : Ω) :
    transl (logDrift (-α₀)) (alphaCanon α₀ hC ω) = fun i => hC ω i.1 := by
  funext i
  simp only [transl, alphaCanon, logDrift, logDriftFun, fieldPairing]
  ring

theorem canonLift_alphaCanon {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (ω : Ω) :
    canonLift α₀ (alphaCanon α₀ hC ω) = rawOfCanon (fun i => hC ω i.1) := by
  rw [canonLift, transl_logDrift_neg_alphaCanon]

/-- The lift is measurable from the canonical space to pairing functionals with the σ-algebra generated by the test
pairings. -/
theorem measurable_canonLift (α₀ : ℝ) :
    @Measurable S11n.CanonSpace ((ℂ → ℝ) → ℝ) _ distributionMeasurableSpace (canonLift α₀) :=
  measurable_rawOfCanon.comp (measurable_transl _)

/-- **The lift of the canonical field is `h^ℂ` shifted by a random constant**, almost surely on each test function:
`canonLift α₀ (alphaCanon α₀ hC ω) φ = (h^ℂ - (h^ℂ, unitTest), φ)`. Input: the almost sure linearity of the pairings of
a whole-plane GFF (`IsWholePlaneGFF.ae_pairing_linear_combination`). -/
theorem IsWholePlaneGFF.ae_canonLift_alphaCanon_apply {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (h : IsWholePlaneGFF P hC hcirc) (α₀ : ℝ)
    {φ : ℂ → ℝ} (hφ : IsTestFunction univ φ) :
    ∀ᵐ ω ∂P, canonLift α₀ (alphaCanon α₀ hC ω) φ = addFunPairing (hC ω) (fun _ => -hC ω unitTest) φ := by
  filter_upwards [h.ae_pairing_linear_combination hφ unitTest_isTestFunction 1 (-(∫ y, φ y))] with ω hω
  rw [canonLift_alphaCanon, rawOfCanon_of_test hφ]
  have hfun : (fun x => φ x - (∫ y, φ y) * unitTest x) = fun x => 1 * φ x + -(∫ y, φ y) * unitTest x := by
    funext x
    ring
  show hC ω (fun x => φ x - (∫ y, φ y) * unitTest x) = hC ω φ + ∫ x, -hC ω unitTest * φ x
  rw [hfun, hω, integral_const_mul]
  ring

/-- **Functionals of the lift of the canonical field.** For every functional `F` measurable for the σ-algebra generated
by the test pairings, almost surely `F (canonLift α₀ (alphaCanon α₀ hC ω)) = F (h^ℂ - (h^ℂ, unitTest))`. -/
theorem IsWholePlaneGFF.ae_comp_canonLift_alphaCanon {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (h : IsWholePlaneGFF P hC hcirc) (α₀ : ℝ)
    (F : ((ℂ → ℝ) → ℝ) → ℝ) (hF : Measurable[distributionMeasurableSpace] F) :
    ∀ᵐ ω ∂P, F (canonLift α₀ (alphaCanon α₀ hC ω)) = F (addFunPairing (hC ω) (fun _ => -hC ω unitTest)) :=
  ae_eq_comp_of_ae_eq_testPairing _ _ (fun _ hφ => h.ae_canonLift_alphaCanon_apply α₀ hφ) F hF

end HarmonicBalls
