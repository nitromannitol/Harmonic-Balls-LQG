import HarmonicBalls.FirstPass.Frozen.S11j
import HarmonicBalls.FirstPass.Phase2.LQGMetricAxiomsUniv

/-!
# The field axioms of the LQG metric at every universe

`LQGMetricFieldAxiomsUnivFrozen` (Fact 2.2 I-IV for the field `h^ℂ - α₀ log |·|`, on probability spaces `Ω : Type u`)
follows from its instance on probability spaces in `Type`. The statement involves `Ω` only through the pairings of the
field: the hypothesis is the law of a whole-plane GFF, clauses I, III and IV are almost sure statements about the pairing
`hC ω`, and the random function in the locality clause II is measurable for the σ-algebra generated by the pairings.
So the model is represented on the range of its sample point (`LQGMetricUniv.RangeSpace`, a type in `Type`, with the
push-forward of the completed measure), where the instance in `Type` applies, and every clause is pulled back.
-/

universe u

namespace HarmonicBalls

open MeasureTheory ProbabilityTheory
open scoped ENNReal

open LQGMetricUniv in
/-- **Fact 2.2 for the field `h^ℂ - α₀ log |·|` on every universe from the case of `Type`.** The universal wrapper
`LQGMetricFieldAxiomsUnivFrozen.{u}` follows from `LQGMetricFieldAxiomsUnivFrozen.{0}`: apply the latter on the range
of the sample point `ω ↦ (h^ℂ(ω), h^ℂ_·(·)(ω))` and pull the clauses back along `toRange`. -/
theorem lqgMetricFieldAxiomsUnivFrozen_of_zero (hAx0 : LQGMetricFieldAxiomsUnivFrozen.{0}) :
    LQGMetricFieldAxiomsUnivFrozen.{u} := by
  intro Ω _ P γ ξ α₀ hC hcirc hG hγ hγ2 hα 𝔇 hM
  let X : Ω → SamplePoint := samplePoint hC hcirc fun _ _ => 0
  have hG0 : IsWholePlaneGFF (rangeMeasure P X) (fun y => y.1.pairing) (fun y => y.1.circle) :=
    isWholePlaneGFF_rangeMeasure (fun _ _ => 0) hG
  obtain ⟨hI, hII, hIII, hIV⟩ := hAx0 (RangeSpace P X) (rangeMeasure P X) γ ξ α₀ (fun y => y.1.pairing)
    (fun y => y.1.circle) hG0 hγ hγ2 hα 𝔇 hM
  refine ⟨ae_rangeMeasure_iff.1 hI, ?_, ae_rangeMeasure_iff.1 hIII,
    fun r hr z => ae_rangeMeasure_iff.1 (hIV r hr z)⟩
  intro U hU
  obtain ⟨G, hGm, hGae⟩ := hII U hU
  refine ⟨fun ω => G (toRange P X ω), fun z w => ?_, ae_rangeMeasure_iff.1 hGae⟩
  have hcomap : fieldSigmaAlgebra α₀ hC U =
      MeasurableSpace.comap (toRange P X) (fieldSigmaAlgebra α₀ (fun y : RangeSpace P X => y.1.pairing) U) := by
    simp only [fieldSigmaAlgebra, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
    rfl
  rw [hcomap]
  exact (hGm z w).comp (comap_measurable _)

end HarmonicBalls
