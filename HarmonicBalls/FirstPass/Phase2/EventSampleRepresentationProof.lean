        (fun ω r z => hcirc ω r z + Real.circleAverage f z r) ω).2)) =
      (weylShiftPair γ ξ f (μ ω, D ω)).1 := by
    filter_upwards [hμ', hW.ae_continuousOn_circle] with ω hmω hcω
    exact decoder_sel_eq T γ α₀ Sel hSel hcω hmω f hfcont
      (GFFJointLaw.jointSample (fun ω => addFunPairing (hC ω) f)
        (fun ω r z => hcirc ω r z + Real.circleAverage f z r) ω).2 (fun r z hr => rfl)
