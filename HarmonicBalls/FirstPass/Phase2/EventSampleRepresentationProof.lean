/-!
# Row 17: the event sample representation, derived from the three frozen metric inputs

Target: `CMEventTransfer.eventSampleRepresentation_of_inputs`, i.e. `EventSampleRepresentation`
(`FirstPass/Phase2/CameronMartinEventTransferDerived.lean:60`) from `LQGMetricFieldAxiomsUnivFrozen`,
`WeylScalingCompositionFrozen` and `LQGInternalMetricWeylAeMeasurableFrozen`, and the row-17 target
`cameronMartinEventTransfer_derived : CameronMartinEventTransferFrozen`
(`FirstPass/Frozen/S11c.lean:146`) with the Cameron-Martin reweighting discharged by
`S11aj.cameronMartinGFFReweighting_derived`.

Route (TRUE as typed): the event set is
`E = {s | A (rawFunctional s) ≤ c ∧ C ≤ Dec s S₁}`, where
* `rawFunctional s` is the functional of the sample `s` on test pairings (extended by `0`);
* `A` is the countable supremum `⨆ p ∈ D₀ × D₀, ⨅ n, ⨆ k, Φ p n k` of the measurable functionals from
  `LQGInternalMetricWeylAeMeasurableFrozen` (the Weyl-scaled internal metric on the open sets
  `thickening (k+1)⁻¹ (S₂ ∩ closedBall 0 (n+1))`), with `D₀` a countable dense subset of `S₂`;
* `Dec s` is the measure decoder `ProfileDecoderDerived.decoder T γ α₀` applied to the profile
  `Sel (circleExt s.2)` (`canonicalProfileSelector`).

The saturation step (`saturation_of_distributionMeasurable`) passes from the raw functional to the
Cameron-Martin shifted functional, since distribution-measurable functionals see only test pairings.
-/

namespace HarmonicBalls

open MeasureTheory Set Filter Topology
open scoped ENNReal

universe u

namespace CMEventTransfer

/-- Saturation: a distribution-measurable functional takes equal values on two functionals that agree on
every test pairing (`distributionMeasurableSpace` is the σ-algebra generated by the test pairings). -/
theorem saturation_of_distributionMeasurable {Ψ : ((ℂ → ℝ) → ℝ) → ℝ≥0∞}
    (hΨ : Measurable[distributionMeasurableSpace] Ψ) {T T' : (ℂ → ℝ) → ℝ}
    (h : ∀ φ : ℂ → ℝ, IsTestFunction Set.univ φ → T φ = T' φ) : Ψ T = Ψ T' := by
  rw [distributionMeasurableSpace_eq_comap] at hΨ
  have hm := hΨ (measurableSet_singleton (Ψ T))
  obtain ⟨B, -, hBeq⟩ := MeasurableSpace.measurableSet_comap.1 hm
  have key : ∀ X : (ℂ → ℝ) → ℝ,
      (fun ψ : LocalFieldTest (Set.univ : Set ℂ) => X ψ.1) ∈ B ↔ Ψ X = Ψ T := by
    intro X
    have := Set.ext_iff.1 hBeq X
    simpa using this
  have hTT : (fun ψ : LocalFieldTest (Set.univ : Set ℂ) => T' ψ.1) =
      fun ψ : LocalFieldTest (Set.univ : Set ℂ) => T ψ.1 :=
    funext fun ψ => (h ψ.1 ψ.2).symm
  have h2 : (fun ψ : LocalFieldTest (Set.univ : Set ℂ) => T' ψ.1) ∈ B := by
    rw [hTT]
    exact (key T).2 rfl
  exact ((key T').1 h2).symm

open Classical in
/-- The functional of a joint sample on test pairings, extended by `0` off the test functions. -/
noncomputable def rawFunctional (s : Sample) : (ℂ → ℝ) → ℝ :=
  fun φ => if h : IsTestFunction Set.univ φ then s.1 ⟨φ, h⟩ else 0

/-- The raw functional is measurable for the distribution σ-algebra. -/
theorem measurable_rawFunctional :
    @Measurable Sample ((ℂ → ℝ) → ℝ) _ distributionMeasurableSpace rawFunctional := by
  rw [distributionMeasurableSpace_eq_comap]
  have hmeas : Measurable (fun s : Sample =>
      fun ψ : LocalFieldTest (Set.univ : Set ℂ) => rawFunctional s ψ.1) := by
    refine measurable_pi_iff.2 fun ψ => ?_
    have hfun : (fun s : Sample => rawFunctional s ψ.1) = fun s => s.1 ⟨ψ.1, ψ.2⟩ := by
      funext s
      simp [rawFunctional, ψ.2]
    rw [hfun]
    exact (measurable_pi_apply _).comp measurable_fst
  intro t ht
  obtain ⟨B, hB, rfl⟩ := MeasurableSpace.measurableSet_comap.1 ht
  exact hmeas hB

/-- The positive-radius extension `(r, z) ↦ σ(r, z)` for `r > 0` and `0` otherwise. -/
noncomputable def circleExt (σ : {p : ℝ × ℂ // 0 < p.1} → ℝ) : ℝ → ℂ → ℝ :=
  fun r z => if h : 0 < r then σ ⟨(r, z), h⟩ else 0

theorem measurable_circleExt : Measurable circleExt := by
  refine measurable_pi_iff.2 fun r => measurable_pi_iff.2 fun z => ?_
  by_cases hr : 0 < r
  · simp [circleExt, hr]
    exact measurable_pi_apply _
  · simp [circleExt, hr]

/-- The circle average of the zero function vanishes. -/
theorem circleAverage_zero_fun' (z : ℂ) (r : ℝ) : Real.circleAverage (0 : ℂ → ℝ) z r = 0 := by
  simp [Real.circleAverage_def]

/-- Continuity of the field circle average in the centre, for positive radius. -/
theorem continuous_fieldCircleAverage_of_continuousOn {α₀ : ℝ} {hc : ℝ → ℂ → ℝ}
    (hcont : ContinuousOn (fun p : ℝ × ℂ => hc p.1 p.2) (Set.Ioi 0 ×ˢ Set.univ)) (r : ℝ) (hr : 0 < r) :
    Continuous (fieldCircleAverage α₀ hc r) := by
  have h1 : Continuous fun z : ℂ => hc r z :=
    hcont.comp_continuous (f := fun z : ℂ => (r, z)) (by fun_prop) fun z => ⟨hr, mem_univ z⟩
  have h2 : Continuous fun z : ℂ => Real.circleAverage (fun x : ℂ => Real.log ‖x‖) z r :=
    MassFunctionalDerived.continuous_circleAverage_log_norm hr
  exact h1.sub (continuous_const.mul h2)

/-- The measure decoder at a sampled profile: for an LQG measure `m` of the field `hc`, the decoder of the
selected profile is the Cameron-Martin reweighted measure `m · exp(γ g)`. -/
theorem decoder_sel_eq (T : ProfileDecoderDerived.TestFamily) (γ α₀ : ℝ)
    (Sel : (ℝ → ℂ → ℝ) → C(CircleParameter, ℝ))
    (hSel : ∀ y : C(CircleParameter, ℝ), Sel (posExtend ⇑y) = y)
    {hc : ℝ → ℂ → ℝ} {m : Measure ℂ}
    (hcont : ContinuousOn (fun p : ℝ × ℂ => hc p.1 p.2) (Set.Ioi 0 ×ˢ Set.univ))
    (hm : IsLQGLimit γ (fieldCircleAverage α₀ hc) m) (g : ℂ → ℝ) (hg : Continuous g)
    (σ : {p : ℝ × ℂ // 0 < p.1} → ℝ)
    (hσ : ∀ (r : ℝ) (z : ℂ) (hr : 0 < r), σ ⟨(r, z), hr⟩ = hc r z + Real.circleAverage g z r) :
    ProfileDecoderDerived.decoder T γ α₀ (Sel (circleExt σ)) =
      m.withDensity (fun z => ENNReal.ofReal (Real.exp (γ * g z))) := by
  let G : CircleParameter → ℝ := fun p => hc p.1.1 p.2 + Real.circleAverage g p.2 p.1.1
  have hGc : Continuous G := by
    have h1 : Continuous fun p : CircleParameter => hc p.1.1 p.2 :=
      hcont.comp_continuous (f := fun p : CircleParameter => ((p.1 : ℝ), p.2)) (by fun_prop)
        fun p => ⟨p.1.2, mem_univ _⟩
    have h2 : Continuous fun p : CircleParameter => Real.circleAverage g p.2 p.1.1 :=
      Continuous.comp (g := fun q : ℝ × ℂ => Real.circleAverage g q.2 q.1)
        (HarmonicBalls.Section6.continuous_circleAverage_radius_center hg)
        (by fun_prop : Continuous fun p : CircleParameter => ((p.1 : ℝ), p.2))
    exact h1.add h2
  let y : C(CircleParameter, ℝ) := ⟨G, hGc⟩
  have hext : circleExt σ = posExtend ⇑y := by
    funext r z
    by_cases hr : 0 < r
    · simp only [circleExt, posExtend, ↓reduceDIte, hr]
      rw [hσ r z hr]
      rfl
    · simp [circleExt, posExtend, hr]
  have hlim : IsLQGLimit γ (fieldCircleAverage α₀ (circleProfile y))
      (m.withDensity fun z => ENNReal.ofReal (Real.exp (γ * g z))) := by
    have h1 := HarmonicBalls.Section6.isLQGLimit_addCircleAverage hm
      (fun n => continuous_fieldCircleAverage_of_continuousOn hcont (dyadicScale n)
        (by unfold dyadicScale; positivity)) g hg
    have h2 := FirstPassS11asWeyl.fieldCircleAverage_eq_addCircleAverage (α := α₀) (hcirc := hc)
      (hcirc' := fun r x => hc r x + Real.circleAverage g x r) (v := g) (fun r x => rfl)
    rw [← h2] at h1
    refine HarmonicBalls.LocalDecoderCommon.isLQGLimit_congr (fun r hr x => ?_) h1
    simp [fieldCircleAverage, circleProfile, hr, y, G]
  rw [hext, hSel y]
  exact (canonicalDecoder_limit T γ α₀ y ⟨_, hlim⟩).unique hlim


/-- The supremum of the internal metric over `S × S` of a closed bounded set equals the supremum over a
countable dense subset `D₀ ⊆ S` (the lower semicontinuity of the internal metric on `S × S`). -/
theorem closed_internal_iSup_eq (F : ℂ → ℂ → ℝ) (hF : IsEuclideanLengthMetric F)
    (hFnn : ∀ a b, 0 ≤ F a b) {S D₀ : Set ℂ} (hS : IsClosed S) (hSb : Bornology.IsBounded S)
    (hD₀S : D₀ ⊆ S) (hSD₀ : S ⊆ closure D₀) :
    (⨆ u ∈ S, ⨆ v ∈ S, internalMetric F S u v) = ⨆ p : ↥(D₀ ×ˢ D₀), internalMetric F S p.1.1 p.1.2 := by
  have hlsc := IsEuclideanLengthMetric.lowerSemicontinuousOn_internalMetric_pair_closed hF hFnn hS hSb
  calc (⨆ u ∈ S, ⨆ v ∈ S, internalMetric F S u v)
      = ⨆ x ∈ S ×ˢ S, internalMetric F S x.1 x.2 :=
        (biSup_prod (f := fun x : ℂ × ℂ => internalMetric F S x.1 x.2)).symm
    _ = ⨆ x ∈ D₀ ×ˢ D₀, internalMetric F S x.1 x.2 :=
        LatticeProb.Prob.iSup_mem_eq_iSup_mem_of_lowerSemicontinuousOn hlsc (Set.prod_mono hD₀S hD₀S)
          (by rw [closure_prod_eq]; exact Set.prod_mono hSD₀ hSD₀)
    _ = ⨆ p : ↥(D₀ ×ˢ D₀), internalMetric F S p.1.1 p.1.2 :=
        (iSup_subtype' (f := fun (x : ℂ × ℂ) (_ : x ∈ D₀ ×ˢ D₀) => internalMetric F S x.1 x.2))

/-- **Countable representation of the closed supremum.** For a.e. `ω`, the supremum of the internal metric
`M ω` over `S × S` (a Euclidean length metric, nonnegative) equals the countable supremum
`⨆ p ∈ D₀ × D₀, ⨅ n, ⨆ k, Φ p n k (addFunPairing (hC ω) g)` of functionals that a.s. evaluate the internal
metric on the open sets `thickening (k+1)⁻¹ (S ∩ closedBall 0 (n+1))` (closed-set exhaustion). -/
theorem closedSup_eq_countable_sup {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {S D₀ : Set ℂ} (hS : IsClosed S) (hSb : Bornology.IsBounded S)
    (hD₀S : D₀ ⊆ S) (hD₀c : D₀.Countable) (hSD₀ : S ⊆ closure D₀)
    (Φ : ↥(D₀ ×ˢ D₀) → ℕ → ℕ → ((ℂ → ℝ) → ℝ) → ℝ≥0∞) {g : ℂ → ℝ} (M : Ω → ℂ → ℂ → ℝ)
    (hΦM : ∀ (p : ↥(D₀ ×ˢ D₀)) (n k : ℕ), ∀ᵐ ω ∂P, Φ p n k (addFunPairing (hC ω) g) = internalMetric (M ω)
      (Metric.thickening (((k : ℝ) + 1)⁻¹) (S ∩ Metric.closedBall 0 ((n : ℝ) + 1))) p.1.1 p.1.2)
    (hEucM : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (M ω))
    (hNonneg : ∀ᵐ ω ∂P, ∀ a b, 0 ≤ M ω a b) :
    ∀ᵐ ω ∂P, (⨆ p : ↥(D₀ ×ˢ D₀), ⨅ n : ℕ, ⨆ k : ℕ, Φ p n k (addFunPairing (hC ω) g)) =
      ⨆ u ∈ S, ⨆ v ∈ S, internalMetric (M ω) S u v := by
  have : Countable ↥(D₀ ×ˢ D₀) := (hD₀c.prod hD₀c).to_subtype
  have hall : ∀ᵐ ω ∂P, ∀ (p : ↥(D₀ ×ˢ D₀)) (n k : ℕ), Φ p n k (addFunPairing (hC ω) g) =
      internalMetric (M ω) (Metric.thickening (((k : ℝ) + 1)⁻¹) (S ∩ Metric.closedBall 0 ((n : ℝ) + 1)))
        p.1.1 p.1.2 :=
    ae_all_iff.2 fun p => ae_all_iff.2 fun n => ae_all_iff.2 fun k => hΦM p n k
  filter_upwards [hall, hEucM, hNonneg] with ω hΦω hEω hNω
  have hpt : ∀ p : ↥(D₀ ×ˢ D₀), (⨅ n : ℕ, ⨆ k : ℕ, Φ p n k (addFunPairing (hC ω) g)) =
      internalMetric (M ω) S p.1.1 p.1.2 := by
    intro p
    simp only [hΦω]
    exact (internalMetricClosedEqIInfThickening_derived (M ω) S hS hEω
      (hD₀S (Set.mem_prod.1 p.2).1) (hD₀S (Set.mem_prod.1 p.2).2)).symm
  calc (⨆ p : ↥(D₀ ×ˢ D₀), ⨅ n : ℕ, ⨆ k : ℕ, Φ p n k (addFunPairing (hC ω) g))
      = ⨆ p : ↥(D₀ ×ˢ D₀), internalMetric (M ω) S p.1.1 p.1.2 := iSup_congr hpt
    _ = ⨆ u ∈ S, ⨆ v ∈ S, internalMetric (M ω) S u v :=
        (closed_internal_iSup_eq (M ω) hEω hNω hS hSb hD₀S hSD₀).symm


/-- **Event sample representation (row 17, derived).** The event set `E = {s | A (rawFunctional s) ≤ c ∧
C ≤ Dec s S₁}` represents both the unshifted closed event and its Cameron-Martin shifted version, for every
admissible shift `f`, from the three frozen metric inputs. -/
theorem eventSampleRepresentation_of_inputs
    (hAx : LQGMetricFieldAxiomsUnivFrozen.{u}) (hWSC : WeylScalingCompositionFrozen.{u})
    (hInt : LQGInternalMetricWeylAeMeasurableFrozen.{u}) : EventSampleRepresentation.{u} := by
  intro γ ξ α₀ Ω _ P hC hcirc μ D S₁ S₂ c C hγ0 hγ2 hα hW hμ hD hS₁ hS₂
  have : IsProbabilityMeasure P := hW.isProbabilityMeasure
  have hμ' : ∀ᵐ ω ∂P, IsLQGLimit γ (fieldCircleAverage α₀ (hcirc ω)) (μ ω) := hμ
  obtain ⟨𝔇, h𝔇, hD𝔇⟩ := hD
  obtain ⟨hS₁c, -⟩ := isClosed_and_isBounded_of_isClosedDyadicSquare hS₁
  obtain ⟨hS₂c, hS₂b⟩ := isClosed_and_isBounded_of_isClosedDyadicSquare hS₂
  obtain ⟨D₀, hD₀S, hD₀c, hSD₀⟩ := exists_countable_dense_subset_of_set S₂
  have : Countable ↥(D₀ ×ˢ D₀) := (hD₀c.prod hD₀c).to_subtype
  -- the field metric is a.s. a Euclidean length metric
  have hEucD : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (D ω) := by
    filter_upwards [(hAx Ω P γ ξ α₀ hC hcirc hW hγ0 hγ2 hα 𝔇 h𝔇).1, hD𝔇] with ω hI hDω
    have hDeq : D ω = fun a b => (weylScaling (𝔇 (hC ω)) ξ (fun x => -α₀ * Real.log ‖x‖) a b).toReal := by
      funext a b
      obtain ⟨h0, h1⟩ := hDω a b
      rw [← h1, ENNReal.toReal_ofReal h0]
    rw [hDeq]
    exact hI.2
  have hNu : ∀ᵐ ω ∂P, ∀ a b, 0 ≤ D ω a b := by
    filter_upwards [hD𝔇] with ω hω a b
    exact (hω a b).1
  have hMu : ∀ᵐ ω ∂P, D ω = fun a b =>
      (weylScaling (𝔇 (addFunPairing (hC ω) 0)) ξ (fun z => -α₀ * Real.log ‖z‖) a b).toReal := by
    filter_upwards [hD𝔇] with ω hω
    funext a b
    obtain ⟨h0, h1⟩ := hω a b
    have hz : addFunPairing (hC ω) 0 = hC ω := by
      funext φ
      simp [addFunPairing]
    rw [hz, ← h1, ENNReal.toReal_ofReal h0]
  -- the countable functionals from the measurable Weyl-scaled internal metric input
  have hex : ∀ (p : ↥(D₀ ×ˢ D₀)) (n k : ℕ), ∃ Φ : ((ℂ → ℝ) → ℝ) → ℝ≥0∞,
      Measurable[distributionMeasurableSpace] Φ ∧ ∀ g : ℂ → ℝ, Continuous g → ∀ᵐ ω ∂P,
        Φ (addFunPairing (hC ω) g) = internalMetric
          (fun a b => (weylScaling (𝔇 (addFunPairing (hC ω) g)) ξ (fun z => -α₀ * Real.log ‖z‖) a b).toReal)
          (Metric.thickening (((k : ℝ) + 1)⁻¹) (S₂ ∩ Metric.closedBall 0 ((n : ℝ) + 1))) p.1.1 p.1.2 :=
    fun p n k => hInt γ ξ α₀ Ω P hC hcirc 𝔇 hW hγ0 hγ2 hα h𝔇 _ Metric.isOpen_thickening p.1.1 p.1.2
  choose Φ hΦm hΦg using hex
  let A : ((ℂ → ℝ) → ℝ) → ℝ≥0∞ := fun X => ⨆ p : ↥(D₀ ×ˢ D₀), ⨅ n : ℕ, ⨆ k : ℕ, Φ p n k X
  have hA : Measurable[distributionMeasurableSpace] A :=
    Measurable.iSup fun p => Measurable.iInf fun n => Measurable.iSup fun k => hΦm p n k
  -- the measure decoder and the raw functional are measurable on the sample space
  obtain ⟨Sel, hSelm, hSel⟩ : CanonicalProfileSelectorStmt := canonicalProfileSelector
  obtain ⟨T⟩ := ProfileDecoderDerived.exists_testFamily
  have hraw := measurable_rawFunctional
  have hext : Measurable (fun s : Sample => circleExt s.2) := measurable_circleExt.comp measurable_snd
  have hDecS₁ : Measurable (fun s : Sample =>
      ProfileDecoderDerived.decoder T γ α₀ (Sel (circleExt s.2)) S₁) :=
    (Measure.measurable_coe hS₁c.measurableSet).comp
      ((ProfileDecoderDerived.measurable_decoder T γ α₀).comp (hSelm.comp hext))
  refine ⟨{s | A (rawFunctional s) ≤ c ∧ C ≤ ProfileDecoderDerived.decoder T γ α₀ (Sel (circleExt s.2)) S₁},
    ?_, ?_⟩
  · exact (measurableSet_le (hA.comp hraw) measurable_const).inter
      (measurableSet_le measurable_const hDecS₁)
  intro f hf hfc _
  have hfcont : Continuous f := hf.continuous
  -- the unshifted sample: metric and measure
  have hΦu : ∀ (p : ↥(D₀ ×ˢ D₀)) (n k : ℕ), ∀ᵐ ω ∂P, Φ p n k (addFunPairing (hC ω) 0) =
      internalMetric (D ω) (Metric.thickening (((k : ℝ) + 1)⁻¹) (S₂ ∩ Metric.closedBall 0 ((n : ℝ) + 1)))
        p.1.1 p.1.2 := fun p n k => by
    filter_upwards [hΦg p n k 0 continuous_zero, hMu] with ω h1 h2
    rw [h1, h2]
  have hMet_u : ∀ᵐ ω ∂P, A (rawFunctional (GFFJointLaw.jointSample hC hcirc ω)) =
      ⨆ u ∈ S₂, ⨆ v ∈ S₂, internalMetric (D ω) S₂ u v := by
    filter_upwards [closedSup_eq_countable_sup hS₂c hS₂b hD₀S hD₀c hSD₀ Φ D hΦu hEucD hNu] with ω hω
    have hsat := saturation_of_distributionMeasurable
      (T := rawFunctional (GFFJointLaw.jointSample hC hcirc ω)) (T' := addFunPairing (hC ω) 0) hA
      (fun φ hφ => by simp [rawFunctional, GFFJointLaw.jointSample, addFunPairing, hφ])
    rw [hsat]
    exact hω
  have hDec_u : ∀ᵐ ω ∂P, ProfileDecoderDerived.decoder T γ α₀
      (Sel (circleExt (GFFJointLaw.jointSample hC hcirc ω).2)) = μ ω := by
    filter_upwards [hμ', hW.ae_continuousOn_circle] with ω hmω hcω
    rw [decoder_sel_eq T γ α₀ Sel hSel hcω hmω 0 continuous_zero (GFFJointLaw.jointSample hC hcirc ω).2
      (fun r z hr => by simp [GFFJointLaw.jointSample, circleAverage_zero_fun'])]
    simp
  -- the Cameron-Martin shifted sample: metric and measure
  have hSh := weylShiftPair_snd_ae_eq_field_shift P γ ξ α₀ hC hcirc hW hγ0 hγ2 hα hAx hWSC 𝔇 h𝔇 D μ
    hD𝔇 f hfcont
  have hEucS : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (weylShiftPair γ ξ f (μ ω, D ω)).2 := by
    filter_upwards [hEucD] with ω hω
    exact weylScaledEuclidean_derived (D ω) ξ f hω hfcont hfc
  have hNs : ∀ᵐ ω ∂P, ∀ a b, 0 ≤ (weylShiftPair γ ξ f (μ ω, D ω)).2 a b :=
    Eventually.of_forall fun ω a b => ENNReal.toReal_nonneg
  have hΦs : ∀ (p : ↥(D₀ ×ˢ D₀)) (n k : ℕ), ∀ᵐ ω ∂P, Φ p n k (addFunPairing (hC ω) f) =
      internalMetric ((weylShiftPair γ ξ f (μ ω, D ω)).2)
        (Metric.thickening (((k : ℝ) + 1)⁻¹) (S₂ ∩ Metric.closedBall 0 ((n : ℝ) + 1))) p.1.1 p.1.2 :=
    fun p n k => by
      filter_upwards [hΦg p n k f hfcont, hSh] with ω h1 h2
      rw [h1, h2]
  have hMet_s : ∀ᵐ ω ∂P, A (rawFunctional (GFFJointLaw.jointSample
        (fun ω => addFunPairing (hC ω) f) (fun ω r z => hcirc ω r z + Real.circleAverage f z r) ω)) =
      ⨆ u ∈ S₂, ⨆ v ∈ S₂, internalMetric (weylShiftPair γ ξ f (μ ω, D ω)).2 S₂ u v := by
    filter_upwards [closedSup_eq_countable_sup hS₂c hS₂b hD₀S hD₀c hSD₀ Φ
      (fun ω => (weylShiftPair γ ξ f (μ ω, D ω)).2) hΦs hEucS hNs] with ω hω
    have hsat := saturation_of_distributionMeasurable
      (T := rawFunctional (GFFJointLaw.jointSample
