import HarmonicBalls.Defs.LQGMetric
import HarmonicBalls.Draft.Section11
import HarmonicBalls.FirstPass.S11j.CertificateTransfer

/-!
# Cameron-Martin transfer of a field event (fp-S11ab, owner z7)

Generic transfer of a positive-probability event through one distribution-measurable field set `B`:
* `cm_predicate_transfer`: for any predicate `Φ` on any random object `β` (a metric `D`, or a pair `(μ, D)` for E2),
  positive probability of the shifted event `{Φ (Xs ω)}` gives a measurable subset of the base event `{Φ (Xb ω)}` of
  positive probability, given the two one-sided a.s. clauses for `B`. Proof: `cameronMartinFieldCertificateTransfer`
  (FirstPass/S11j/CertificateTransfer.lean:35) applied to the exact preimages of `B`, then a monotone a.s. comparison
  and removal of a measurable null set. Uses the frozen `CameronMartinGFFMutualAbsCont` (FirstPass/Frozen/S11d.lean:67).
* `metric_event_transfer_of_rule`: the same for a metric predicate `Φ`, with `B` supplied by the named base form
  `MetricEventCertificateStmt` of the decoded rule, and the shifted clause as an explicit hypothesis `hshift`.
  Instances: E1 with `Φ := fun D => pinchFirstEvent D W T Q' Q δ`; E3 with `Φ := fun D => pinchThirdEvent D V W δ`
  (Draft/Section11.lean). Route: notes/fp-gaps/CHATGPT-z4-11-12-local-certificate.md section 6.2 (last sentence) and 6.4.

Named inputs, NOT literature inputs (no External/Proposed Prop; not proved here):
* `MetricEventCertificateStmt`: the base a.s. form of z4's decoded rule (rule measurability (e)); the forms it is built
  from are notes/fp-gaps/CHATGPT-K1-proof-z4-F4.md section 2.4 (lines 444-472) and
  notes/fp-gaps/CHATGPT-z4-11-12-local-certificate.md section 5 (lines 383-409).
* `hshift` (the shifted clause, exact type in `metric_event_transfer_of_rule`): the same `B` certifies the shifted metric
  one-sidedly. It does NOT follow from `MetricEventCertificateStmt`: that statement only quantifies over whole-plane GFF
  models, and the shifted field `hC + f` is GFF plus a smooth shift, not a whole-plane GFF. The written argument of
  section 6.2 uses this clause for the shifted field on the event F.
-/

namespace HarmonicBalls

open MeasureTheory

universe u

/-- Named input, base a.s. form of the decoded rule (z4's `PinchLocalCertificateStmt` route; rule measurability (e)).
For every insertion `α < Q` and every whole-plane GFF model with insertion metric `D` (`IsLQGMetricOfField`), there is a
distribution-measurable set `B` (for `distributionMeasurableSpace`, generated by the test pairings) such that
`hC ω ∈ B ↔ Φ (D ω)` almost surely. Not an External or Proposed Prop; a form the rule must supply. -/
def MetricEventCertificateStmt (γ ξ : ℝ) (Φ : (ℂ → ℂ → ℝ) → Prop) : Prop :=
  ∀ α : ℝ, α < lqgQ γ → ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) (D : Ω → ℂ → ℂ → ℝ),
    IsWholePlaneGFF P hC hcirc → IsLQGMetricOfField P γ ξ α hC D →
    ∃ B : Set ((ℂ → ℝ) → ℝ), MeasurableSet[distributionMeasurableSpace] B ∧
      ∀ᵐ ω ∂P, hC ω ∈ B ↔ Φ (D ω)

/-- Cameron-Martin transfer of an event through one distribution-measurable field set `B`, generic in the event.
Base and shifted events are `{Φ (Xb ω)}` and `{Φ (Xs ω)}` for any predicate `Φ` on any random object `β`. If `hC ω ∈ B`
forces `Φ (Xb ω)` almost surely, and `Φ (Xs ω)` forces `addFunPairing (hC ω) f ∈ B` almost surely, then positive
probability of `{Φ (Xs ω)}` gives a measurable subset of `{Φ (Xb ω)}` of positive probability. Completeness of `P` is not
used: the null set is removed through a measurable null superset. -/
theorem cm_predicate_transfer (hCM : CameronMartinGFFMutualAbsCont.{u}) {Ω : Type u} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ)
    (hGFF : IsWholePlaneGFF P hC hcirc) (f : ℂ → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hfc : HasCompactSupport f)
    (hf0 : Real.circleAverage f 0 1 = 0) {β : Type*} (Φ : β → Prop) (Xb Xs : Ω → β)
    (B : Set ((ℂ → ℝ) → ℝ)) (hB : MeasurableSet[distributionMeasurableSpace] B)
    (hbase : ∀ᵐ ω ∂P, hC ω ∈ B → Φ (Xb ω))
    (hshift : ∀ᵐ ω ∂P, Φ (Xs ω) → addFunPairing (hC ω) f ∈ B)
    (hpos : 0 < P {ω | Φ (Xs ω)}) :
    ∃ A ⊆ {ω | Φ (Xb ω)}, MeasurableSet A ∧ 0 < P A := by
  have hle : {ω | Φ (Xs ω)} ≤ᵐ[P] {ω | addFunPairing (hC ω) f ∈ B} := hshift
  have hpos' : 0 < P {ω | addFunPairing (hC ω) f ∈ B} := lt_of_lt_of_le hpos (measure_mono_ae hle)
  obtain ⟨A, hAE, hAm, hAp⟩ :=
    (cameronMartinFieldCertificateTransfer hCM Ω P hC hcirc f hGFF hf hfc hf0 {ω | hC ω ∈ B}
      {ω | addFunPairing (hC ω) f ∈ B}
      ⟨B, hB, Filter.Eventually.of_forall fun _ => Iff.rfl, Filter.Eventually.of_forall fun _ => Iff.rfl⟩).2.2.2
      hpos'
  have hS : P {ω | ¬ (hC ω ∈ B → Φ (Xb ω))} = 0 := ae_iff.1 hbase
  have hN0 : P (toMeasurable P {ω | ¬ (hC ω ∈ B → Φ (Xb ω))}) = 0 := by
    rw [measure_toMeasurable]; exact hS
  refine ⟨A \ toMeasurable P {ω | ¬ (hC ω ∈ B → Φ (Xb ω))}, ?_,
    hAm.diff (measurableSet_toMeasurable _ _), ?_⟩
  · intro ω hω
    by_contra hc
    exact hω.2 (subset_toMeasurable P _
      (show ¬ (hC ω ∈ B → Φ (Xb ω)) from fun h => hc (h (hAE hω.1))))
  · rw [measure_sdiff_null hN0]
    exact hAp

/-- Cameron-Martin transfer of a metric event `{Φ (D ω)}` with shifted event `{Φ (Dsh ω)}`, where `Φ` is a predicate on
the metric. The set `B` is the one given by the named base form `hrule` for the model `(Ω, P, hC, hcirc, D)`.
The shifted clause `hshift` (the type to be supplied for the shifted metric `Dsh` of `hC + f`) says: every distribution
set `B` that certifies the base event certifies the shifted event one-sidedly,
`∀ᵐ ω, Φ (Dsh ω) → addFunPairing (hC ω) f ∈ B`. Open: see the module docstring. -/
theorem metric_event_transfer_of_rule (hCM : CameronMartinGFFMutualAbsCont.{u}) {γ ξ : ℝ}
    {Φ : (ℂ → ℂ → ℝ) → Prop} (hrule : MetricEventCertificateStmt.{u} γ ξ Φ) {Ω : Type u} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ)
    (hGFF : IsWholePlaneGFF P hC hcirc) (α : ℝ) (hα : α < lqgQ γ) (D : Ω → ℂ → ℂ → ℝ)
    (hD : IsLQGMetricOfField P γ ξ α hC D) (f : ℂ → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hfc : HasCompactSupport f)
    (hf0 : Real.circleAverage f 0 1 = 0) (Dsh : Ω → ℂ → ℂ → ℝ)
    (hshift : ∀ B : Set ((ℂ → ℝ) → ℝ), MeasurableSet[distributionMeasurableSpace] B →
      (∀ᵐ ω ∂P, hC ω ∈ B ↔ Φ (D ω)) → ∀ᵐ ω ∂P, Φ (Dsh ω) → addFunPairing (hC ω) f ∈ B)
    (hpos : 0 < P {ω | Φ (Dsh ω)}) : ∃ A ⊆ {ω | Φ (D ω)}, MeasurableSet A ∧ 0 < P A := by
  obtain ⟨B, hB, hiff⟩ := hrule α hα Ω P hC hcirc D hGFF hD
  exact cm_predicate_transfer hCM P hC hcirc hGFF f hf hfc hf0 Φ D Dsh B hB
    (hiff.mono fun _ h => h.mp) (hshift B hB hiff) hpos

end HarmonicBalls
