import HarmonicBalls.Defs.LQGMetric
import HarmonicBalls.Steps.Sec11.MetricArcLength
import HarmonicBalls.FirstPass.S11m.WeylShift

/-!
# Normalised local field and its pairing σ-algebra

Route Steps 3.1 and 3.3 (6) of the written proof (the common local decoder of Lemma 11.12).
For a functional `T` of the field and a test function `ρ` with `∫ ρ = 1`, the normalised field `N_ρ T = T - ⟨T, ρ⟩` is the
constant shift `constShift T (T ρ)`, whose pairing with a test function `φ` is `T φ - T ρ · ∫φ`.

* `constShift_apply_of_integral_eq_zero`: on mean-zero tests the normalised field agrees with `T` (no linearity needed).
* `constShift_apply_eq_pairing_meanZero`: if `T` is linear on the pairings with `φ - (∫φ) ρ`, then
  `N_ρ T φ = T (φ - (∫φ) ρ)`, a mean-zero pairing. This is the only place where linearity enters.
* `pairingSigmaAlgebra_constShift_le`: the pairing σ-algebra of the normalised field on `U` is contained in the σ-algebra of the
  mean-zero pairings of `T` on `U` (the σ-algebra `Section6.fieldSigmaAlgebraModConst` at `α = 0`, generated by the same family).
* `weylScaling_const_eq_mul_ofReal`: for a Euclidean length metric, a constant weight `c` multiplies the metric by `e^{ξ c}`
  (Fact 2.2 III applied to a constant perturbation; `weylScaling_zero` of `IsEuclideanLengthMetric`).

Hypothesis `hlin` below is the a.s. linearity of the random field on the test functions of `U` (for each `ω`, pointwise in
this file). It is NOT provided by `IsWholePlaneGFF` (`HarmonicBalls/Defs/GFF.lean:93`), which only asks for Gaussian finite
families. No external input is used in this file.
-/

namespace HarmonicBalls.S11m

open MeasureTheory Set
open scoped ENNReal

/-- The constant shift `T - c · 1` of a functional `T` on test functions: `φ ↦ T φ - c ∫φ`. Its value on `φ` is
`T φ` when `φ` has mean zero. -/
noncomputable def constShift (T : (ℂ → ℝ) → ℝ) (c : ℝ) : (ℂ → ℝ) → ℝ :=
  addFunPairing T (fun _ => -c)

theorem constShift_apply (T : (ℂ → ℝ) → ℝ) (c : ℝ) (φ : ℂ → ℝ) :
    constShift T c φ = T φ + ∫ x, -c * φ x := by
  rfl

/-- On a mean-zero test function the constant shift does not change the pairing. -/
theorem constShift_apply_of_integral_eq_zero (T : (ℂ → ℝ) → ℝ) (c : ℝ) {φ : ℂ → ℝ}
    (hφ : ∫ x, φ x = 0) : constShift T c φ = T φ := by
  rw [constShift_apply, integral_const_mul, hφ, mul_zero, add_zero]

/-- Closure of test functions under `φ ↦ φ - a ρ`. -/
theorem isTestFunction_sub_const_mul {U : Set ℂ} {φ ρ : ℂ → ℝ} (hφ : IsTestFunction U φ) (hρ : IsTestFunction U ρ)
    (a : ℝ) : IsTestFunction U (fun x => φ x - a * ρ x) := by
  refine ⟨hφ.1.sub (contDiff_const.mul hρ.1), hφ.2.1.sub hρ.2.1.mul_left, ?_⟩
  exact (tsupport_sub _ _).trans (Set.union_subset hφ.2.2 ((tsupport_mul_subset_right (f := fun _ => a)).trans hρ.2.2))

/-- The normalised test function `φ - (∫φ) ρ` has mean zero when `∫ ρ = 1`. -/
theorem integral_sub_integral_mul_eq_zero {U : Set ℂ} {φ ρ : ℂ → ℝ} (hφ : IsTestFunction U φ)
    (hρ : IsTestFunction U ρ) (hρ1 : ∫ x, ρ x = 1) : ∫ x, (φ x - (∫ y, φ y) * ρ x) = 0 := by
  have hφi : Integrable φ := hφ.1.continuous.integrable_of_hasCompactSupport hφ.2.1
  have hρi : Integrable ρ := hρ.1.continuous.integrable_of_hasCompactSupport hρ.2.1
  rw [integral_sub hφi (hρi.const_mul _), integral_const_mul, hρ1]
  ring

/-- If `T` is linear on the normalised test functions `φ - (∫φ) ρ`, the normalised field is the mean-zero pairing:
`constShift T (T ρ) φ = T (φ - (∫φ) ρ)` for every test function `φ`. -/
theorem constShift_apply_eq_pairing_meanZero (T : (ℂ → ℝ) → ℝ) {U : Set ℂ} {ρ : ℂ → ℝ}
    (hlin : ∀ φ : ℂ → ℝ, IsTestFunction U φ → T (fun x => φ x - (∫ y, φ y) * ρ x) = T φ - (∫ y, φ y) * T ρ)
    {φ : ℂ → ℝ} (hφ : IsTestFunction U φ) :
    constShift T (T ρ) φ = T (fun x => φ x - (∫ y, φ y) * ρ x) := by
  rw [hlin φ hφ, constShift_apply]
  rw [show (∫ x, -(T ρ) * φ x) = -(T ρ) * ∫ x, φ x from integral_const_mul _ _]
  ring

/-- The pairing σ-algebra of the normalised field `N_ρ h = h - ⟨h, ρ⟩` on `U` is contained in the σ-algebra generated by the
mean-zero pairings of `h` on `U` (route Step 1 of Step 3.1; the σ-algebra of `Section6.fieldSigmaAlgebraModConst` at `α = 0`).
Here `∫ ρ = 1` and `ρ` is a test function on `U`, and `hlin` holds for every `ω` (see the module comment). -/
theorem pairingSigmaAlgebra_constShift_le {Ω : Type*} [MeasurableSpace Ω] (hC : Ω → (ℂ → ℝ) → ℝ) {U : Set ℂ}
    {ρ : ℂ → ℝ} (hρ : IsTestFunction U ρ) (hρ1 : ∫ x, ρ x = 1)
    (hlin : ∀ ω, ∀ φ : ℂ → ℝ, IsTestFunction U φ →
      hC ω (fun x => φ x - (∫ y, φ y) * ρ x) = hC ω φ - (∫ y, φ y) * hC ω ρ) :
    pairingSigmaAlgebra (fun ω => constShift (hC ω) (hC ω ρ)) U ≤
      MeasurableSpace.comap (fun ω => fun φ : {φ : ℂ → ℝ // IsTestFunction U φ ∧ ∫ x, φ x = 0} => hC ω φ.1)
        MeasurableSpace.pi := by
  set F : Ω → {φ : ℂ → ℝ // IsTestFunction U φ ∧ ∫ x, φ x = 0} → ℝ :=
    fun ω φ => hC ω φ.1 with hFdef
  unfold pairingSigmaAlgebra
  refine iSup₂_le fun φ hφ => ?_
  have hψ : IsTestFunction U (fun x => φ x - (∫ y, φ y) * ρ x) :=
    isTestFunction_sub_const_mul hφ hρ (∫ y, φ y)
  have hmz : ∫ x, (φ x - (∫ y, φ y) * ρ x) = 0 := integral_sub_integral_mul_eq_zero hφ hρ hρ1
  have heq : (fun ω => constShift (hC ω) (hC ω ρ) φ) =
      fun ω => F ω ⟨fun x => φ x - (∫ y, φ y) * ρ x, hψ, hmz⟩ := by
    funext ω
    exact constShift_apply_eq_pairing_meanZero (hC ω) (hlin ω) hφ
  have hF : Measurable[MeasurableSpace.comap F MeasurableSpace.pi] F := comap_measurable F
  have hev : Measurable (fun f : {φ : ℂ → ℝ // IsTestFunction U φ ∧ ∫ x, φ x = 0} → ℝ =>
      f ⟨fun x => φ x - (∫ y, φ y) * ρ x, hψ, hmz⟩) := measurable_pi_apply _
  have hmeas : Measurable[MeasurableSpace.comap F MeasurableSpace.pi]
      (fun ω => constShift (hC ω) (hC ω ρ) φ) := by
    rw [heq]
    exact hev.comp hF
  exact hmeas.comap_le

/-- For a Euclidean length metric `D` and a constant weight `c`, the Weyl scaling is `e^{ξ c}` times the metric
(Fact 2.2 III for a constant perturbation; the normalisation `N_ρ` of Step 3.3 (6) changes the metric by this factor). -/
theorem weylScaling_const_eq_mul_ofReal {D : ℂ → ℂ → ℝ} (hD : IsEuclideanLengthMetric D) (ξ c : ℝ) (u v : ℂ) :
    weylScaling D ξ (fun _ => c) u v = ENNReal.ofReal (Real.exp (ξ * c)) * ENNReal.ofReal (D u v) := by
  have h := weylScaling_add_const D ξ (fun _ => (0 : ℝ)) c u v
  have h0 : weylScaling D ξ (fun _ => (0 : ℝ)) u v = ENNReal.ofReal (D u v) := hD.weylScaling_zero ξ u v
  simp only [zero_add] at h
  rw [h, h0]

end HarmonicBalls.S11m
