import HarmonicBalls.Proofs.Sec8.ExteriorLaplacianIndependence
import HarmonicBalls.Proofs.Sec6.AnnulusIteration

/-! # The field germ and exterior Laplacian probes

This reduction uses Leonardo Bonanno's LatticeProb formalization of the ergodic theorem
through its Section 8 imports. -/

open MeasureTheory ProbabilityTheory Metric Set Laplacian
open scoped Topology ProbabilityTheory

namespace HarmonicBalls

/-- The σ-algebra generated by Laplacian pairings whose smooth compactly
supported potentials vanish on `U`. -/
@[instance_reducible]
noncomputable def exteriorLaplacianSigma {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ)
    (U : Set ℂ) : MeasurableSpace Ω :=
  ⨆ (ψ : ℂ → ℝ) (_ : IsTestFunction Set.univ ψ ∧
      IsTestFunction Set.univ (Δ ψ) ∧ ∀ x ∈ U, ψ x = 0),
    MeasurableSpace.comap (fun ω => hC ω (Δ ψ)) inferInstance

/-- Shrinking the excluded set gives more Laplacian probes. -/
theorem exteriorLaplacianSigma_antitone {Ω : Type*} (hC : Ω → (ℂ → ℝ) → ℝ)
    {U V : Set ℂ} (hUV : U ⊆ V) :
    exteriorLaplacianSigma hC V ≤ exteriorLaplacianSigma hC U := by
  unfold exteriorLaplacianSigma
  refine iSup_le fun ψ => iSup_le fun hψ => ?_
  exact le_iSup_of_le ψ (le_iSup_of_le ⟨hψ.1, hψ.2.1, fun x hx => hψ.2.2 x (hUV hx)⟩ le_rfl)

/-- Exterior Laplacian observables are measurable under a whole-plane GFF. -/
theorem IsWholePlaneGFF.exteriorLaplacianSigma_le
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) (U : Set ℂ) :
    exteriorLaplacianSigma hC U ≤ ‹MeasurableSpace Ω› := by
  unfold exteriorLaplacianSigma
  refine iSup_le fun ψ => iSup_le fun hψ => ?_
  exact (h.measurable_pairing (Δ ψ) hψ.2.1).comap_le

/-- The modulo-constant field on `U` is independent of Laplacian probes
whose potentials vanish on `U`. -/
theorem IsWholePlaneGFF.indep_fieldSigma_exteriorLaplacianSigma
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) (α₀ : ℝ) (U : Set ℂ) :
    Indep (Section6.fieldSigmaAlgebraModConst α₀ hC U)
      (exteriorLaplacianSigma hC U) P := by
  rw [Section6.fieldSigmaAlgebraModConst_eq α₀ hC U]
  let S := {φ : ℂ → ℝ // IsTestFunction U φ ∧ ∫ x, φ x = 0}
  let T := {ψ : ℂ → ℝ // IsTestFunction Set.univ ψ ∧
    IsTestFunction Set.univ (Δ ψ) ∧ ∀ x ∈ U, ψ x = 0}
  let X : Ω → S → ℝ := fun ω φ => hC ω φ.1
  let Y : Ω → T → ℝ := fun ω ψ => hC ω (Δ ψ.1)
  have hX : Section6.fieldSigmaAlgebraModConst 0 hC U ≤ MeasurableSpace.comap X MeasurableSpace.pi := by
    unfold Section6.fieldSigmaAlgebraModConst
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    have hm : Measurable[MeasurableSpace.comap X MeasurableSpace.pi] (fun ω => X ω ⟨φ, hφ⟩) := by
      let : MeasurableSpace Ω := MeasurableSpace.comap X MeasurableSpace.pi
      have hf : Measurable X := comap_measurable X
      exact (measurable_pi_iff.1 hf) ⟨φ, hφ⟩
    apply measurable_iff_comap_le.1
    simpa only [X, fieldPairing, zero_mul, sub_zero] using hm
  have hY : exteriorLaplacianSigma hC U ≤ MeasurableSpace.comap Y MeasurableSpace.pi := by
    unfold exteriorLaplacianSigma
    refine iSup_le fun ψ => iSup_le fun hψ => ?_
    have hm : Measurable[MeasurableSpace.comap Y MeasurableSpace.pi] (fun ω => Y ω ⟨ψ, hψ⟩) := by
      let : MeasurableSpace Ω := MeasurableSpace.comap Y MeasurableSpace.pi
      have hf : Measurable Y := comap_measurable Y
      exact (measurable_pi_iff.1 hf) ⟨ψ, hψ⟩
    exact measurable_iff_comap_le.1 hm
  have hind : Indep (MeasurableSpace.comap X MeasurableSpace.pi) (MeasurableSpace.comap Y MeasurableSpace.pi) P :=
    (IndepFun_iff_Indep X Y P).1 (h.indepFun_interiorPairings_exteriorLaplacians U)
  rw [Indep_iff] at hind ⊢
  intro s t hs ht
  exact hind s t (hX s hs) (hY t ht)

/-- The modulo-constant field germ at the origin, using a countable cofinal
sequence of radii. -/
@[instance_reducible]
noncomputable def originFieldGermSigma {Ω : Type*} (α₀ : ℝ)
    (hC : Ω → (ℂ → ℝ) → ℝ) : MeasurableSpace Ω :=
  ⨅ n : ℕ, Section6.fieldSigmaAlgebraModConst α₀ hC
    (ball 0 (((n : ℝ) + 1)⁻¹))

/-- The σ-algebra of Laplacian probes with potentials vanishing on some
neighborhood of the origin. -/
@[instance_reducible]
noncomputable def puncturedLaplacianSigma {Ω : Type*}
    (hC : Ω → (ℂ → ℝ) → ℝ) : MeasurableSpace Ω :=
  ⨆ n : ℕ, exteriorLaplacianSigma hC (ball 0 (((n : ℝ) + 1)⁻¹))

/-- The origin germ is independent of the σ-algebra generated by all
exterior Laplacian probes. -/
theorem IsWholePlaneGFF.indep_puncturedLaplacianSigma_originFieldGermSigma
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) (α₀ : ℝ) :
    Indep (puncturedLaplacianSigma hC) (originFieldGermSigma α₀ hC) P := by
  let : IsProbabilityMeasure P := h.isProbabilityMeasure
  let m : ℕ → MeasurableSpace Ω := fun n =>
    exteriorLaplacianSigma hC (ball 0 (((n : ℝ) + 1)⁻¹))
  have hm : Monotone m := by
    intro n k hnk
    apply exteriorLaplacianSigma_antitone hC
    apply ball_subset_ball
    exact (inv_le_inv₀ (by positivity) (by positivity)).2 (by
      exact_mod_cast Nat.add_le_add_right hnk 1)
  have hgerm : originFieldGermSigma α₀ hC ≤ mΩ := by
    refine (iInf_le _ 0).trans ?_
    exact (Section6.fieldSigmaAlgebraModConst_le α₀ hC _).trans
      (h.fieldSigmaAlgebra_le α₀ _)
  have hi (n : ℕ) : Indep (m n) (originFieldGermSigma α₀ hC) P := by
    have hlocal := (h.indep_fieldSigma_exteriorLaplacianSigma α₀
      (ball 0 (((n : ℝ) + 1)⁻¹))).symm
    have hle : originFieldGermSigma α₀ hC ≤ Section6.fieldSigmaAlgebraModConst α₀ hC
        (ball 0 (((n : ℝ) + 1)⁻¹)) := iInf_le _ n
    rw [Indep_iff] at hlocal ⊢
    intro s t hs ht
    exact hlocal s t hs (hle t ht)
  exact indep_iSup_of_monotone hi (fun n => h.exteriorLaplacianSigma_le _) hgerm hm

/-- A germ event that has an almost surely equal punctured-Laplacian
representative has probability zero or one. -/
theorem IsWholePlaneGFF.germ_event_zero_one_of_exterior_rep
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) (α₀ : ℝ) (A : Set Ω)
    (hA : MeasurableSet[originFieldGermSigma α₀ hC] A)
    (hrep : ∃ B : Set Ω, MeasurableSet[puncturedLaplacianSigma hC] B ∧ A =ᵐ[P] B) :
    P A = 0 ∨ P A = 1 := by
  let : IsProbabilityMeasure P := h.isProbabilityMeasure
  obtain ⟨B, hB, hAB⟩ := hrep
  have hgle : originFieldGermSigma α₀ hC ≤ ‹MeasurableSpace Ω› := by
    refine (iInf_le _ 0).trans ?_
    exact (Section6.fieldSigmaAlgebraModConst_le α₀ hC _).trans
      (h.fieldSigmaAlgebra_le α₀ _)
  have hAm : MeasurableSet A := hgle A hA
  have hi := (h.indep_puncturedLaplacianSigma_originFieldGermSigma α₀).indepSet_of_measurableSet hB hA
  have heq : P (A ∩ A) = P A * P A := by
    calc
      P (A ∩ A) = P (B ∩ A) := measure_congr (hAB.inter .rfl)
      _ = P B * P A := hi.measure_inter_eq_mul
      _ = P A * P A := by rw [measure_congr hAB]
  exact measure_eq_zero_or_one_of_indepSet_self
    ((indepSet_iff_measure_inter_eq_mul hAm hAm P).2 heq)

/-- Completed generation of the whole field modulo constants by exterior
Laplacian probes implies the field-germ zero–one law. -/
theorem IsWholePlaneGFF.origin_germ_trivial_of_exterior_generation
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) (α₀ : ℝ)
    (hgen : ∀ A : Set Ω, MeasurableSet[Section6.fieldSigmaAlgebraModConst α₀ hC Set.univ] A →
      ∃ B : Set Ω, MeasurableSet[puncturedLaplacianSigma hC] B ∧ A =ᵐ[P] B) :
    ∀ A : Set Ω, (∀ ε : ℝ, 0 < ε →
      MeasurableSet[Section6.fieldSigmaAlgebraModConst α₀ hC (ball 0 ε)] A) →
      P A = 0 ∨ P A = 1 := by
  intro A hA
  have hAg : MeasurableSet[originFieldGermSigma α₀ hC] A := by
    rw [originFieldGermSigma, MeasurableSpace.measurableSet_iInf]
    intro n
    exact hA _ (by positivity)
  have hAu : MeasurableSet[Section6.fieldSigmaAlgebraModConst α₀ hC Set.univ] A := by
    have hle : originFieldGermSigma α₀ hC ≤
        Section6.fieldSigmaAlgebraModConst α₀ hC (ball 0 (1 : ℝ)) := by
      simpa [originFieldGermSigma] using
        (iInf_le (fun n : ℕ => Section6.fieldSigmaAlgebraModConst α₀ hC
          (ball 0 (((n : ℝ) + 1)⁻¹))) 0)
    exact (fieldSigmaAlgebraModConst_mono α₀ hC (subset_univ _)) A (hle A hAg)
  exact h.germ_event_zero_one_of_exterior_rep α₀ A hAg (hgen A hAu)

end HarmonicBalls
