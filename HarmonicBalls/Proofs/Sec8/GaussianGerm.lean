import HarmonicBalls.Proofs.Sec8.IndependentGerm
import HarmonicBalls.Defs.GFF
import Mathlib.Probability.Distributions.Gaussian.IsGaussianProcess.Independence

/-! # Gaussian layers and trivial germs -/

open MeasureTheory ProbabilityTheory Filter Metric Set

namespace HarmonicBalls

/-- The sigma algebra generated by a family of whole-plane GFF observables. -/
@[instance_reducible]
noncomputable def gffObservableSigmaAlgebra {Ω ι : Type*}
    (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ)
    (o : ι → GFFObservable.Admissible) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω i => (o i).1.eval (hC ω) (hcirc ω)) inferInstance

/-- Admissible observable families give sub-σ-algebras of the sample space. -/
theorem IsWholePlaneGFF.gffObservableSigmaAlgebra_le
    {Ω ι : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) (o : ι → GFFObservable.Admissible) :
    gffObservableSigmaAlgebra hC hcirc o ≤ ‹MeasurableSpace Ω› := by
  apply Measurable.comap_le
  apply Measurable.of_eval
  intro i
  obtain ⟨v, hv⟩ := o i
  cases v with
  | pairing φ => exact h.measurable_pairing φ hv
  | circle r z => exact h.measurable_circle r z hv

/-- Families of GFF observables with zero covariance between different layers
form independent sigma algebras. -/
theorem IsWholePlaneGFF.iIndep_gffObservableSigmaAlgebra
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) {ι : ℕ → Type*}
    (o : (n : ℕ) → ι n → GFFObservable.Admissible)
    (horth : ∀ n k, n ≠ k → ∀ i j, wholePlaneGFFCov (o n i).1 (o k j).1 = 0) :
    iIndep (fun n => gffObservableSigmaAlgebra hC hcirc (o n)) P := by
  let X : (n : ℕ) → ι n → Ω → ℝ := fun n i ω => (o n i).1.eval (hC ω) (hcirc ω)
  have hg : IsGaussianProcess (fun (p : (n : ℕ) × ι n) ω => X p.1 p.2 ω) P :=
    h.isGaussianProcess.comp_right (fun p : (n : ℕ) × ι n => o p.1 p.2)
  have hm : ∀ n i, AEMeasurable (X n i) P := by
    intro n i
    exact (hg.hasGaussianLaw_eval ⟨n, i⟩).aemeasurable
  have hi := hg.iIndepFun_of_covariance_eq_zero hm (by
    intro n k hne i j
    exact (h.covariance_eq (o n i).1 (o k j).1 (o n i).2 (o k j).2).trans
      (horth n k hne i j))
  exact hi.iIndep

/-- A germ contained in tails of covariance-orthogonal GFF observable layers
is trivial. The layer construction and containment are explicit hypotheses. -/
theorem IsWholePlaneGFF.germ_trivial_of_covarianceOrthogonalLayers
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc) (germ : ℝ → MeasurableSpace Ω)
    {ι : ℕ → Type*} (o : (n : ℕ) → ι n → GFFObservable.Admissible)
    (horth : ∀ n k, n ≠ k → ∀ i j, wholePlaneGFFCov (o n i).1 (o k j).1 = 0)
    (hcontain : ∀ n, ∃ ε : ℝ, 0 < ε ∧
      germ ε ≤ ⨆ k ≥ n, gffObservableSigmaAlgebra hC hcirc (o k)) :
    ∀ A : Set Ω, (∀ ε, 0 < ε → MeasurableSet[germ ε] A) → P A = 0 ∨ P A = 1 := by
  exact germ_trivial_of_independent_layers P germ _
    (fun n => h.gffObservableSigmaAlgebra_le (o n))
    (h.iIndep_gffObservableSigmaAlgebra o horth) hcontain

/-- The covariance of concentric circle averages at radii at most one is
minus the logarithm of the larger radius. -/
theorem wholePlaneGFFCov_concentric_circles {r s : ℝ}
    (hr : 0 < r) (hs : 0 < s) (hrs : r ≤ s) (hs1 : s ≤ 1) :
    wholePlaneGFFCov (.circle r 0) (.circle s 0) = -Real.log s := by
  change Real.circleAverage (fun x => Real.circleAverage (fun y => wholePlaneCov x y) 0 s) 0 r = _
  rw [Real.circleAverage_congr_sphere (f₂ := fun _ => -Real.log s), Real.circleAverage_const]
  intro x hx
  have hx' : ‖x‖ = r := by simpa [abs_of_pos hr] using hx
  have h : Real.circleAverage (fun y => wholePlaneCov x y) 0 s =
      Real.circleAverage (fun y => -Real.log ‖y - x‖) 0 s := by
    apply Real.circleAverage_congr_sphere
    intro y hy
    have hy' : ‖y‖ = s := by simpa [abs_of_pos hs] using hy
    simp only
    rw [wholePlaneCov_eq_neg_log (hx'.le.trans (hrs.trans hs1)) (hy'.le.trans hs1), norm_sub_rev]
  show Real.circleAverage (fun y => wholePlaneCov x y) 0 s = -Real.log s
  rw [h]
  have h0 := circleAverage_log_norm_sub_const_eq_log_radius_add_posLog (c := 0) (a := x) hs.ne'
  have hratio : |s⁻¹ * r| ≤ 1 := by
    rw [abs_of_nonneg (mul_nonneg (inv_nonneg.mpr hs.le) hr.le)]
    exact (inv_mul_le_one₀ hs).2 hrs
  rw [zero_sub, norm_neg, hx', (Real.posLog_eq_zero_iff _).2 hratio, add_zero] at h0
  rw [Real.circleAverage_def] at h0 ⊢
  rw [intervalIntegral.integral_neg, smul_neg, h0]

end HarmonicBalls
