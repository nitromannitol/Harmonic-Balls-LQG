import HarmonicBalls.Proofs.Sec8.GermTriviality
import Mathlib.Probability.Independence.ZeroOne

/-!
# Trivial germs from independent layers

Kolmogorov's zero-one law applies when each sufficiently small germ is
contained in the tail generated by an independent sequence of layers.
For the whole-plane GFF, the construction of such layers and this containment
are separate tasks.
-/

open MeasureTheory ProbabilityTheory Filter

namespace HarmonicBalls

/-- A germ contained arbitrarily far out in the tail of independent
sub-σ-algebras is trivial. -/
theorem germ_trivial_of_independent_layers {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) (germ : ℝ → MeasurableSpace Ω) (layers : ℕ → MeasurableSpace Ω)
    (hle : ∀ n, layers n ≤ mΩ) (hindep : iIndep layers P)
    (hcontain : ∀ n, ∃ ε : ℝ, 0 < ε ∧ germ ε ≤ ⨆ k ≥ n, layers k) :
    ∀ A : Set Ω, (∀ ε, 0 < ε → MeasurableSet[germ ε] A) → P A = 0 ∨ P A = 1 := by
  intro A hA
  apply measure_zero_or_one_of_measurableSet_limsup_atTop hle hindep
  rw [Filter.limsup_eq_iInf_iSup_of_nat, MeasurableSpace.measurableSet_iInf]
  intro n
  obtain ⟨ε, hε, hεle⟩ := hcontain n
  exact hεle A (hA ε hε)

end HarmonicBalls
