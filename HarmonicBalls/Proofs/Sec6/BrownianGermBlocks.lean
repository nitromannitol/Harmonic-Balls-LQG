import HarmonicBalls.Proofs.Sec6.PlanarIncrementBlocks
import HarmonicBalls.Proofs.Sec6.InstantHitGerm

/-! # The Brownian germ and shrinking increment blocks

Continuous paths can be reconstructed, up to their initial value, from the
increments on blocks shrinking to zero.
-/

namespace HarmonicBalls.Section6

open MeasureTheory ProbabilityTheory MarkovProcess Filter
open scoped NNReal Topology

/-- Left endpoint of the `i`th time block. -/
def shrinkingBlockLower (d : ℕ → NNReal) (i : ℕ) (_ : NNReal) : NNReal := d (i + 1)

/-- Clamp a time to the `i`th time block. -/
def shrinkingBlockUpper (d : ℕ → NNReal) (i : ℕ) (t : NNReal) : NNReal :=
  max (d (i + 1)) (min (d i) t)

/-- Sigma-algebra generated by all increments within a shrinking time block. -/
noncomputable abbrev shrinkingBlockSigma (d : ℕ → NNReal) (i : ℕ) : MeasurableSpace (ContinuousPath ℂ) :=
  (inferInstance : MeasurableSpace (NNReal → ℂ)).comap
    (fun ω t => ω (shrinkingBlockUpper d i t) - ω (shrinkingBlockLower d i t))

/-- The clipped block increment equals the difference of the two evaluations
of a path stopped at `t`. -/
theorem shrinkingBlock_increment_eq (d : ℕ → NNReal) (hd : Antitone d)
    (i : ℕ) (t : NNReal) (ω : ContinuousPath ℂ) :
    ω (shrinkingBlockUpper d i t) - ω (shrinkingBlockLower d i t) =
      ω (min t (d i)) - ω (min t (d (i + 1))) := by
  have hdi : d (i + 1) ≤ d i := hd (Nat.le_succ i)
  by_cases ht : t ≤ d (i + 1)
  · simp [shrinkingBlockUpper, shrinkingBlockLower, min_eq_left ht,
      min_eq_left (ht.trans hdi), min_eq_right (ht.trans hdi), max_eq_left ht]
  · have hlt : d (i + 1) ≤ t := le_of_not_ge ht
    have hm : d (i + 1) ≤ min (d i) t := le_min hdi hlt
    change ω (max (d (i + 1)) (min (d i) t)) - ω (d (i + 1)) = _
    rw [max_eq_right hm, min_eq_right hlt, min_comm (d i) t]

/-- Finite sums of clipped increments telescope. -/
theorem shrinkingBlock_sum (d : ℕ → NNReal) (hd : Antitone d)
    (n N : ℕ) (t : NNReal) (ω : ContinuousPath ℂ) :
    (∑ k ∈ Finset.range N,
      (ω (shrinkingBlockUpper d (n + k) t) - ω (shrinkingBlockLower d (n + k) t))) =
      ω (min t (d n)) - ω (min t (d (n + N))) := by
  simp_rw [shrinkingBlock_increment_eq d hd]
  simpa [Nat.add_assoc] using
    Finset.sum_range_sub' (fun k => ω (min t (d (n + k)))) N

/-- The value of a path relative to its initial value, at a time before the
`n`th endpoint, is measurable from all increment blocks numbered at least `n`. -/
theorem measurable_centered_eval_shrinkingBlock_tail
    (d : ℕ → NNReal) (hd : Antitone d) (hzero : Tendsto d atTop (𝓝 0))
    (n : ℕ) (t : NNReal) (ht : t ≤ d n) :
    Measurable[⨆ i ≥ n, shrinkingBlockSigma d i]
      (fun ω : ContinuousPath ℂ => ω t - ω 0) := by
  let T : MeasurableSpace (ContinuousPath ℂ) := ⨆ i ≥ n, shrinkingBlockSigma d i
  have hblock (i : ℕ) (hi : n ≤ i) :
      Measurable[T] (fun ω : ContinuousPath ℂ =>
        ω (shrinkingBlockUpper d i t) - ω (shrinkingBlockLower d i t)) := by
    have hle : shrinkingBlockSigma d i ≤ T :=
      le_iSup_of_le i (le_iSup_of_le hi le_rfl)
    have hm : Measurable[T] (fun ω : ContinuousPath ℂ => fun s : NNReal =>
        ω (shrinkingBlockUpper d i s) - ω (shrinkingBlockLower d i s)) :=
      Measurable.of_comap_le hle
    exact (measurable_pi_apply t).comp hm
  apply measurable_of_tendsto_metrizable
    (f := fun N ω => ∑ k ∈ Finset.range N,
      (ω (shrinkingBlockUpper d (n + k) t) - ω (shrinkingBlockLower d (n + k) t)))
  · intro N
    exact Finset.measurable_sum _ fun k _ => hblock (n + k) (Nat.le_add_right n k)
  · apply tendsto_pi_nhds.mpr
    intro ω
    have hn : Tendsto (fun N => d (n + N)) atTop (𝓝 0) := by
      apply hzero.comp
      simpa [Nat.add_comm] using Filter.tendsto_add_atTop_nat n
    have hmin : Tendsto (fun N => min t (d (n + N))) atTop (𝓝 0) := by
      simpa using tendsto_const_nhds.min hn
    have heval : Tendsto (fun N => ω (min t (d (n + N)))) atTop (𝓝 (ω 0)) :=
      ω.continuous.continuousAt.tendsto.comp hmin
    have hres : Tendsto (fun N : ℕ => ω t - ω (min t (d (n + N))))
        atTop (𝓝 (ω t - ω 0)) := tendsto_const_nhds.sub heval
    simpa only [shrinkingBlock_sum d hd, min_eq_left ht] using hres

/-- Recentered germ events are measurable in the tail of shrinking increment
blocks. -/
theorem recentered_germ_le_shrinkingBlock_tail
    (x : ℂ) (d : ℕ → NNReal) (hd : Antitone d)
    (hpos : ∀ n, 0 < d n) (hzero : Tendsto d atTop (𝓝 0)) :
    (⨅ (t : NNReal) (_ : 0 < t),
      ContinuousPath.canonicalFiltration (alpha := ℂ) t).comap
        (resetPlanarPathInitialValue x) ≤
      limsup (shrinkingBlockSigma d) atTop := by
  rw [Filter.limsup_eq_iInf_iSup_of_nat]
  apply le_iInf
  intro n
  have hgerm : (⨅ (t : NNReal) (_ : 0 < t),
      ContinuousPath.canonicalFiltration (alpha := ℂ) t) ≤
      ContinuousPath.canonicalFiltration (alpha := ℂ) (d n) :=
    iInf_le_of_le (d n) (iInf_le _ (hpos n))
  apply le_trans (MeasurableSpace.comap_mono hgerm)
  change (⨆ t : Set.Iic (d n), MeasurableSpace.comap
    (ContinuousPath.coordinateProcess (alpha := ℂ) t) inferInstance).comap
      (resetPlanarPathInitialValue x) ≤ _
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro t
  rw [MeasurableSpace.comap_comp]
  apply Measurable.comap_le
  change Measurable[⨆ i ≥ n, shrinkingBlockSigma d i]
    (fun ω : ContinuousPath ℂ => ω t - ω 0 + x)
  exact (measurable_centered_eval_shrinkingBlock_tail d hd hzero n t t.property).add_const x

/-- Distinct blocks of a decreasing sequence have ordered disjoint interiors. -/
theorem shrinkingBlock_disjoint (d : ℕ → NNReal) (hd : Antitone d)
    (i j : ℕ) (hij : i ≠ j) (s t : NNReal) :
    shrinkingBlockUpper d i s ≤ shrinkingBlockLower d j t ∨
      shrinkingBlockUpper d j t ≤ shrinkingBlockLower d i s := by
  rcases lt_or_gt_of_ne hij with hij | hji
  · right
    have h1 : d j ≤ d (i + 1) := hd (Nat.succ_le_of_lt hij)
    have h2 : d (j + 1) ≤ d (i + 1) := hd (by omega)
    exact max_le h2 ((min_le_left _ _).trans h1)
  · left
    have h1 : d i ≤ d (j + 1) := hd (Nat.succ_le_of_lt hji)
    have h2 : d (i + 1) ≤ d (j + 1) := hd (by omega)
    exact max_le h2 ((min_le_left _ _).trans h1)

/-- The germ sigma-algebra of planar Brownian motion is independent of itself
(Blumenthal's zero-one law). -/
theorem planarBrownian_germ_indep_self (x : ℂ) :
    Indep
      (⨅ (t : NNReal) (_ : 0 < t), ContinuousPath.canonicalFiltration (alpha := ℂ) t)
      (⨅ (t : NNReal) (_ : 0 < t), ContinuousPath.canonicalFiltration (alpha := ℂ) t)
      (planarBrownianMotion x) := by
  let d : ℕ → NNReal := fun n => (1 / 2 : NNReal) ^ n
  have hd : Antitone d := fun i j hij =>
    pow_le_pow_right_of_le_one' (by norm_num) hij
  have hp : ∀ n, 0 < d n := fun n => pow_pos (by norm_num) n
  have hz : Tendsto d atTop (𝓝 0) :=
    NNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num)
  apply planarBrownian_germ_indep_of_recentered_tail x
    (shrinkingBlockLower d) (shrinkingBlockUpper d)
  · intro i s
    exact le_max_left _ _
  · exact shrinkingBlock_disjoint d hd
  · exact recentered_germ_le_shrinkingBlock_tail x d hd hp hz

/-- A countable union of compact sets is hit instantaneously almost surely
whenever the probability of instantaneous hitting is positive. -/
theorem ae_instant_hit_compact_union_of_pos (x : ℂ)
    (K : ℕ → Set ℂ) (hK : ∀ n, IsCompact (K n))
    (hpos : 0 < planarBrownianMotion x
      {ω | ContinuousPath.exitTime (⋃ n, K n)ᶜ ω = 0}) :
    ∀ᵐ ω ∂(planarBrownianMotion x), ContinuousPath.exitTime (⋃ n, K n)ᶜ ω = 0 :=
  ae_instant_hit_of_germ_indep x (planarBrownian_germ_indep_self x) K hK hpos

/-- The zero-one premise used in the LQG fine-support reduction holds for
planar Brownian motion. -/
theorem planarBrownian_compact_union_zeroOne :
    ∀ x : ℂ, ∀ K : ℕ → Set ℂ, (∀ n, IsCompact (K n)) → Monotone K →
      0 < planarBrownianMotion x {ω | ContinuousPath.exitTime (⋃ n, K n)ᶜ ω = 0} →
      ∀ᵐ ω ∂(planarBrownianMotion x), ContinuousPath.exitTime (⋃ n, K n)ᶜ ω = 0 := by
  intro x K hK _ hpos
  exact ae_instant_hit_compact_union_of_pos x K hK hpos

end HarmonicBalls.Section6
