import HarmonicBalls.Proofs.GFF.LQGMetricUniqueness
import LatticeProb.Prob.AeEqOfGenerators

/-!
# Existence and uniqueness of the γ-LQG metric on pairing functionals

The σ-algebra `distributionMeasurableSpace` on pairing functionals `(ℂ → ℝ) → ℝ` is generated by the
pairings `T ↦ T φ` with test functions `φ`. Two random pairing functionals that agree almost surely on
each test function therefore agree almost surely under every measurable real functional of them
(`ae_eq_comp_of_ae_eq_testPairing`, the specialization of
`LatticeProb.ae_eq_comp_of_ae_eq_generators` to the test-function pairings). This is the remaining
hypothesis of `lqgMetricExistenceUniqueness_of_ae_eq`, so the existence and uniqueness of the γ-LQG
metric (Gwynne-Miller, Theorems 1.1 and 1.2, with Weyl exponent `ξ = γ / d_γ`) holds without
further inputs: `lqgMetricExistenceUniqueness_derived`.
-/

open MeasureTheory

namespace HarmonicBalls

/-- Random pairing functionals that agree almost surely on every test function agree almost surely
under every `distributionMeasurableSpace`-measurable real functional. -/
theorem ae_eq_comp_of_ae_eq_testPairing {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    (X Y : Ω → (ℂ → ℝ) → ℝ)
    (hXY : ∀ φ : ℂ → ℝ, IsTestFunction Set.univ φ → ∀ᵐ ω ∂P, X ω φ = Y ω φ)
    (F : ((ℂ → ℝ) → ℝ) → ℝ) (hF : Measurable[distributionMeasurableSpace] F) :
    ∀ᵐ ω ∂P, F (X ω) = F (Y ω) := by
  have hm : distributionMeasurableSpace ≤
      ⨆ i : {φ : ℂ → ℝ // IsTestFunction Set.univ φ},
        MeasurableSpace.comap (fun T : (ℂ → ℝ) → ℝ => T i.1) inferInstance := by
    unfold distributionMeasurableSpace
    exact iSup₂_le fun φ hφ =>
      le_iSup_of_le (⟨φ, hφ⟩ : {φ : ℂ → ℝ // IsTestFunction Set.univ φ}) le_rfl
  exact LatticeProb.ae_eq_comp_of_ae_eq_generators (β := fun _ => ℝ)
    (p := fun (i : {φ : ℂ → ℝ // IsTestFunction Set.univ φ}) (T : (ℂ → ℝ) → ℝ) => T i.1) hm
    (fun i => hXY i.1 i.2) hF

/-- **Existence and uniqueness of the γ-LQG metric** (Gwynne-Miller, Theorems 1.1 and 1.2): the
statement `LQGMetricExistenceUniqueness`, with no remaining hypothesis. -/
theorem lqgMetricExistenceUniqueness_derived : LQGMetricExistenceUniqueness :=
  lqgMetricExistenceUniqueness_of_ae_eq ae_eq_comp_of_ae_eq_testPairing

end HarmonicBalls
