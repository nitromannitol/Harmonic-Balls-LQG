import HarmonicBalls.Proofs.GFF.DMSWholePlaneConsumers

/-!
# Duplantier-Miller-Sheffield, Lemma A.10, whole-plane clause: the normalized form

This file proves `DMSLemmaA10WholePlane` (`Proposed/DuplantierMillerSheffield.lean`) for every whole-plane GFF
`(P, hC, hcirc)` and every `γ`-LQG measure `μ` of it with `γ ∈ (0, 2)`: for every bounded function `F` of the
field, measurable for the σ-algebra generated by all pairings with test functions,
`E [μ_h(B_1) F(h)] / E [μ_h(B_1)] = |B_1|⁻¹ ∫_{B_1} E [F(h + f_z + κ)] dz`.

The normalized law of DMS, Lemma A.10 (arXiv:1409.7055v4, Appendix A, p. 184) is the unnormalized identity
`dmsLemmaA10WholePlaneUnnormalized_holds` divided by its case `F ≡ 1`, which reads `E [μ_h(B_1)] = π = |B_1|`
(`IsWholePlaneGFF.integral_measure_ball_eq_pi`).

## Main statements

* `HarmonicBalls.dmsLemmaA10WholePlane_holds`
-/

namespace HarmonicBalls

open MeasureTheory Set Metric

/-- **Duplantier-Miller-Sheffield, Lemma A.10, whole-plane clause, for `D = B_1`.**
For every whole-plane GFF `(P, hC, hcirc)` and every `γ`-LQG measure `μ` of it with `γ ∈ (0, 2)`, the law of the
field weighted by `μ_h(B_1)` is the Lebesgue average over `z ∈ B_1` of the law of the output
`h + f_z + κ` of the sampling procedure, tested against every bounded measurable observable of the whole field. -/
theorem dmsLemmaA10WholePlane_holds {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {γ : ℝ}
    (hγ0 : 0 < γ) (hγ2 : γ < 2) (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ) :
    DMSLemmaA10WholePlane P γ hC hcirc μ := by
  intro hh hμ F hF hFb
  have hvol : (volume (ball (0 : ℂ) 1)).toReal = Real.pi := by
    simp [Complex.volume_ball]
  rw [dmsLemmaA10WholePlaneUnnormalized_holds P hγ0 hγ2 hC hcirc μ hh hμ F hF hFb,
    hh.integral_measure_ball_eq_pi hγ0 hγ2 hμ, hvol]

end HarmonicBalls
