import HarmonicBalls.Proposed.DuplantierMillerSheffield
import HarmonicBalls.FirstPass.LPBridge.M1
import HarmonicBalls.FirstPass.LPBridge.M4
import LatticeProb.LQG.MarkedRootingCircle
import LatticeProb.Gauss.GFFAffineInvariance

/-!
# Duplantier-Miller-Sheffield, Lemma A.10, whole-plane clause: the unnormalized form

This file proves `DMSLemmaA10WholePlaneUnnormalized` (`Proposed/DuplantierMillerSheffield.lean`) for every
whole-plane GFF `(P, hC, hcirc)` and every `γ`-LQG measure `μ` of it with `γ ∈ (0, 2)`: for every bounded
function `F` of the field, measurable for the σ-algebra generated by all pairings with test functions,
`E [μ_h(B_1) F(h)] = ∫_{B_1} E [F(h + f_z + κ)] dz`, where `f_z(w) = -γ log |w - z| + γ log max(|w|, 1)` and
`κ` re-fixes the unit-circle average.

The argument is the one of DMS, Lemma A.10 (arXiv:1409.7055v4, Appendix A, pp. 184-185): the law of the field
weighted by `μ_h(B_1)` is the Lebesgue average over the root `z ∈ B_1` of the law of `h` shifted by
`γ Cov(h(·), h(z))`.

* For finitely many test functions this is the marked rooting identity
  `LatticeProb.Gauss.IsWholePlaneGFF.lintegral_lqgMeasure_marked_fun_eq`.
* The finite-dimensional cylinders form a `π`-system generating the product σ-algebra over all test functions,
  so the two finite measures on the pairings agree (`IsWholePlaneGFF.map_withDensity_lqgMass_eq`).
* A function measurable for `pairingSigmaAlgebra` factors measurably through the family of pairings
  (`Measurable.exists_eq_measurable_comp`), which gives the identity for bounded `F`
  (`IsWholePlaneGFF.integral_lqgMass_mul_eq`).
* For `|z| < 1`, `f_z = γ Cov(·, z)` (`dmsShift_eq_mul_wholePlaneCov`), the unit-circle average of `f_z`
  vanishes, and `h_1(0) = 0` almost surely, so the procedure's output is the shifted field
  (`dmsShiftedPairing_zero_eq`).

## Main statements

* `HarmonicBalls.IsWholePlaneGFF.map_withDensity_lqgMass_eq`
* `HarmonicBalls.IsWholePlaneGFF.integral_lqgMass_mul_eq`
* `HarmonicBalls.dmsLemmaA10WholePlaneUnnormalized_holds`
-/

namespace HarmonicBalls

open MeasureTheory Set Metric
open scoped ENNReal

/-- The test functions on the plane: the index set of the pairings generating `pairingSigmaAlgebra`. -/
abbrev PlaneTest : Type := {φ : ℂ → ℝ // IsTestFunction univ φ}

/-- The family of pairings `T ↦ (T φ)_φ` with test functions on the plane. -/
def planeTestPairings (T : (ℂ → ℝ) → ℝ) : PlaneTest → ℝ := fun φ => T φ.1

/-- The σ-algebra generated by the pairings with test functions is contained in the pullback of the product
σ-algebra along the family of pairings. -/
theorem pairingSigmaAlgebra_univ_le_comap :
    pairingSigmaAlgebra (fun T : (ℂ → ℝ) → ℝ => T) univ ≤
      MeasurableSpace.comap planeTestPairings MeasurableSpace.pi := by
  refine iSup₂_le fun φ hφ => ?_
  show MeasurableSpace.comap ((fun x : PlaneTest → ℝ => x ⟨φ, hφ⟩) ∘ planeTestPairings) _ ≤ _
  rw [← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_pi_apply _).comap_le

/-- For a root `z` in the unit disk, the function `f_z` of the whole-plane clause is `γ` times the covariance
kernel of the whole-plane GFF. -/
theorem dmsShift_eq_mul_wholePlaneCov (γ : ℝ) {z : ℂ} (hz : ‖z‖ < 1) (w : ℂ) :
    dmsShift γ z w = γ * wholePlaneCov w z := by
  have hz1 : max ‖z‖ 1 = 1 := max_eq_right hz.le
  unfold dmsShift wholePlaneCov
  rw [hz1, mul_one]
  rcases eq_or_ne w z with rfl | hwz
  · simp [hz1]
  · rw [Real.log_div (lt_max_of_lt_right one_pos).ne' (norm_ne_zero_iff.2 (sub_ne_zero.2 hwz))]
    ring

/-- For a root `z` in the unit disk and a field with `h_1(0) = 0`, the output `h + f_z + κ` of the sampling
procedure is the field shifted by `γ Cov(·, z)`. -/
theorem dmsShiftedPairing_zero_eq (γ : ℝ) {z : ℂ} (hz : ‖z‖ < 1) (T : (ℂ → ℝ) → ℝ) :
    dmsShiftedPairing γ z T 0 = fun φ => T φ + γ * ∫ x, φ x * wholePlaneCov x z := by
  have havg : Real.circleAverage (dmsShift γ z) 0 1 = 0 := by
    have h1 : dmsShift γ z = γ • fun w => LatticeProb.Gauss.wholePlaneCov z w := funext fun w => by
      rw [Pi.smul_apply, smul_eq_mul, dmsShift_eq_mul_wholePlaneCov γ hz w,
        LatticeProb.Gauss.wholePlaneCov_symm]
      rfl
    rw [h1, Real.circleAverage_smul, LatticeProb.LQG.AffineDerived.circleAverage_wholePlaneCov_unit,
      smul_zero]
  funext φ
  rw [dmsShiftedPairing, dmsConstant, havg, add_zero, neg_zero, zero_mul, add_zero, ← integral_const_mul]
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only
  rw [dmsShift_eq_mul_wholePlaneCov γ hz x]
  ring

/-- An LQG measure of the field with no insertion is an LQG measure of the circle averages. -/
theorem isLQGMeasure_of_isLQGMeasureOfField_zero {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {γ : ℝ}
    {hcirc : Ω → ℝ → ℂ → ℝ} {μ : Ω → Measure ℂ} (hμ : IsLQGMeasureOfField P γ 0 hcirc μ) :
    LatticeProb.LQG.IsLQGMeasure P γ hcirc μ := by
  have h := (LPBridge.isLQGMeasureOfField_iff P γ 0 hcirc μ).1 hμ
  have e : (fun ω => LatticeProb.Gauss.fieldCircleAverage 0 (hcirc ω)) = hcirc := by
    funext ω r z
    simp [LatticeProb.Gauss.fieldCircleAverage]
  unfold LatticeProb.LQG.IsLQGMeasureOfField at h
  rwa [e] at h

namespace IsWholePlaneGFF

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hC : Ω → (ℂ → ℝ) → ℝ}
  {hcirc : Ω → ℝ → ℂ → ℝ}

/-- **The rooted law of all pairings.** The law of the family of pairings `((h, φ))_φ` with all test functions,
weighted by `μ_h(B_1)`, is the image of Lebesgue measure on `B_1` times `P` under
`(z, ω) ↦ ((h, φ) + γ ∫ φ(x) Cov(x, z) dx)_φ`. -/
theorem map_withDensity_lqgMass_eq (hh : IsWholePlaneGFF P hC hcirc) {γ : ℝ} (hγ0 : 0 < γ) (hγ2 : γ < 2)
    {μ : Ω → Measure ℂ} (hμ : IsLQGMeasureOfField P γ 0 hcirc μ) :
    (P.withDensity fun ω => μ ω (ball 0 1)).map (fun ω => planeTestPairings (hC ω)) =
      ((volume.restrict (ball (0 : ℂ) 1)).prod P).map
        (fun q : ℂ × Ω => fun φ : PlaneTest => hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1) := by
  have hh' := (LPBridge.isWholePlaneGFF_iff P hC hcirc).1 hh
  have hμ' := isLQGMeasure_of_isLQGMeasureOfField_zero hμ
  have := hh'.isProbabilityMeasure
  have hX : Measurable fun ω => planeTestPairings (hC ω) :=
    measurable_pi_iff.2 fun φ => hh'.measurable_pairing φ.1 φ.2
  have hY : Measurable fun q : ℂ × Ω => fun φ : PlaneTest =>
      hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1 :=
    measurable_pi_iff.2 fun φ => ((hh'.measurable_pairing φ.1 φ.2).comp measurable_snd).add
      (((LatticeProb.Gauss.measurable_integral_mul_wholePlaneCov φ.2).comp measurable_fst).const_mul γ)
  obtain ⟨hwm, hwfin⟩ := hh'.restrict_ball_total_mass hγ0 hγ2 hμ' (φ := Fin.elim0) (fun i => i.elim0)
  simp only [Measure.restrict_apply_univ] at hwm hwfin
  have : IsFiniteMeasure (P.withDensity fun ω => μ ω (ball 0 1)) := isFiniteMeasure_withDensity hwfin
  have hcyl : ∀ s ∈ measurableCylinders (fun _ : PlaneTest => ℝ),
      (P.withDensity fun ω => μ ω (ball 0 1)).map (fun ω => planeTestPairings (hC ω)) s =
        ((volume.restrict (ball (0 : ℂ) 1)).prod P).map
          (fun q : ℂ × Ω => fun φ : PlaneTest => hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1) s := by
    intro s hs
    have hsm : MeasurableSet s := .of_mem_measurableCylinders hs
    obtain ⟨I, B, hB, rfl⟩ := (mem_measurableCylinders _).1 hs
    let e := I.equivFin
    have hind : ∀ x : PlaneTest → ℝ,
        B.indicator (1 : (I → ℝ) → ℝ≥0∞) (fun i : I => x (e.symm (e i))) = (cylinder I B).indicator 1 x := by
      intro x
      simp only [Equiv.symm_apply_apply]
      by_cases hx : (fun i : I => x i) ∈ B
      · rw [Set.indicator_of_mem hx, Set.indicator_of_mem ((mem_cylinder _ _ _).2 hx), Pi.one_apply,
          Pi.one_apply]
      · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem fun h => hx ((mem_cylinder _ _ _).1 h)]
    have hfm : Measurable fun p : ℂ × (Fin I.card → ℝ) => B.indicator (1 : (I → ℝ) → ℝ≥0∞)
        (fun i : I => p.2 (e i)) :=
      (measurable_one.indicator hB).comp
        ((measurable_pi_iff.2 fun i => measurable_pi_apply (e i)).comp measurable_snd)
    have key := hh'.lintegral_lqgMeasure_marked_fun_eq hγ0 hγ2 hμ' (φ := fun k => (e.symm k).1.1)
      (fun k => (e.symm k).1.2) hfm
    have hgm : Measurable ((cylinder I B).indicator (1 : (PlaneTest → ℝ) → ℝ≥0∞)) :=
      measurable_one.indicator hsm
    calc _ = ∫⁻ ω, ∫⁻ z in ball (0 : ℂ) 1, B.indicator (1 : (I → ℝ) → ℝ≥0∞)
            (fun i : I => hC ω (e.symm (e i)).1.1) ∂(μ ω) ∂P := by
          rw [← lintegral_indicator_one hsm, lintegral_map hgm hX,
            lintegral_withDensity_eq_lintegral_mul₀ hwm (show AEMeasurable
              (fun ω => (cylinder I B).indicator (1 : (PlaneTest → ℝ) → ℝ≥0∞) (planeTestPairings (hC ω))) P
              from (hgm.comp hX).aemeasurable)]
          refine lintegral_congr fun ω => ?_
          show μ ω (ball 0 1) * (cylinder I B).indicator 1 (planeTestPairings (hC ω)) = _
          rw [lintegral_const, Measure.restrict_apply_univ, mul_comm (μ ω (ball 0 1))]
          exact congrArg (· * μ ω (ball 0 1)) (hind (planeTestPairings (hC ω))).symm
      _ = ∫⁻ z in ball (0 : ℂ) 1, ∫⁻ ω, B.indicator (1 : (I → ℝ) → ℝ≥0∞)
            (fun i : I => hC ω (e.symm (e i)).1.1 +
              γ * ∫ x, (e.symm (e i)).1.1 x * LatticeProb.Gauss.wholePlaneCov x z) ∂P := key.2
      _ = _ := by
          rw [← lintegral_indicator_one hsm, lintegral_map hgm hY,
            lintegral_prod _ (show AEMeasurable (fun q : ℂ × Ω =>
              (cylinder I B).indicator (1 : (PlaneTest → ℝ) → ℝ≥0∞) fun φ : PlaneTest =>
                hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1) ((volume.restrict (ball (0 : ℂ) 1)).prod P)
              from (hgm.comp hY).aemeasurable)]
          exact lintegral_congr fun z => lintegral_congr fun ω =>
            hind fun φ : PlaneTest => hC ω φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x z
  exact ext_of_generate_finite _ generateFrom_measurableCylinders.symm
    isPiSystem_measurableCylinders hcyl (hcyl _ (univ_mem_measurableCylinders _))

/-- **The rooted law of the field, for bounded observables.** For every bounded `F` measurable for the
σ-algebra generated by the pairings with test functions,
`E [μ_h(B_1) F(h)] = ∫_{B_1} E [F(h + γ ∫ Cov(·, z))] dz`. -/
theorem integral_lqgMass_mul_eq (hh : IsWholePlaneGFF P hC hcirc) {γ : ℝ} (hγ0 : 0 < γ) (hγ2 : γ < 2)
    {μ : Ω → Measure ℂ} (hμ : IsLQGMeasureOfField P γ 0 hcirc μ) {F : ((ℂ → ℝ) → ℝ) → ℝ}
    (hF : Measurable[pairingSigmaAlgebra (fun T : (ℂ → ℝ) → ℝ => T) univ] F)
    (hFb : ∃ C : ℝ, ∀ T, |F T| ≤ C) :
    ∫ ω, (μ ω (ball 0 1)).toReal * F (hC ω) ∂P =
      ∫ z in ball (0 : ℂ) 1, ∫ ω, F (fun φ => hC ω φ + γ * ∫ x, φ x * wholePlaneCov x z) ∂P := by
  have hh' := (LPBridge.isWholePlaneGFF_iff P hC hcirc).1 hh
  have hμ' := isLQGMeasure_of_isLQGMeasureOfField_zero hμ
  have := hh'.isProbabilityMeasure
  obtain ⟨C, hFC⟩ := hFb
  obtain ⟨G, hG, rfl⟩ := (hF.mono pairingSigmaAlgebra_univ_le_comap le_rfl).exists_eq_measurable_comp
  have hX : Measurable fun ω => planeTestPairings (hC ω) :=
    measurable_pi_iff.2 fun φ => hh'.measurable_pairing φ.1 φ.2
  have hY : Measurable fun q : ℂ × Ω => fun φ : PlaneTest =>
      hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1 :=
    measurable_pi_iff.2 fun φ => ((hh'.measurable_pairing φ.1 φ.2).comp measurable_snd).add
      (((LatticeProb.Gauss.measurable_integral_mul_wholePlaneCov φ.2).comp measurable_fst).const_mul γ)
  obtain ⟨hwm, hwfin⟩ := hh'.restrict_ball_total_mass hγ0 hγ2 hμ' (φ := Fin.elim0) (fun i => i.elim0)
  simp only [Measure.restrict_apply_univ] at hwm hwfin
  have : IsFiniteMeasure (volume.restrict (ball (0 : ℂ) 1)) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact measure_ball_lt_top⟩
  have hint : Integrable (fun q : ℂ × Ω => G fun φ : PlaneTest =>
      hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1) ((volume.restrict (ball (0 : ℂ) 1)).prod P) :=
    Integrable.of_bound (hG.comp hY).aestronglyMeasurable C
      (Filter.Eventually.of_forall fun q => by
        rw [Real.norm_eq_abs]
        exact hFC fun φ => hC q.2 φ + γ * ∫ x, φ x * wholePlaneCov x q.1)
  calc ∫ ω, (μ ω (ball 0 1)).toReal * (G ∘ planeTestPairings) (hC ω) ∂P
      = ∫ ω, G (planeTestPairings (hC ω)) ∂(P.withDensity fun ω => μ ω (ball 0 1)) := by
        rw [integral_withDensity_eq_integral_toReal_smul₀ hwm (ae_lt_top' hwm hwfin)]
        rfl
    _ = ∫ x, G x ∂((P.withDensity fun ω => μ ω (ball 0 1)).map fun ω => planeTestPairings (hC ω)) :=
        (integral_map hX.aemeasurable hG.aestronglyMeasurable).symm
    _ = ∫ x, G x ∂(((volume.restrict (ball (0 : ℂ) 1)).prod P).map fun q : ℂ × Ω => fun φ : PlaneTest =>
          hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1) := by
        rw [hh.map_withDensity_lqgMass_eq hγ0 hγ2 hμ]
    _ = ∫ q, G (fun φ : PlaneTest => hC q.2 φ.1 + γ * ∫ x, φ.1 x * wholePlaneCov x q.1)
          ∂((volume.restrict (ball (0 : ℂ) 1)).prod P) :=
        integral_map hY.aemeasurable hG.aestronglyMeasurable
    _ = _ := integral_prod _ hint

end IsWholePlaneGFF

/-- **Duplantier-Miller-Sheffield, Lemma A.10, whole-plane clause, unnormalized form, for `D = B_1`.**
For every whole-plane GFF `(P, hC, hcirc)` and every `γ`-LQG measure `μ` of it with `γ ∈ (0, 2)`, the measure
`μ_h(B_1) dP(h)` on fields is the image of Lebesgue measure on `B_1` times `P` under the sampling procedure
`(z, h) ↦ h + f_z + κ`, tested against every bounded measurable observable of the whole field. -/
theorem dmsLemmaA10WholePlaneUnnormalized_holds {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {γ : ℝ}
    (hγ0 : 0 < γ) (hγ2 : γ < 2) (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ) :
    DMSLemmaA10WholePlaneUnnormalized P γ hC hcirc μ := by
  intro hh hμ F hF hFb
  rw [hh.integral_lqgMass_mul_eq hγ0 hγ2 hμ hF hFb]
  have hh' := (LPBridge.isWholePlaneGFF_iff P hC hcirc).1 hh
  refine setIntegral_congr_fun measurableSet_ball fun z hz => integral_congr_ae ?_
  filter_upwards [hh'.ae_circleAverage_one_zero] with ω hω
  rw [hω, dmsShiftedPairing_zero_eq γ (mem_ball_zero_iff.1 hz)]

end HarmonicBalls
