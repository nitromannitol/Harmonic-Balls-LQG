import HarmonicBalls.Proofs.GFF.PfefferSourceDistanceMeasurable

/-! # Weyl scaling identities for Pfeffer weak LQG metrics

Let `𝔇` be a weak LQG metric in the sense of Pfeffer (`IsPfefferWeakLQGMetric`), `h^ℂ` a whole-plane GFF, `f` a random
continuous function with measurable point evaluations and `g` a deterministic continuous function. Axiom III, applied
to the field `h = h^ℂ + f`, gives almost surely `D_{h + g} = e^{ξ g} · D_h`, where `h + g` is the pairing functional
`addFunPairing (h^ℂ + f) g`. The field `h^ℂ + (f + g)` (`pfefferField hC (f + g)`) agrees with it on every test
function, and the point distances of `𝔇` are measurable for the σ-algebra generated by the test pairings. Hence
`D_{h^ℂ + (f + g)}` and `D_{(h^ℂ + f) + g}` coincide at every pair of points, and almost surely

`D_{h^ℂ + (f + g)}(x, y) = (e^{ξ g} · D_{h^ℂ + f})(x, y)` for all `x, y`.

For `g(z) = ‖z‖²` this is the Weyl scaling relation between `D = D_{h^ℂ + f}` and `E = D_{h^ℂ + f + ‖·‖²}` in the
simultaneous crossing bounds with random-shift normalizations; those bounds are restated here with that relation, the
distance measurability and `ξ > 0` supplied by `IsPfefferWeakLQGMetric`.
-/

namespace HarmonicBalls

open MeasureTheory
open scoped ENNReal

/-- A real function of pairing functionals that is measurable for `distributionMeasurableSpace` takes equal values on
two pairing functionals that agree on every test function. -/
theorem eq_of_measurable_distributionMeasurableSpace {Ψ : ((ℂ → ℝ) → ℝ) → ℝ}
    (hΨ : Measurable[distributionMeasurableSpace] Ψ) {T T' : (ℂ → ℝ) → ℝ}
    (h : ∀ φ : ℂ → ℝ, IsTestFunction Set.univ φ → T φ = T' φ) : Ψ T = Ψ T' := by
  let m : MeasurableSpace ((ℂ → ℝ) → ℝ) :=
    { MeasurableSet' := fun A => (T ∈ A ↔ T' ∈ A)
      measurableSet_empty := Iff.rfl
      measurableSet_compl := fun _ hA => not_congr hA
      measurableSet_iUnion := fun A hA => by
        simp only [Set.mem_iUnion]
        exact exists_congr hA }
  have hle : distributionMeasurableSpace ≤ m := by
    refine iSup₂_le fun φ hφ => ?_
    rintro A ⟨B, -, rfl⟩
    change T φ ∈ B ↔ T' φ ∈ B
    rw [h φ hφ]
  have hmem : T ∈ Ψ ⁻¹' {Ψ T} ↔ T' ∈ Ψ ⁻¹' {Ψ T} := hle _ (hΨ (measurableSet_singleton (Ψ T)))
  exact (hmem.1 rfl).symm

/-- On a test function, the pairing of `(h^ℂ + f) + g` equals the pairing of `h^ℂ + (f + g)` for continuous `f` and
`g`. -/
theorem addFunPairing_pfefferField_apply_of_isTestFunction {Ω : Type*} {hC : Ω → (ℂ → ℝ) → ℝ}
    {f : Ω → ℂ → ℝ} {ω : Ω} (hf : Continuous (f ω)) {g : ℂ → ℝ} (hg : Continuous g)
    {φ : ℂ → ℝ} (hφ : IsTestFunction Set.univ φ) :
    addFunPairing (pfefferField hC f ω) g φ = pfefferField hC (fun ω z => f ω z + g z) ω φ := by
  have hφc : Continuous φ := hφ.1.continuous
  have h1 : Integrable fun x => f ω x * φ x :=
    (hf.mul hφc).integrable_of_hasCompactSupport hφ.2.1.mul_left
  have h2 : Integrable fun x => g x * φ x :=
    (hg.mul hφc).integrable_of_hasCompactSupport hφ.2.1.mul_left
  change hC ω φ + (∫ x, f ω x * φ x) + ∫ x, g x * φ x = hC ω φ + ∫ x, (f ω x + g x) * φ x
  simp only [add_mul]
  rw [integral_add h1 h2, add_assoc]

/-- Axiom III of a weak LQG metric for the field `h^ℂ + (f + g)`: for a whole-plane GFF `h^ℂ`, a random continuous
function `f` with measurable point evaluations and a deterministic continuous `g`, almost surely
`D_{h^ℂ + (f + g)}(x, y) = (e^{ξ g} · D_{h^ℂ + f})(x, y)` for all `x, y`. -/
theorem IsPfefferWeakLQGMetric.ae_ofReal_pfefferField_add_eq_weylScaling {ξ : ℝ}
    {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} (h𝔇 : IsPfefferWeakLQGMetric ξ 𝔇)
    {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hgff : IsWholePlaneGFF P hC hcirc)
    {f : Ω → ℂ → ℝ} (hfcont : ∀ ω, Continuous (f ω)) (hfmeas : ∀ z, Measurable fun ω => f ω z)
    {g : ℂ → ℝ} (hg : Continuous g) :
    ∀ᵐ ω ∂P, ∀ x y, ENNReal.ofReal (𝔇 (pfefferField hC (fun ω z => f ω z + g z) ω) x y) =
      weylScaling (𝔇 (pfefferField hC f ω)) ξ g x y := by
  filter_upwards [(h𝔇.2.2 Ω P hC hcirc f hgff hfcont hfmeas).2.2.2.1 g hg] with ω hω x y
  rw [← hω x y, eq_of_measurable_distributionMeasurableSpace (h𝔇.2.1 x y)
    fun φ hφ => addFunPairing_pfefferField_apply_of_isTestFunction (hfcont ω) hg hφ]

/-- Weyl scaling between a random continuous shift `f` and `g = f + q` for a deterministic continuous `q`: almost
surely `D_{h^ℂ + g}(x, y) = (e^{ξ q} · D_{h^ℂ + f})(x, y)` for all `x, y`. -/
theorem IsPfefferWeakLQGMetric.ae_ofReal_pfefferField_eq_weylScaling_of_eq_add {ξ : ℝ}
    {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} (h𝔇 : IsPfefferWeakLQGMetric ξ 𝔇)
    {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hgff : IsWholePlaneGFF P hC hcirc)
    {f g : Ω → ℂ → ℝ} (hfcont : ∀ ω, Continuous (f ω)) (hfmeas : ∀ z, Measurable fun ω => f ω z)
    {q : ℂ → ℝ} (hq : Continuous q) (hgf : ∀ ω z, g ω z = f ω z + q z) :
    ∀ᵐ ω ∂P, ∀ x y, ENNReal.ofReal (𝔇 (pfefferField hC g ω) x y) =
      weylScaling (𝔇 (pfefferField hC f ω)) ξ q x y := by
  obtain rfl : g = fun ω z => f ω z + q z := funext fun ω => funext (hgf ω)
  exact h𝔇.ae_ofReal_pfefferField_add_eq_weylScaling hgff hfcont hfmeas hq

/-- The quadratic Weyl scaling relation: for `g = f + ‖·‖²`, almost surely
`D_{h^ℂ + g}(x, y) = (e^{ξ ‖·‖²} · D_{h^ℂ + f})(x, y)` for all `x, y`. -/
theorem IsPfefferWeakLQGMetric.ae_ofReal_pfefferField_eq_weylScaling_normSq {ξ : ℝ}
    {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} (h𝔇 : IsPfefferWeakLQGMetric ξ 𝔇)
    {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hgff : IsWholePlaneGFF P hC hcirc)
    {f g : Ω → ℂ → ℝ} (hfcont : ∀ ω, Continuous (f ω)) (hfmeas : ∀ z, Measurable fun ω => f ω z)
    (hgf : ∀ ω z, g ω z = f ω z + ‖z‖ ^ 2) :
    ∀ᵐ ω ∂P, ∀ x y, ENNReal.ofReal (𝔇 (pfefferField hC g ω) x y) =
      weylScaling (𝔇 (pfefferField hC f ω)) ξ (fun z => ‖z‖ ^ 2) x y :=
  h𝔇.ae_ofReal_pfefferField_eq_weylScaling_of_eq_add hgff hfcont hfmeas (continuous_norm.pow 2) hgf

/-- Simultaneous crossing bounds with random continuous shift normalizations for the distances
`D = D_{h^ℂ + f}` and `E = D_{h^ℂ + g}`, `g = f + ‖·‖²`, of a weak LQG metric. -/
theorem IsPfefferWeakLQGMetric.quadraticCrossingFamily_simultaneous_random_pfefferNormalization {ξ : ℝ}
    {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} (h𝔇 : IsPfefferWeakLQGMetric ξ 𝔇)
    {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {c d : ℝ → ℝ}
    {f g : Ω → ℂ → ℝ}
    (hgff : IsWholePlaneGFF P hC hcirc)
    (hfcont : ∀ ω, Continuous (f ω)) (hfmeas : ∀ z, Measurable (fun ω => f ω z))
    (hgf : ∀ ω z, g ω z = f ω z + ‖z‖ ^ 2)
    (hD : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (𝔇 (pfefferField hC f ω)))
    (hE : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (𝔇 (pfefferField hC g ω)))
    (htight : ∀ i, PfefferTightAcrossScales P (quadraticCrossingFamily
      (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
      (pfefferNormalization ξ hcirc f c)
      (pfefferNormalization ξ hcirc g d) i))
    {ε : ℝ} (hε : 0 < ε) (hε1 : ε < 1) :
    ∃ M : Fin 4 → ℝ, (∀ i, 0 < M i) ∧ ∀ r, 0 < r →
      ENNReal.ofReal (1 - ε) ≤ P {ω |
        (∀ i, ENNReal.ofReal (M i)⁻¹ ≤ quadraticCrossingFamily
            (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
            (pfefferNormalization ξ hcirc f c)
            (pfefferNormalization ξ hcirc g d) i r ω ∧
          quadraticCrossingFamily
            (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
            (pfefferNormalization ξ hcirc f c)
            (pfefferNormalization ξ hcirc g d) i r ω ≤
            ENNReal.ofReal (M i)) ∧
        ENNReal.ofReal (Real.exp (ξ * ((19 / 10 : ℝ) * r) ^ 2)) *
          pfefferAcross (𝔇 (pfefferField hC f ω)) 0 ((19 / 10 : ℝ) * r) (2 * r) ≤
          pfefferAcross (𝔇 (pfefferField hC g ω)) 0 r (2 * r) ∧
        pfefferAcross (𝔇 (pfefferField hC g ω)) 0 r ((11 / 10 : ℝ) * r) ≤
          ENNReal.ofReal (Real.exp (ξ * ((11 / 10 : ℝ) * r) ^ 2)) *
            pfefferAcross (𝔇 (pfefferField hC f ω)) 0 (r / 2) ((6 / 5 : ℝ) * r)} := by
  have hgcont : ∀ ω, Continuous (g ω) := fun ω => by
    rw [show g ω = fun z => f ω z + ‖z‖ ^ 2 from funext (hgf ω)]
    exact (hfcont ω).add (continuous_norm.pow 2)
  have hgmeas : ∀ z, Measurable fun ω => g ω z := fun z => by
    rw [show (fun ω => g ω z) = fun ω => f ω z + ‖z‖ ^ 2 from funext fun ω => hgf ω z]
    exact (hfmeas z).add_const _
  exact hgff.quadraticCrossingFamily_simultaneous_random_pfefferNormalization_of_measurable_distance hfcont hfmeas
    hgcont hgmeas h𝔇.2.1 h𝔇.1 hD hE (h𝔇.ae_ofReal_pfefferField_eq_weylScaling_normSq hgff hfcont hfmeas hgf)
    htight hε hε1

/-- Simultaneous crossing-ratio bounds with random continuous shift normalizations for the distances
`D = D_{h^ℂ + f}` and `E = D_{h^ℂ + g}`, `g = f + ‖·‖²`, of a weak LQG metric. -/
theorem IsPfefferWeakLQGMetric.quadraticCrossingFamily_ratio_simultaneous_random_pfefferNormalization {ξ : ℝ}
    {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} (h𝔇 : IsPfefferWeakLQGMetric ξ 𝔇)
    {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P]
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {c d : ℝ → ℝ}
    {f g : Ω → ℂ → ℝ}
    (hgff : IsWholePlaneGFF P hC hcirc)
    (hfcont : ∀ ω, Continuous (f ω)) (hfmeas : ∀ z, Measurable (fun ω => f ω z))
    (hgf : ∀ ω z, g ω z = f ω z + ‖z‖ ^ 2)
    (hc : ∀ r, 0 < r → 0 < c r) (hd : ∀ r, 0 < r → 0 < d r)
    (hD : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (𝔇 (pfefferField hC f ω)))
    (hE : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (𝔇 (pfefferField hC g ω)))
    (htight : ∀ i, PfefferTightAcrossScales P (quadraticCrossingFamily
      (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
      (pfefferNormalization ξ hcirc f c)
      (pfefferNormalization ξ hcirc g d) i))
    {ε : ℝ} (hε : 0 < ε) (hε1 : ε < 1) :
    ∃ M : Fin 4 → ℝ, (∀ i, 0 < M i) ∧ ∀ r, 0 < r →
      ENNReal.ofReal (1 - ε) ≤ P {ω |
        ENNReal.ofReal (Real.exp ((12 / 5 : ℝ) * ξ * r ^ 2)) *
            (ENNReal.ofReal (M 0)⁻¹ / ENNReal.ofReal (M 1)) ≤
          quadraticCrossingFamily
              (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
              (pfefferNormalization ξ hcirc f c)
              (pfefferNormalization ξ hcirc g d) 2 r ω /
            quadraticCrossingFamily
              (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
              (pfefferNormalization ξ hcirc f c)
              (pfefferNormalization ξ hcirc g d) 3 r ω ∧
        quadraticCrossingFamily
              (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
              (pfefferNormalization ξ hcirc f c)
              (pfefferNormalization ξ hcirc g d) 2 r ω /
            quadraticCrossingFamily
              (fun ω => 𝔇 (pfefferField hC f ω)) (fun ω => 𝔇 (pfefferField hC g ω))
              (pfefferNormalization ξ hcirc f c)
              (pfefferNormalization ξ hcirc g d) 3 r ω ≤
          ENNReal.ofReal (M 2) / ENNReal.ofReal (M 3)⁻¹} := by
  have hgcont : ∀ ω, Continuous (g ω) := fun ω => by
    rw [show g ω = fun z => f ω z + ‖z‖ ^ 2 from funext (hgf ω)]
    exact (hfcont ω).add (continuous_norm.pow 2)
  have hgmeas : ∀ z, Measurable fun ω => g ω z := fun z => by
    rw [show (fun ω => g ω z) = fun ω => f ω z + ‖z‖ ^ 2 from funext fun ω => hgf ω z]
    exact (hfmeas z).add_const _
  exact hgff.quadraticCrossingFamily_ratio_simultaneous_random_pfefferNormalization_of_measurable_distance hfcont
    hfmeas hgcont hgmeas h𝔇.2.1 hc hd h𝔇.1 hD hE
    (h𝔇.ae_ofReal_pfefferField_eq_weylScaling_normSq hgff hfcont hfmeas hgf) htight hε hε1

end HarmonicBalls
