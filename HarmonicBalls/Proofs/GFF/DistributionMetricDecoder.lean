import HarmonicBalls.Proofs.GFF.DistMetricPairingPullback
import LatticeProb.Bonanno.LQGMetric.Prob.CondLaw
import LatticeProb.Bonanno.LQGMetric.Field.GFFInvariance

/-! # A Borel metric assignment on distributions from a metric assignment on pairing functionals

A continuous metric on `ℂ` is determined by its values along the dense sequence
`TopologicalSpace.denseSeq (ℂ × ℂ)`. The space `LQGMetric.ContMetric` of continuous metrics is
standard Borel (`LQGMetric.standardBorelSpace_contMetric`), so the injective measurable sampling
map `contMetricSample` is a measurable embedding (Lusin-Souslin) and has the measurable left
inverse `contMetricOfSample`.

Composing with the pairing functional of a distribution, a map `𝔇` on pairing functionals whose
evaluations are measurable for the σ-algebra of test-function evaluations induces a Borel map
`distributionMetric 𝔇 : DistC → ContMetric`, equal to `𝔇` at every distribution where `𝔇` is a
continuous metric. This is the measurability part of the comparison of the γ-LQG metrics of
`IsLQGMetric` with the strong γ-LQG metrics of Gwynne-Miller 2021 (Section 1.2, p. 6). -/

noncomputable section

open MeasureTheory

namespace HarmonicBalls

/-- The pairing functional of a distribution is measurable for the σ-algebra generated by the
pairings with test functions. -/
theorem measurable_distributionPairingExtension :
    Measurable[inferInstance, distributionMeasurableSpace] distributionPairingExtension := by
  rw [measurable_iff_comap_le, distributionMeasurableSpace, MeasurableSpace.comap_iSup]
  refine iSup_le fun φ => ?_
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun hφ => ?_
  rw [MeasurableSpace.comap_comp]
  have he : (fun T : (ℂ → ℝ) → ℝ => T φ) ∘ distributionPairingExtension =
      fun T : LQGMetric.DistC => T ⟨φ, hφ.1, hφ.2.1, hφ.2.2⟩ := by
    funext T
    simp only [Function.comp_apply, distributionPairingExtension, hφ, ↓reduceDIte]
  rw [he]
  exact (LQGMetric.GFFInv.measurable_pair _).comap_le

/-- The values of a continuous metric along the dense sequence of `ℂ × ℂ`. -/
def contMetricSample (d : LQGMetric.ContMetric) : ℕ → ℝ :=
  fun n => d.1 (TopologicalSpace.denseSeq (ℂ × ℂ) n)

theorem measurable_contMetricSample : Measurable contMetricSample :=
  measurable_pi_iff.2 fun n =>
    (ContinuousMap.measurable_eval (TopologicalSpace.denseSeq (ℂ × ℂ) n)).comp
      measurable_subtype_coe

/-- A continuous metric is determined by its values along the dense sequence. -/
theorem contMetricSample_injective : Function.Injective contMetricSample := by
  intro d d' h
  apply Subtype.ext
  apply ContinuousMap.ext
  intro p
  have := (TopologicalSpace.denseRange_denseSeq (ℂ × ℂ)).equalizer d.1.continuous
    d'.1.continuous (funext fun n => congrFun h n)
  exact congrFun this p

theorem measurableEmbedding_contMetricSample : MeasurableEmbedding contMetricSample :=
  measurable_contMetricSample.measurableEmbedding contMetricSample_injective

/-- The measurable left inverse of `contMetricSample`; the Euclidean metric off its range. -/
def contMetricOfSample (s : ℕ → ℝ) : LQGMetric.ContMetric :=
  Function.extend contMetricSample id (fun _ => LQGMetric.euclidContMetric) s

theorem measurable_contMetricOfSample : Measurable contMetricOfSample :=
  measurableEmbedding_contMetricSample.measurable_extend measurable_id measurable_const

theorem contMetricOfSample_contMetricSample (d : LQGMetric.ContMetric) :
    contMetricOfSample (contMetricSample d) = d :=
  contMetricSample_injective.extend_apply id _ d

/-- The metric assignment on distributions induced by a map `𝔇` on pairing functionals: the
continuous metric with the values of `𝔇` at the pairing functional of `T` along the dense sequence
(the Euclidean metric if there is none). -/
def distributionMetric (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) (T : LQGMetric.DistC) :
    LQGMetric.ContMetric :=
  contMetricOfSample fun n =>
    𝔇 (distributionPairingExtension T) (TopologicalSpace.denseSeq (ℂ × ℂ) n).1
      (TopologicalSpace.denseSeq (ℂ × ℂ) n).2

/-- `distributionMetric 𝔇` is Borel when the evaluations of `𝔇` are measurable for the σ-algebra
of test-function evaluations. -/
theorem measurable_distributionMetric {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}
    (h𝔇 : ∀ z w, Measurable[distributionMeasurableSpace] fun T => 𝔇 T z w) :
    Measurable (distributionMetric 𝔇) :=
  measurable_contMetricOfSample.comp <| measurable_pi_iff.2 fun _ =>
    (h𝔇 _ _).comp measurable_distributionPairingExtension

/-- At a distribution where `𝔇` is a continuous metric, `distributionMetric 𝔇` is that metric. -/
theorem distributionMetric_eq {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} {T : LQGMetric.DistC}
    {d : LQGMetric.ContMetric}
    (hd : ∀ u v, 𝔇 (distributionPairingExtension T) u v = d.1 (u, v)) :
    distributionMetric 𝔇 T = d := by
  have hs : (fun n => 𝔇 (distributionPairingExtension T) (TopologicalSpace.denseSeq (ℂ × ℂ) n).1
      (TopologicalSpace.denseSeq (ℂ × ℂ) n).2) = contMetricSample d :=
    funext fun _ => hd _ _
  rw [distributionMetric, hs, contMetricOfSample_contMetricSample]

/-- The evaluations of `distributionMetric 𝔇` at a distribution where `𝔇` is a continuous metric. -/
theorem distributionMetric_apply_eq {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ} {T : LQGMetric.DistC}
    {d : LQGMetric.ContMetric}
    (hd : ∀ u v, 𝔇 (distributionPairingExtension T) u v = d.1 (u, v)) (u v : ℂ) :
    (distributionMetric 𝔇 T).1 (u, v) = 𝔇 (distributionPairingExtension T) u v := by
  rw [distributionMetric_eq hd, hd]

end HarmonicBalls
