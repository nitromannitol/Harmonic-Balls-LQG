import HarmonicBalls.FirstPass.Phase2.GreenPotentialHolderHolds
import HarmonicBalls.Proofs.Sec8.OriginLiteratureAssembly

/-! # Green-potential regularity and its Section 8 application -/

namespace HarmonicBalls

open MeasureTheory

universe u

/-- Green potentials of bounded densities are almost surely Hölder continuous
on the closures of smooth bounded domains. -/
theorem greenPotentialHolderStmt : GreenPotentialHolderStmt.{u} :=
  greenPotentialHolderStmt_holds.{u}

/-- The origin good-scale statement with Green-potential regularity supplied. -/
theorem originManyGoodScalesStmt_of_literature_greenPotential
    (hDG : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
      WholePlaneLQGBallMassBounds P γ hC hcirc)
    (hatom : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ α : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
      LQGMeasureNonatomic P γ α hC hcirc)
    (hAff : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
      WholePlaneGFFAffineInvariance P hC hcirc)
    (hCC : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ α : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
      LQGMeasureCoordChange P γ α hC hcirc)
    (hex : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
      LQGMeasureExistence P γ 0 hC hcirc)
    (hW : ∀ (Ω : Type u) [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ),
      LQGMeasureWeylScaling P γ 0 hC hcirc) : OriginManyGoodScalesStmt.{u} :=
  originManyGoodScalesStmt_of_literature greenPotentialHolderStmt.{u} hDG hatom hAff hCC hex hW

end HarmonicBalls
