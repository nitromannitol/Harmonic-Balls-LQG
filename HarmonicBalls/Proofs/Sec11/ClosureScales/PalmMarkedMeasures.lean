import Mathlib
import HarmonicBalls.Proofs.Sec11.ClosureScales.PalmPairingMeasurable
import HarmonicBalls.Proofs.Sec11.ClosureScales.PalmSectionMeasurable

/-! # Route (A), Step M: the two marked measures on pairing × ℂ

For the random measure `μ` (through a kernel `κ : Ω → Measure ℂ` whose sections are measurable), the marked measure
of the field is `Lμ = P.bind (ω ↦ (κ ω).map (z ↦ (hC ω, z)))` on `(pairing functionals) × ℂ`, and the shifted-field
measure is `Rμ = ((vol|_{B₁}).prod P).map (z, ω) ↦ (T_z(hC ω), z)` with `T_z(T) = T + ∫ dmsShift_z`. Their lintegral
formulas are the two sides of Step M. The pairing functionals are carried by the type synonym
`PairFun` (instance: the pairing σ-algebra), so that the default product σ-algebra of `(ℂ → ℝ) → ℝ` is not used.
-/

noncomputable section

open MeasureTheory ProbabilityTheory Metric Set
open scoped ENNReal

namespace HarmonicBalls

/-- Pairing functionals `T : (ℂ → ℝ) → ℝ`, with the pairing σ-algebra (generated by the evaluations at test functions). -/
def PairFun : Type := (ℂ → ℝ) → ℝ

instance : MeasurableSpace PairFun := pairingMeasSpace

/-- A pairing functional viewed as an element of the type synonym `PairFun` (so that its type is `PairFun`). -/
def toPairFun (T : (ℂ → ℝ) → ℝ) : PairFun := T

/-- The marked measure of the field: `Lμ = P.bind (ω ↦ (κ ω).map (z ↦ (hC ω, z)))`. -/
def markedLeft {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (κ : Ω → Measure ℂ) : Measure (PairFun × ℂ) :=
  P.bind (fun ω => (κ ω).map (fun z => (toPairFun (hC ω), z)))

/-- The shifted-field measure: `Rμ = ((vol|_{B₁}).prod P).map (z, ω) ↦ (T_z(hC ω), z)` with `T_z(T) = T + ∫ dmsShift_z`. -/
def markedRight {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) :
    Measure (PairFun × ℂ) :=
  ((volume.restrict (ball (0 : ℂ) 1)).prod P).map
    (fun q : ℂ × Ω => (toPairFun (shiftedPairing γ q.1 (hC q.2)), q.1))

/-- The kernel of the marked left measure is measurable as a `Measure`-valued map, once its sections are. -/
theorem measurable_markedKernel {Ω : Type*} [MeasurableSpace Ω] {hC : Ω → (ℂ → ℝ) → ℝ}
    {κ : Ω → Measure ℂ}
    (hκ : ∀ S : Set (PairFun × ℂ), MeasurableSet[MeasurableSpace.prod inferInstance inferInstance] S →
      Measurable fun ω => κ ω {z | (toPairFun (hC ω), z) ∈ S}) :
    Measurable fun ω => (κ ω).map (fun z => (toPairFun (hC ω), z)) := by
  refine Measure.measurable_of_measurable_coe _ fun S hS => ?_
  have hfun : (fun ω => ((κ ω).map (fun z => (toPairFun (hC ω), z))) S) =
      fun ω => κ ω {z | (toPairFun (hC ω), z) ∈ S} := by
    funext ω
    exact Measure.map_apply (measurable_const.prodMk measurable_id) hS
  rw [hfun]
  exact hκ S hS

/-- The lintegral against the marked left measure is the iterated lintegral against the kernel. -/
theorem lintegral_markedLeft {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {hC : Ω → (ℂ → ℝ) → ℝ}
    {κ : Ω → Measure ℂ}
    (hκ : ∀ S : Set (PairFun × ℂ), MeasurableSet[MeasurableSpace.prod inferInstance inferInstance] S →
      Measurable fun ω => κ ω {z | (toPairFun (hC ω), z) ∈ S})
    {Ψ : PairFun × ℂ → ℝ≥0∞} (hΨ : Measurable Ψ) :
    ∫⁻ p, Ψ p ∂(markedLeft P hC κ) = ∫⁻ ω, ∫⁻ z, Ψ (toPairFun (hC ω), z) ∂(κ ω) ∂P := by
  unfold markedLeft
  rw [Measure.lintegral_bind (measurable_markedKernel hκ).aemeasurable hΨ.aemeasurable]
  congr 1
  funext ω
  exact lintegral_map hΨ (measurable_const.prodMk measurable_id)

/-- The shifted-field map is measurable (from the measurability of the shifted pairing). -/
theorem measurable_markedRight_map {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hG : IsWholePlaneGFF P hC hcirc) (γ : ℝ) :
    Measurable fun q : ℂ × Ω => (toPairFun (shiftedPairing γ q.1 (hC q.2)), q.1) :=
  (measurable_shiftedPairing hG γ).prodMk measurable_fst

/-- The lintegral against the shifted-field measure is the integral over the disk of the shifted expectations. -/
theorem lintegral_markedRight {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] (γ : ℝ)
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hG : IsWholePlaneGFF P hC hcirc)
    {Ψ : PairFun × ℂ → ℝ≥0∞} (hΨ : Measurable Ψ) :
    ∫⁻ p, Ψ p ∂(markedRight P γ hC) =
      ∫⁻ z in ball (0 : ℂ) 1, ∫⁻ ω, Ψ (toPairFun (shiftedPairing γ z (hC ω)), z) ∂P ∂volume := by
  unfold markedRight
  rw [lintegral_map hΨ (measurable_markedRight_map hG γ)]
  exact lintegral_prod _ (hΨ.comp (measurable_markedRight_map hG γ)).aemeasurable

end HarmonicBalls

end
