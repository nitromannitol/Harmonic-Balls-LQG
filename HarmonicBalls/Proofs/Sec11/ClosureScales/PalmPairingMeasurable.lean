import Mathlib
import HarmonicBalls.Defs.GFF
import HarmonicBalls.Defs.LQGMetric
import HarmonicBalls.Proposed.DuplantierMillerSheffield

/-! # Route (A), Step M: measurability of the pairing functionals

The pairing σ-algebra `pairingSigmaAlgebra (fun T => T) univ` on `(ℂ → ℝ) → ℝ` is generated by the evaluations at
test functions. A map into it is measurable as soon as its evaluations are (`measurable_pairing_of_eval`). We apply this
to the field `ω ↦ hC ω` and to the shifted pairing `(z, ω) ↦ (φ ↦ hC ω φ + ∫ dmsShift_z φ)`, the DMS shift without its
constant term (the constant term vanishes almost surely on the closed unit disk: `dmsShiftedPairing_ae_eq`).
-/

noncomputable section

open MeasureTheory ProbabilityTheory Metric

namespace HarmonicBalls

/-- The DMS shifted pairing without its constant term: `φ ↦ T φ + ∫ dmsShift_z φ`. -/
def shiftedPairing (γ : ℝ) (z : ℂ) (T : (ℂ → ℝ) → ℝ) : (ℂ → ℝ) → ℝ :=
  fun φ => T φ + ∫ w, dmsShift γ z w * φ w

/-- The pairing σ-algebra on `(ℂ → ℝ) → ℝ`: generated by the evaluations at test functions. -/
abbrev pairingMeasSpace : MeasurableSpace ((ℂ → ℝ) → ℝ) :=
  pairingSigmaAlgebra (fun T : (ℂ → ℝ) → ℝ => T) Set.univ

/-- A map into `(ℂ → ℝ) → ℝ` whose evaluations at test functions are measurable is measurable for the pairing
σ-algebra (which is generated by these evaluations). -/
theorem measurable_pairing_of_eval {α : Type*} [MeasurableSpace α] (f : α → (ℂ → ℝ) → ℝ)
    (hf : ∀ φ : ℂ → ℝ, IsTestFunction Set.univ φ → Measurable fun a => f a φ) :
    @Measurable α ((ℂ → ℝ) → ℝ) _ pairingMeasSpace f := by
  rw [measurable_iff_comap_le]
  unfold pairingMeasSpace pairingSigmaAlgebra
  simp only [MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  refine iSup_le fun φ => iSup_le fun hφ => ?_
  exact measurable_iff_comap_le.1 (hf φ hφ)

/-- The DMS shift integrated against a continuous function is measurable in the centre `z`. -/
theorem measurable_integral_dmsShift (γ : ℝ) {φ : ℂ → ℝ} (hφ : Continuous φ) :
    Measurable fun z : ℂ => ∫ w, dmsShift γ z w * φ w := by
  have h1 : Measurable fun p : ℂ × ℂ => Real.log ‖p.2 - p.1‖ :=
    Real.measurable_log.comp (measurable_norm.comp (measurable_snd.sub measurable_fst))
  have h2 : Measurable fun p : ℂ × ℂ => Real.log (max ‖p.2‖ 1) :=
    Real.measurable_log.comp ((measurable_norm.comp measurable_snd).max measurable_const)
  have hds : Measurable fun p : ℂ × ℂ => dmsShift γ p.1 p.2 :=
    (measurable_const.mul h1).add (measurable_const.mul h2)
  have hH : Measurable fun p : ℂ × ℂ => dmsShift γ p.1 p.2 * φ p.2 :=
    hds.mul (hφ.measurable.comp measurable_snd)
  exact (hH.stronglyMeasurable.integral_prod_right').measurable

/-- The field `ω ↦ hC ω` is measurable for the pairing σ-algebra. -/
theorem measurable_pairing_field {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hG : IsWholePlaneGFF P hC hcirc) :
    @Measurable Ω ((ℂ → ℝ) → ℝ) _ pairingMeasSpace (fun ω => hC ω) :=
  measurable_pairing_of_eval _ fun φ hφ => hG.measurable_pairing φ hφ

/-- The shifted pairing `(z, ω) ↦ (φ ↦ hC ω φ + ∫ dmsShift_z φ)` is measurable for the pairing σ-algebra on
`ℂ × Ω`. -/
theorem measurable_shiftedPairing {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hG : IsWholePlaneGFF P hC hcirc) (γ : ℝ) :
    @Measurable (ℂ × Ω) ((ℂ → ℝ) → ℝ) _ pairingMeasSpace
      (fun p : ℂ × Ω => shiftedPairing γ p.1 (hC p.2)) := by
  refine measurable_pairing_of_eval _ fun φ hφ => ?_
  exact ((hG.measurable_pairing φ hφ).comp measurable_snd).add
    ((measurable_integral_dmsShift γ hφ.1.continuous).comp measurable_fst)

end HarmonicBalls

end
