import HarmonicBalls.Proofs.Sec11.ClosureScales.CircleTestIntegralContinuity
import HarmonicBalls.Proofs.Sec11.ClosureScales.BorelCircleLimitDecoder

/-!
# Borel convergence locus of the circle-test integrals on `C(CircleDomain, ℝ)`

Source. Written argument `notes/sec11-proof/sec11-proof-r10.tex`, lines 1046-1055: for a test function `φ`, the limit
`lim_n ∫ c(2^{-n}, z) φ(z) d²z`, where it exists, is Borel (lines 1054-1055). The countable validity conditions are at lines
1074-1089. This file formalizes the Borel prerequisites of that claim with the committed providers.

Main results.
* `measurableSet_circleTestIntegral_convergence`: the convergence locus `{F | ∃ L, Tendsto (…) atTop (𝓝 L)}` in
  `C(CircleDomain, ℝ)` is Borel.
* `circleTestIntegral_convergence_eq_cauchy`: on `C(CircleDomain, ℝ)` the convergence locus is the Cauchy locus; the
  completeness of `ℝ` enters here.
* `tendsto_limsup_circleTestIntegral_of_mem`: on the convergence locus the sequence tends to its `Filter.limsup`.
* `measurableSet_circleTestIntegral_tendsto_pairing`: on the product `C(CircleDomain, ℝ) × ((ℂ → ℝ) → ℝ)`, the set of
  pairs `(F, T)` for which the sequence tends to `T φ` is measurable.
* `measurableSet_circleTestIntegral_convergence_countable`, `measurableSet_circleTestIntegral_tendsto_pairing_countable`:
  the same sets intersected over a countable family `𝒯` of test functions.

Carrier and conventions. `C(CircleDomain, ℝ)` carries its Borel σ-algebra `ContinuousMap.measurableSpace` (Mathlib, `borel`,
used by `CircleTestIntegralContinuity.lean`). The raw pairing carrier `T : (ℂ → ℝ) → ℝ` carries `pairingMeasSpace`, the
σ-algebra generated by the evaluations at test functions (`PalmPairingMeasurable.lean`). The product carries
`Prod.instMeasurableSpace`. The integrals are against Lebesgue measure on `ℂ`; `IsTestFunction Set.univ φ` is the Defs
predicate of `Defs/Laplacian.lean`. No hypothesis beyond `IsTestFunction` is assumed.

Route. Each term `F ↦ ∫ z, F ⟨(dyadicScale n, z), _⟩ * φ z` is Borel by `measurable_circleTestIntegral_fixed`
(`CircleTestIntegralContinuity.lean`). The locus is Borel by Mathlib's `measurableSet_exists_tendsto`, and the joint set
by Mathlib's `measurableSet_tendsto_fun`, with `T ↦ T φ` Borel for `pairingMeasSpace` by `measurable_pairing_eval`
(`BorelCircleLimitDecoder.lean`). Both Mathlib lemmas are the countable-base limit arguments for a second countable,
pseudometrizable target; they are used as providers, not re-proved.
-/

noncomputable section

open MeasureTheory Set Filter Topology

namespace HarmonicBalls

-- The raw pairing carrier `(ℂ → ℝ) → ℝ` carries `pairingMeasSpace` in this file, as in `FourierFinitenessMeasurable.lean`.
attribute [local instance] pairingMeasSpace

/-- **Borel convergence locus.** For a test function `φ`, the set of profiles `F : C(CircleDomain, ℝ)` for which the
sequence `n ↦ ∫ z, F ⟨(dyadicScale n, z), _⟩ * φ z` converges in `ℝ` is Borel. -/
theorem measurableSet_circleTestIntegral_convergence {φ : ℂ → ℝ} (hφ : IsTestFunction Set.univ φ) :
    MeasurableSet {F : C(CircleDomain, ℝ) | ∃ L : ℝ,
      Tendsto (fun n : ℕ => ∫ z, F ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop (𝓝 L)} :=
  measurableSet_exists_tendsto fun n => measurable_circleTestIntegral_fixed hφ (dyadicScale_pos n)

/-- **Cauchy form of the convergence locus.** Since `ℝ` is complete, a sequence in `ℝ` converges exactly when it is
Cauchy; on `C(CircleDomain, ℝ)` the convergence locus is therefore the set where the sequence is Cauchy. -/
theorem circleTestIntegral_convergence_eq_cauchy {φ : ℂ → ℝ} :
    {F : C(CircleDomain, ℝ) | ∃ L : ℝ,
      Tendsto (fun n : ℕ => ∫ z, F ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop (𝓝 L)} =
    {F : C(CircleDomain, ℝ) |
      CauchySeq (fun n : ℕ => ∫ z, F ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z)} := by
  ext F
  simp only [Set.mem_ofPred_eq]
  exact ⟨fun ⟨_, hL⟩ => hL.cauchySeq, fun h => cauchySeq_tendsto_of_complete h⟩

/-- **Limit on the convergence locus.** At a profile `F` where the sequence converges, the sequence converges to the
literal `Filter.limsup` of the same sequence. -/
theorem tendsto_limsup_circleTestIntegral_of_mem {φ : ℂ → ℝ} :
    ∀ F ∈ {F : C(CircleDomain, ℝ) | ∃ L : ℝ,
      Tendsto (fun n : ℕ => ∫ z, F ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop (𝓝 L)},
      Tendsto (fun n : ℕ => ∫ z, F ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop
        (𝓝 (Filter.limsup (fun n : ℕ => ∫ z, F ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop)) := by
  rintro F ⟨L, hL⟩
  rw [hL.limsup_eq]
  exact hL

/-- **Borel convergence locus on the raw pairing.** For a test function `φ`, the set of pairs `(F, T)` with
`F : C(CircleDomain, ℝ)` and `T : (ℂ → ℝ) → ℝ` (σ-algebra `pairingMeasSpace`) for which the sequence
`n ↦ ∫ z, F ⟨(dyadicScale n, z), _⟩ * φ z` tends to `T φ` is measurable for the product σ-algebra. -/
theorem measurableSet_circleTestIntegral_tendsto_pairing {φ : ℂ → ℝ} (hφ : IsTestFunction Set.univ φ) :
    MeasurableSet {q : C(CircleDomain, ℝ) × ((ℂ → ℝ) → ℝ) |
      Tendsto (fun n : ℕ => ∫ z, q.1 ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop (𝓝 (q.2 φ))} :=
  measurableSet_tendsto_fun
    (f := fun n (q : C(CircleDomain, ℝ) × ((ℂ → ℝ) → ℝ)) => ∫ z, q.1 ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z)
    (g := fun q => q.2 φ)
    (fun n => (measurable_circleTestIntegral_fixed hφ (dyadicScale_pos n)).comp measurable_fst)
    ((measurable_pairing_eval hφ).comp measurable_snd)

/-- **Countable test family, convergence locus.** For a countable set `𝒯` of test functions, the set of profiles
`F` for which the sequence converges for every `φ ∈ 𝒯` is Borel. -/
theorem measurableSet_circleTestIntegral_convergence_countable {𝒯 : Set (ℂ → ℝ)} (h𝒯 : 𝒯.Countable)
    (h𝒯t : ∀ φ ∈ 𝒯, IsTestFunction Set.univ φ) :
    MeasurableSet (⋂ φ ∈ 𝒯, {F : C(CircleDomain, ℝ) | ∃ L : ℝ,
      Tendsto (fun n : ℕ => ∫ z, F ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop (𝓝 L)}) :=
  MeasurableSet.biInter h𝒯 fun φ hφ => measurableSet_circleTestIntegral_convergence (h𝒯t φ hφ)

/-- **Countable test family, raw pairing.** For a countable set `𝒯` of test functions, the set of pairs `(F, T)` for
which the sequence tends to `T φ` for every `φ ∈ 𝒯` is measurable for the product σ-algebra. -/
theorem measurableSet_circleTestIntegral_tendsto_pairing_countable {𝒯 : Set (ℂ → ℝ)} (h𝒯 : 𝒯.Countable)
    (h𝒯t : ∀ φ ∈ 𝒯, IsTestFunction Set.univ φ) :
    MeasurableSet (⋂ φ ∈ 𝒯, {q : C(CircleDomain, ℝ) × ((ℂ → ℝ) → ℝ) |
      Tendsto (fun n : ℕ => ∫ z, q.1 ⟨(dyadicScale n, z), dyadicScale_pos n⟩ * φ z) atTop (𝓝 (q.2 φ))}) :=
  MeasurableSet.biInter h𝒯 fun φ hφ => measurableSet_circleTestIntegral_tendsto_pairing (h𝒯t φ hφ)

end HarmonicBalls

end
