import Mathlib
import HarmonicBalls.Proofs.Sec11.ClosureScales.PalmPairingMeasurable
import HarmonicBalls.Proofs.Sec11.ClosureScales.LQGKernelBorel

/-! # Route (A), Step M: sections of the random LQG measure on pairing × Borel

For `S` measurable in the product of the pairing σ-algebra and the Borel σ-algebra of `ℂ`, the map
`ω ↦ μ_ω {z | (hC ω, z) ∈ S}` is measurable, where `μ_ω` is restricted to the unit disk and taken as zero off the good
set. This is the measurability needed to form the measure `P.bind (ω ↦ (μ_ω).map (z ↦ (hC ω, z)))` of the marked field
in Step M (r10 `l:r9-marked`). The proof is the π-λ induction on measurable rectangles.
-/

noncomputable section

open MeasureTheory ProbabilityTheory Metric Set Filter Topology
open scoped ENNReal

namespace HarmonicBalls

/-- The product σ-algebra is generated by the measurable rectangles. -/
theorem prod_eq_generateFrom_rectangles {X Y : Type*} (m₁ : MeasurableSpace X) (m₂ : MeasurableSpace Y) :
    m₁.prod m₂ = MeasurableSpace.generateFrom
      {S : Set (X × Y) | ∃ A B, MeasurableSet[m₁] A ∧ MeasurableSet[m₂] B ∧ S = A ×ˢ B} := by
  apply le_antisymm
  · refine sup_le ?_ ?_
    · intro s hs
      obtain ⟨t, ht, rfl⟩ := hs
      apply MeasurableSpace.measurableSet_generateFrom
      exact ⟨t, univ, ht, MeasurableSet.univ, by ext x; simp⟩
    · intro s hs
      obtain ⟨t, ht, rfl⟩ := hs
      apply MeasurableSpace.measurableSet_generateFrom
      exact ⟨univ, t, MeasurableSet.univ, ht, by ext x; simp⟩
  · apply MeasurableSpace.generateFrom_le
    rintro S ⟨A, B, hA, hB, rfl⟩
    exact @MeasurableSet.prod X Y m₁ m₂ A B hA hB

/-- For a measurable set `S` of the product of the pairing σ-algebra and the Borel σ-algebra, the sections
`ω ↦ μ_ω {z | (hC ω, z) ∈ S}` of the random measure (restricted to the unit disk) are measurable. -/
theorem measurable_lqg_section {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hC : Ω → (ℂ → ℝ) → ℝ}
    {hcirc : Ω → ℝ → ℂ → ℝ} (hG : IsWholePlaneGFF P hC hcirc) {γ : ℝ} {μ : Ω → Measure ℂ} {G : Set Ω}
    (hGm : MeasurableSet G) {g : ℕ → Ω → ℂ → ℝ} (hgm : ∀ k, Measurable (fun p : Ω × ℂ => g k p.1 p.2))
    (hgN : ∀ k, ∀ ω ∈ G, ∀ z, g k ω z = hcirc ω (dyadicScale k) z)
    (hGgood : ∀ ω ∈ G, IsLQGLimit γ (hcirc ω) (μ ω))
    {S : Set (((ℂ → ℝ) → ℝ) × ℂ)}
    (hS : MeasurableSet[MeasurableSpace.prod pairingMeasSpace inferInstance] S) :
    Measurable fun ω => (G.indicator (fun ω => (μ ω).restrict (ball (0 : ℂ) 1)) ω) {z | (hC ω, z) ∈ S} := by
  let instPair : MeasurableSpace ((ℂ → ℝ) → ℝ) := pairingMeasSpace
  set κ : Ω → Measure ℂ := G.indicator (fun ω => (μ ω).restrict (ball (0 : ℂ) 1)) with hκ_def
  have hκ : Measurable κ := measurable_lqg_kernel hGm hgm hgN hGgood
  have hfin : ∀ ω, κ ω univ ≠ ∞ := by
    intro ω
    by_cases hω : ω ∈ G
    · have hloc : IsLocallyFiniteMeasure (μ ω) := (hGgood ω hω).isLocallyFiniteMeasure
      rw [hκ_def, Set.indicator_of_mem hω, Measure.restrict_apply MeasurableSet.univ, univ_inter]
      exact measure_ball_lt_top.ne
    · rw [hκ_def, Set.indicator_of_notMem hω]
      simp
  have hCm : Measurable (fun ω => hC ω) := measurable_pairing_field hG
  have hsec : ∀ (ω : Ω) (T : Set (((ℂ → ℝ) → ℝ) × ℂ)),
      MeasurableSet[MeasurableSpace.prod pairingMeasSpace inferInstance] T →
      MeasurableSet {z | (hC ω, z) ∈ T} := fun ω T hT => (measurable_const.prodMk measurable_id) hT
  have hκuniv : Measurable fun ω => κ ω univ := (Measure.measurable_coe MeasurableSet.univ).comp hκ
  refine MeasurableSpace.induction_on_inter
    (C := fun T _ => Measurable fun ω => κ ω {z | (hC ω, z) ∈ T})
    (s := {T : Set (((ℂ → ℝ) → ℝ) × ℂ) | ∃ A B, MeasurableSet[pairingMeasSpace] A ∧ MeasurableSet B ∧ T = A ×ˢ B})
    (prod_eq_generateFrom_rectangles pairingMeasSpace inferInstance) ?_ ?_ ?_ ?_ ?_ S hS
  · -- the rectangles form a π-system
    rintro _ ⟨A, B, hA, hB, rfl⟩ _ ⟨A', B', hA', hB', rfl⟩ _
    exact ⟨A ∩ A', B ∩ B', hA.inter hA', hB.inter hB', Set.prod_inter_prod⟩
  · -- the empty set
    simp only [Set.mem_empty_iff_false, Set.ofPred_false, measure_empty]
    exact measurable_const
  · -- measurable rectangles
    rintro T ⟨A, B, hA, hB, rfl⟩
    have hAω : MeasurableSet ((fun ω => hC ω) ⁻¹' A) := hCm hA
    have heq : (fun ω => κ ω {z | (hC ω, z) ∈ A ×ˢ B}) =
        fun ω => ((fun ω => hC ω) ⁻¹' A).indicator (fun _ => (1 : ℝ≥0∞)) ω * κ ω B := by
      funext ω
      by_cases h : hC ω ∈ A
      · have hω : ω ∈ (fun ω => hC ω) ⁻¹' A := h
        rw [Set.indicator_of_mem hω, one_mul]
        congr 1
        ext z
        simp [Set.mem_prod, h]
      · have hω : ω ∉ (fun ω => hC ω) ⁻¹' A := h
        rw [Set.indicator_of_notMem hω, zero_mul]
        have hempty : {z | (hC ω, z) ∈ A ×ˢ B} = ∅ := by
          ext z
          simp [Set.mem_prod, h]
        rw [hempty, measure_empty]
    rw [heq]
    exact (measurable_const.indicator hAω).mul ((Measure.measurable_coe hB).comp hκ)
  · -- complements
    intro T hTm ih
    have hfun : (fun ω => κ ω {z | (hC ω, z) ∈ Tᶜ}) =
        fun ω => κ ω univ - κ ω {z | (hC ω, z) ∈ T} := by
      funext ω
      have hcompl : {z | (hC ω, z) ∈ Tᶜ} = {z | (hC ω, z) ∈ T}ᶜ := by
        ext z
        simp
      rw [hcompl, measure_compl (hsec ω T hTm) (ne_top_of_le_ne_top (hfin ω) (measure_mono (subset_univ _)))]
    rw [hfun]
    exact hκuniv.sub ih
  · -- countable disjoint unions
    intro f hdisj hfm ih
    have hfun : (fun ω => κ ω {z | (hC ω, z) ∈ ⋃ i, f i}) =
        fun ω => ∑' i, κ ω {z | (hC ω, z) ∈ f i} := by
      funext ω
      have hU : {z | (hC ω, z) ∈ ⋃ i, f i} = ⋃ i, {z | (hC ω, z) ∈ f i} := by
        ext z
        simp
      have hdis : Pairwise fun i j : ℕ => Disjoint {z | (hC ω, z) ∈ f i} {z | (hC ω, z) ∈ f j} := fun i j hij =>
        (hdisj hij).preimage (fun z => (hC ω, z))
      rw [hU, measure_iUnion hdis (fun i => hsec ω (f i) (hfm i))]
    rw [hfun]
    exact Measurable.tsum fun i => ih i

end HarmonicBalls

end
