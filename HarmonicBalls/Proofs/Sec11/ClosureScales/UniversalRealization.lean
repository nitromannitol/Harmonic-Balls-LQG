import HarmonicBalls.Defs.GFF

/-!
# A canonical continuous modification of the circle averages

The universal realization of the supplied data transports probabilistic statements proved for usual probability spaces in `Type` to
probability spaces in any universe, through a measurable map into a canonical space of continuous circle-average
profiles.

This file contains the first step. On every whole-plane GFF `(P, hC, hcirc)` there is a measurable map `c` into the
canonical space `CanonicalProfile` of continuous profiles on `J = (0,∞) × ℂ` such that, `P`-almost surely, `c ω`
equals the circle averages `hcirc ω r z` at every `(r, z) ∈ J`. The exceptional null set is removed by a measurable
null superset, and the profile is taken to be zero there. No decoder is needed, because the canonical space is a
subtype of functions on `ℝ × ℂ` and continuity holds by construction.
-/

namespace HarmonicBalls

open MeasureTheory Set Filter Topology ProbabilityTheory

/-- The index set `J = (0,∞) × ℂ` of the circle averages `h_r(z)`, `r > 0`, `z ∈ ℂ`. -/
def circleIndexSet : Set (ℝ × ℂ) := Ioi (0 : ℝ) ×ˢ univ

/-- The canonical space of continuous circle-average profiles on `J`. Its σ-algebra is the subtype σ-algebra of the
product σ-algebra on `ℝ × ℂ → ℝ`, so it is generated by the evaluations at points of `ℝ × ℂ`. -/
abbrev CanonicalProfile : Type := {f : ℝ × ℂ → ℝ // ContinuousOn f circleIndexSet}

/-- The positive-radius part of a family of circle averages: the values for `r > 0` are kept, and the values for
`r ≤ 0` are set to zero, since the circle averages of a whole-plane GFF are unconstrained there. -/
noncomputable def positiveRadiusPart (h : ℝ → ℂ → ℝ) : ℝ × ℂ → ℝ :=
  fun p => if 0 < p.1 then h p.1 p.2 else 0

lemma positiveRadiusPart_eq_of_mem {h : ℝ → ℂ → ℝ} {p : ℝ × ℂ} (hp : p ∈ circleIndexSet) :
    positiveRadiusPart h p = h p.1 p.2 := by
  have h0 : 0 < p.1 := hp.1
  simp only [positiveRadiusPart, h0, ↓reduceIte]

/-- **Canonical continuous modification of the circle averages.** On a whole-plane GFF `(P, hC, hcirc)` there is a
measurable map `c : Ω → CanonicalProfile` such that, `P`-almost surely, `(c ω) p = hcirc ω p.1 p.2` for every
`p ∈ J`. The pairing field `hC` is not involved. -/
theorem IsWholePlaneGFF.exists_measurable_canonicalProfile {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hh : IsWholePlaneGFF P hC hcirc) :
    ∃ c : Ω → CanonicalProfile, Measurable c ∧
      ∀ᵐ ω ∂P, ∀ p ∈ circleIndexSet, (c ω).1 p = hcirc ω p.1 p.2 := by
  classical
  -- A measurable `P`-null set `N` containing every `ω` at which the circle averages are not continuous on `J`.
  obtain ⟨N, hsub, hNmeas, hN0⟩ := exists_measurable_superset_of_null (ae_iff.1 hh.ae_continuousOn_circle)
  -- The modified profile: the positive-radius circle averages off `N`, and zero on `N`.
  let g : Ω → ℝ × ℂ → ℝ := fun ω p => if ω ∈ N then 0 else positiveRadiusPart (hcirc ω) p
  have hg : Measurable g := by
    refine Measurable.of_eval fun p => ?_
    by_cases hp : 0 < p.1
    · have hm : Measurable fun ω => hcirc ω p.1 p.2 := hh.measurable_circle p.1 p.2 hp
      have hfun : (fun ω => g ω p) = fun ω => if ω ∈ N then 0 else hcirc ω p.1 p.2 := by
        funext ω
        simp only [g, positiveRadiusPart, hp, ↓reduceIte]
      rw [hfun]
      exact Measurable.ite hNmeas measurable_const hm
    · have hfun : (fun ω => g ω p) = fun _ => (0 : ℝ) := by
        funext ω
        simp only [g, positiveRadiusPart, hp, ↓reduceIte, ite_self]
      rw [hfun]
      exact measurable_const
  have hcont : ∀ ω, ω ∉ N → ContinuousOn (g ω) circleIndexSet := by
    intro ω hω
    have hc : ContinuousOn (fun p : ℝ × ℂ => hcirc ω p.1 p.2) circleIndexSet := by
      by_contra hbad
      exact hω (hsub hbad)
    refine hc.congr fun p hp => ?_
    simp only [g, hω, ↓reduceIte]
    exact positiveRadiusPart_eq_of_mem hp
  have hcontω : ∀ ω, ContinuousOn (g ω) circleIndexSet := by
    intro ω
    by_cases hω : ω ∈ N
    · simp only [g, hω, ↓reduceIte]
      exact continuousOn_const
    · exact hcont ω hω
  refine ⟨fun ω => ⟨g ω, hcontω ω⟩, ?_, ?_⟩
  · exact Measurable.subtype_mk (p := fun f : ℝ × ℂ → ℝ => ContinuousOn f circleIndexSet) hg
  · have hae : ∀ᵐ ω ∂P, ω ∉ N := by
      refine ae_iff.2 ?_
      simpa using hN0
    filter_upwards [hae] with ω hω
    intro p hp
    show g ω p = hcirc ω p.1 p.2
    simp only [g, hω, ↓reduceIte]
    exact positiveRadiusPart_eq_of_mem hp

end HarmonicBalls
