import Mathlib
import HarmonicBalls.Proofs.Sec11.ClosureScales.PalmMarkedMeasures

/-! # Route (A), Step M: cylinder sets of the pairing σ-algebra and the π-λ uniqueness

The pairing σ-algebra on `PairFun` is generated by the cylinders `{T | (T φ_1, …, T φ_n) ∈ U}` over finitely many test
functions and Borel sets `U ⊆ ℝⁿ`; these cylinders form a π-system. The product σ-algebra on `PairFun × ℂ` is generated
by the rectangles cylinder × Borel. Hence a finite measure on `PairFun × ℂ` is determined by its values on these
rectangles and its total mass (`ext_marked_of_cylinder`): the π-λ step (Extension).
-/

noncomputable section

open MeasureTheory ProbabilityTheory Metric Set
open scoped ENNReal

namespace HarmonicBalls

/-- The cylinder over finitely many test functions `φ i` with values in a Borel set `U ⊆ ℝⁿ`. -/
def cylinder {n : ℕ} (φ : Fin n → ℂ → ℝ) (U : Set (Fin n → ℝ)) : Set PairFun :=
  {T | (fun i => (T : (ℂ → ℝ) → ℝ) (φ i)) ∈ U}

/-- The cylinders over finitely many test functions, with Borel value sets. -/
def cylinderSets : Set (Set PairFun) :=
  {S | ∃ (n : ℕ) (φ : Fin n → ℂ → ℝ) (U : Set (Fin n → ℝ)),
    (∀ i, IsTestFunction Set.univ (φ i)) ∧ MeasurableSet U ∧ S = cylinder φ U}

/-- Each evaluation at a test function is measurable for the pairing σ-algebra. -/
theorem measurable_eval_pairing {φ : ℂ → ℝ} (hφ : IsTestFunction Set.univ φ) :
    Measurable fun T : PairFun => (T : (ℂ → ℝ) → ℝ) φ := by
  refine measurable_iff_comap_le.2 ?_
  show MeasurableSpace.comap _ _ ≤ pairingMeasSpace
  unfold pairingMeasSpace pairingSigmaAlgebra
  exact le_iSup₂ (f := fun φ' (_ : IsTestFunction Set.univ φ') =>
    MeasurableSpace.comap (fun T : (ℂ → ℝ) → ℝ => T φ') inferInstance) φ hφ

/-- Cylinders are measurable for the pairing σ-algebra. -/
theorem measurableSet_cylinder {n : ℕ} {φ : Fin n → ℂ → ℝ} (hφ : ∀ i, IsTestFunction Set.univ (φ i))
    {U : Set (Fin n → ℝ)} (hU : MeasurableSet U) : MeasurableSet (cylinder φ U) := by
  have hm : Measurable fun T : PairFun => fun i => (T : (ℂ → ℝ) → ℝ) (φ i) :=
    Measurable.of_eval fun i => measurable_eval_pairing (hφ i)
  exact hm hU

/-- The cylinders are closed under finite intersections (concatenate the families of test functions). -/
theorem inter_mem_cylinderSets {S S' : Set PairFun} (hS : S ∈ cylinderSets) (hS' : S' ∈ cylinderSets) :
    S ∩ S' ∈ cylinderSets := by
  obtain ⟨n, φ, U, hφ, hU, rfl⟩ := hS
  obtain ⟨m, ψ, V, hψ, hV, rfl⟩ := hS'
  have h1 : Measurable fun x : Fin (n + m) → ℝ => fun i => x (Fin.castAdd m i) :=
    Measurable.of_eval fun i => measurable_pi_apply _
  have h2 : Measurable fun x : Fin (n + m) → ℝ => fun i => x (Fin.natAdd n i) :=
    Measurable.of_eval fun i => measurable_pi_apply _
  refine ⟨n + m, Fin.append φ ψ,
    {x | (fun i => x (Fin.castAdd m i)) ∈ U ∧ (fun i => x (Fin.natAdd n i)) ∈ V}, ?_, ?_, ?_⟩
  · intro i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    · simp only [Fin.append_left]
      exact hφ j
    · simp only [Fin.append_right]
      exact hψ j
  · exact (h1 hU).inter (h2 hV)
  · ext T
    simp only [cylinder, Set.mem_ofPred_eq, Set.mem_inter_iff, Fin.append_left, Fin.append_right]

/-- The cylinders form a π-system. -/
theorem isPiSystem_cylinderSets : IsPiSystem cylinderSets :=
  fun _ hS _ hS' _ => inter_mem_cylinderSets hS hS'

/-- The cylinders generate the pairing σ-algebra. -/
theorem generateFrom_cylinderSets :
    MeasurableSpace.generateFrom cylinderSets = (inferInstance : MeasurableSpace PairFun) := by
  apply le_antisymm
  · apply MeasurableSpace.generateFrom_le
    rintro S ⟨n, φ, U, hφ, hU, rfl⟩
    exact measurableSet_cylinder hφ hU
  · show pairingMeasSpace ≤ _
    unfold pairingMeasSpace pairingSigmaAlgebra
    refine iSup₂_le fun φ hφ => ?_
    have hmeas : Measurable[MeasurableSpace.generateFrom cylinderSets]
        (fun T : PairFun => (T : (ℂ → ℝ) → ℝ) φ) := by
      intro V hV
      apply MeasurableSpace.measurableSet_generateFrom
      exact ⟨1, fun _ => φ, {x | x 0 ∈ V}, fun _ => hφ, measurable_pi_apply 0 hV, rfl⟩
    exact measurable_iff_comap_le.1 hmeas

/-- The whole space is a cylinder (no test functions). -/
theorem univ_mem_cylinderSets : (univ : Set PairFun) ∈ cylinderSets :=
  ⟨0, fun i => i.elim0, univ, fun i => i.elim0, MeasurableSet.univ, rfl⟩

/-- The rectangles cylinder × Borel generate the product σ-algebra of `PairFun × ℂ`. -/
theorem prod_generateFrom_cylinder_borel :
    (inferInstance : MeasurableSpace (PairFun × ℂ)) =
      MeasurableSpace.generateFrom
        {S : Set (PairFun × ℂ) | ∃ A B, A ∈ cylinderSets ∧ MeasurableSet B ∧ S = A ×ˢ B} := by
  let gen : MeasurableSpace (PairFun × ℂ) := MeasurableSpace.generateFrom
    {S : Set (PairFun × ℂ) | ∃ A B, A ∈ cylinderSets ∧ MeasurableSet B ∧ S = A ×ˢ B}
  have hF : ∀ A : Set PairFun, MeasurableSet A → MeasurableSet[gen] (A ×ˢ (univ : Set ℂ)) := by
    intro A hA
    refine MeasurableSpace.induction_on_inter (m := (inferInstance : MeasurableSpace PairFun))
      (C := fun A _ => MeasurableSet[gen] (A ×ˢ (univ : Set ℂ)))
      (s := cylinderSets) generateFrom_cylinderSets.symm isPiSystem_cylinderSets ?_ ?_ ?_ ?_ A hA
    · simp only [Set.empty_prod]
      exact MeasurableSet.empty
    · intro A hA'
      exact MeasurableSpace.measurableSet_generateFrom ⟨A, univ, hA', MeasurableSet.univ, rfl⟩
    · intro A _ ih
      have hc : Aᶜ ×ˢ (univ : Set ℂ) = (A ×ˢ (univ : Set ℂ))ᶜ := by
        ext x
        simp
      rw [hc]
      exact ih.compl
    · intro f _ hfm ih
      have hu : (⋃ i, f i) ×ˢ (univ : Set ℂ) = ⋃ i, f i ×ˢ (univ : Set ℂ) := Set.iUnion_prod_const
      rw [hu]
      exact MeasurableSet.iUnion fun i => ih i
  have hG : ∀ B : Set ℂ, MeasurableSet B → MeasurableSet[gen] ((univ : Set PairFun) ×ˢ B) := by
    intro B hB
    refine MeasurableSpace.induction_on_inter (m := (inferInstance : MeasurableSpace ℂ))
      (C := fun B _ => MeasurableSet[gen] ((univ : Set PairFun) ×ˢ B))
      (s := {B : Set ℂ | IsOpen B}) (BorelSpace.measurable_eq.trans rfl) ?_ ?_ ?_ ?_ ?_ B hB
    · intro s hs t ht _
      have hs' : IsOpen s := hs
      have ht' : IsOpen t := ht
      exact (IsOpen.inter hs' ht' : IsOpen (s ∩ t))
    · simp only [Set.prod_empty]
      exact MeasurableSet.empty
    · intro U hU
      have hU' : IsOpen U := hU
      exact MeasurableSpace.measurableSet_generateFrom
        ⟨univ, U, univ_mem_cylinderSets, hU'.measurableSet, rfl⟩
    · intro B _ ih
      have hc : (univ : Set PairFun) ×ˢ Bᶜ = ((univ : Set PairFun) ×ˢ B)ᶜ := by
        ext x
        simp
      rw [hc]
      exact ih.compl
    · intro f _ hfm ih
      have hu : (univ : Set PairFun) ×ˢ (⋃ i, f i) = ⋃ i, (univ : Set PairFun) ×ˢ f i :=
        Set.prod_iUnion
      rw [hu]
      exact MeasurableSet.iUnion fun i => ih i
  apply le_antisymm
  · refine sup_le ?_ ?_
    · refine measurable_iff_comap_le.1 ?_
      intro A hA
      have hpre : Prod.fst ⁻¹' A = A ×ˢ (univ : Set ℂ) := by
        ext x
        simp
      rw [hpre]
      exact hF A hA
    · refine measurable_iff_comap_le.1 ?_
      intro B hB
      have hpre : Prod.snd ⁻¹' B = (univ : Set PairFun) ×ˢ B := by
        ext x
        simp
      rw [hpre]
      exact hG B hB
  · apply MeasurableSpace.generateFrom_le
    rintro S ⟨A, B, hA, hB, rfl⟩
    obtain ⟨n, φ, U, hφ, hU, rfl⟩ := hA
    exact (measurableSet_cylinder hφ hU).prod hB

/-- Uniqueness of finite measures on `PairFun × ℂ` by their values on cylinder × Borel rectangles and total mass
(the π-λ theorem). -/
theorem ext_marked_of_cylinder {μ ν : Measure (PairFun × ℂ)} [IsFiniteMeasure μ]
    (h : ∀ A ∈ cylinderSets, ∀ B : Set ℂ, MeasurableSet B → μ (A ×ˢ B) = ν (A ×ˢ B))
    (huniv : μ univ = ν univ) : μ = ν := by
  refine ext_of_generate_finite
    {S : Set (PairFun × ℂ) | ∃ A B, A ∈ cylinderSets ∧ MeasurableSet B ∧ S = A ×ˢ B}
    prod_generateFrom_cylinder_borel ?_ ?_ huniv
  · rintro _ ⟨A, B, hA, hB, rfl⟩ _ ⟨A', B', hA', hB', rfl⟩ _
    exact ⟨A ∩ A', B ∩ B', inter_mem_cylinderSets hA hA', hB.inter hB', Set.prod_inter_prod⟩
  · rintro _ ⟨A, B, hA, hB, rfl⟩
    exact h A hA B hB

end HarmonicBalls

end
