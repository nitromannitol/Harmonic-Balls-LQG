import HarmonicBalls.Proofs.Sec11.ConditionalMassDiameterCore
import HarmonicBalls.Proofs.Sec6.AnnulusIteration

/-! # Outside sigma algebra under the logarithmic field shift -/

noncomputable section
open MeasureTheory Filter Set
namespace HarmonicBalls

/-- A deterministic logarithmic insertion does not change the local
sigma algebra generated by zero-integral test pairings. -/
theorem comap_localModConstPairings_log_shift_eq {Ω : Type*}
    (α : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    MeasurableSpace.comap (localModConstPairings α hC U) inferInstance =
      MeasurableSpace.comap (localModConstPairings 0 hC U) inferInstance := by
  rw [← fieldSigmaAlgebraModConst_eq_comap_localModConstPairings,
    ← fieldSigmaAlgebraModConst_eq_comap_localModConstPairings,
    Section6.fieldSigmaAlgebraModConst_eq α hC U]

/-- Conditional expectations with respect to the outside field are
independent of the deterministic logarithmic insertion parameter. -/
theorem condExp_localModConstPairings_log_shift_eq {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (α : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) (f : Ω → ℝ) :
    P[f | MeasurableSpace.comap (localModConstPairings α hC U) inferInstance] =
      P[f | MeasurableSpace.comap (localModConstPairings 0 hC U) inferInstance] := by
  rw [comap_localModConstPairings_log_shift_eq α hC U]

end HarmonicBalls
