import HarmonicBalls.Proofs.Sec11.LQGSingularMetricJointLaw
import HarmonicBalls.Proofs.Sec5.ScalingMeasure

/-! # Joint law of the normalized LQG measure and metric

The metric representation of the normalized field remains explicit. The
whole-plane affine invariance, measure coordinate change and metric axioms
on the mixture are staged inputs pending source checking.
-/

namespace HarmonicBalls
open MeasureTheory ProbabilityTheory

/-- The normalized pullback LQG measure and a singular metric generated by
the same base functional have the original joint law. Identifying that
metric with a normalized dilation of the original metric is a separate step. -/
theorem IsWholePlaneGFF.identDistrib_normalizedPullback_singularMetric
    {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {γ ξ α₀ : ℝ}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    {μ : Ω → Measure ℂ} {D D' : Ω → C(ℂ × ℂ, ℝ)}
    (h : IsWholePlaneGFF P hC hcirc)
    (hAff : WholePlaneGFFAffineInvariance P hC hcirc)
    (hCC : LQGMeasureCoordChange P γ α₀ hC hcirc)
    (hγ : 0 < γ) (hγ₂ : γ < 2) (hα : α₀ < lqgQ γ)
    (hμ : IsLQGMeasureOfField P γ α₀ hcirc μ)
    {k : ℝ} (hk : 0 < k)
    (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) (h𝔇 : IsLQGMetric γ ξ 𝔇)
    (hD : ∀ᵐ ω ∂P, ∀ u v, 0 ≤ D ω (u, v) ∧
      ENNReal.ofReal (D ω (u, v)) =
        weylScaling (𝔇 (hC ω)) ξ (fun x => -α₀ * Real.log ‖x‖) u v)
    (hD' : ∀ᵐ ω ∂P, ∀ u v, 0 ≤ D' ω (u, v) ∧
      ENNReal.ofReal (D' ω (u, v)) =
        weylScaling (𝔇 (affinePairing hC hcirc (k : ℂ) 0 ω)) ξ
          (fun x => -α₀ * Real.log ‖x‖) u v)
    (haxioms : LQGMetricFieldAxioms (mixMeasure.prod (P.prod P)) γ ξ α₀
      (fun x => if x.1 = 0 then hC x.2.1 else affinePairing hC hcirc (k : ℂ) 0 x.2.2)
      (fun x => if x.1 = 0 then hcirc x.2.1 else affineCircle hcirc (k : ℂ) 0 x.2.2)) :
    IdentDistrib (fun ω => (μ ω, D ω))
      (fun ω => (normalizedPullbackMeasure γ α₀ k (hcirc ω) (μ ω), D' ω)) P P := by
  have hGFF' : IsWholePlaneGFF P (affinePairing hC hcirc (k : ℂ) 0)
      (affineCircle hcirc (k : ℂ) 0) :=
    hAff h (k : ℂ) (by exact_mod_cast hk.ne') 0
  have hμ' : IsLQGMeasureOfField P γ α₀ (affineCircle hcirc (k : ℂ) 0)
      (fun ω => normalizedPullbackMeasure γ α₀ k (hcirc ω) (μ ω)) := by
    have hm := isLQGMeasureOfField_normalizedPullback hCC h hγ hγ₂ hα hμ hk
    have hc : affineCircle hcirc (k : ℂ) 0 =
        (fun ω r z => hcirc ω (k * r) (k • z) - hcirc ω k 0) := by
      funext ω r z
      simp [affineCircle, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hk,
        Complex.real_smul]
    rw [hc]
    exact hm
  exact h.identDistrib_lqgMeasure_singularMetric hGFF' hμ hμ' 𝔇 h𝔇 hD hD'
    haxioms hγ hγ₂ hα

#print axioms IsWholePlaneGFF.identDistrib_normalizedPullback_singularMetric

end HarmonicBalls
