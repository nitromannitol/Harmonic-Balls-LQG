import HarmonicBalls.Proofs.Sec11.LQGSingularMetricMixture

/-! # Joint laws of singular LQG metrics and measures

A positive mixture on the product of two probability spaces supplies a common
field decoder, when the same base metric functional realizes both metrics.
-/

namespace HarmonicBalls
open MeasureTheory ProbabilityTheory

/-- Two singular metric realizations generated by the same base metric
functional have a common field-observable version. The metric field axioms
are explicitly assumed on the mixture of the two GFF realizations. -/
theorem IsWholePlaneGFF.exists_common_singularMetric_observable
    {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    {P : Measure Ω} {P' : Measure Ω'} {γ ξ α₀ : ℝ}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    {hC' : Ω' → (ℂ → ℝ) → ℝ} {hcirc' : Ω' → ℝ → ℂ → ℝ}
    {D : Ω → C(ℂ × ℂ, ℝ)} {D' : Ω' → C(ℂ × ℂ, ℝ)}
    (h : IsWholePlaneGFF P hC hcirc) (h' : IsWholePlaneGFF P' hC' hcirc')
    (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) (h𝔇 : IsLQGMetric γ ξ 𝔇)
    (hD : ∀ᵐ ω ∂P, ∀ u v, 0 ≤ D ω (u, v) ∧
      ENNReal.ofReal (D ω (u, v)) =
        weylScaling (𝔇 (hC ω)) ξ (fun x => -α₀ * Real.log ‖x‖) u v)
    (hD' : ∀ᵐ ω ∂P', ∀ u v, 0 ≤ D' ω (u, v) ∧
      ENNReal.ofReal (D' ω (u, v)) =
        weylScaling (𝔇 (hC' ω)) ξ (fun x => -α₀ * Real.log ‖x‖) u v)
    (haxioms : LQGMetricFieldAxioms (mixMeasure.prod (P.prod P')) γ ξ α₀
      (fun x => if x.1 = 0 then hC x.2.1 else hC' x.2.2)
      (fun x => if x.1 = 0 then hcirc x.2.1 else hcirc' x.2.2))
    (hγ : 0 < γ) (hγ₂ : γ < 2) (hα : α₀ < lqgQ γ) :
    ∃ F : (GFFObservable.Admissible → ℝ) → C(ℂ × ℂ, ℝ), Measurable F ∧
      (∀ᵐ ω ∂P, F (fun o => o.1.eval (hC ω) (hcirc ω)) = D ω) ∧
      (∀ᵐ ω ∂P', F (fun o => o.1.eval (hC' ω) (hcirc' ω)) = D' ω) := by
  let _ := h.isProbabilityMeasure
  let _ := h'.isProbabilityMeasure
  let H : ℕ → Ω × Ω' → (ℂ → ℝ) → ℝ :=
    fun k x => if k = 0 then hC x.1 else hC' x.2
  let C : ℕ → Ω × Ω' → ℝ → ℂ → ℝ :=
    fun k x => if k = 0 then hcirc x.1 else hcirc' x.2
  let M : ℕ → Ω × Ω' → C(ℂ × ℂ, ℝ) :=
    fun k x => if k = 0 then D x.1 else D' x.2
  have hH : ∀ k, IsWholePlaneGFF (P.prod P') (H k) (C k) := by
    intro k
    by_cases hk : k = 0
    · simpa only [H, C, hk, ite_true, ite_false, Function.comp_def] using h.comp_measurePreserving (measurePreserving_fst (μ := P) (ν := P'))
    · simpa only [H, C, hk, ite_true, ite_false, Function.comp_def] using h'.comp_measurePreserving (measurePreserving_snd (μ := P) (ν := P'))
  have hM : ∀ k, ∀ᵐ x ∂(P.prod P'), ∀ u v, 0 ≤ M k x (u, v) ∧
      ENNReal.ofReal (M k x (u, v)) =
        weylScaling (𝔇 (H k x)) ξ (fun z => -α₀ * Real.log ‖z‖) u v := by
    intro k
    by_cases hk : k = 0
    · filter_upwards [(measurePreserving_fst (μ := P) (ν := P')).quasiMeasurePreserving.tendsto_ae hD] with x hx
      simpa only [H, M, hk, ite_true, Set.mem_preimage, Set.mem_ofPred_eq] using hx
    · filter_upwards [(measurePreserving_snd (μ := P) (ν := P')).quasiMeasurePreserving.tendsto_ae hD'] with x hx
      simpa only [H, M, hk, ite_false, Set.mem_preimage, Set.mem_ofPred_eq] using hx
  obtain ⟨F, hF, hEq⟩ := exists_common_singularMetric_observable_of_mixture
    H C M 𝔇 hH h𝔇 hM haxioms hγ hγ₂ hα
  refine ⟨F, hF, ?_, ?_⟩
  · have h0 := Measure.ae_ae_of_ae_prod (hEq 0)
    filter_upwards [h0] with ω hω
    obtain ⟨ω', hω'⟩ := hω.exists
    simpa [H, C, M] using hω'
  · have h1 := Measure.ae_ae_of_ae_prod (hEq 1)
    obtain ⟨ω, hω⟩ := h1.exists
    filter_upwards [hω] with ω' hω'
    simpa [H, C, M] using hω'

/-- With a common base metric functional, the singular metric and LQG measure
have a realization-independent joint law under the staged mixture axioms. -/
theorem IsWholePlaneGFF.identDistrib_lqgMeasure_singularMetric
    {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    {P : Measure Ω} {P' : Measure Ω'} {γ ξ α₀ : ℝ}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    {hC' : Ω' → (ℂ → ℝ) → ℝ} {hcirc' : Ω' → ℝ → ℂ → ℝ}
    {μ : Ω → Measure ℂ} {μ' : Ω' → Measure ℂ}
    {D : Ω → C(ℂ × ℂ, ℝ)} {D' : Ω' → C(ℂ × ℂ, ℝ)}
    (h : IsWholePlaneGFF P hC hcirc) (h' : IsWholePlaneGFF P' hC' hcirc')
    (hμ : IsLQGMeasureOfField P γ α₀ hcirc μ)
    (hμ' : IsLQGMeasureOfField P' γ α₀ hcirc' μ')
    (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) (h𝔇 : IsLQGMetric γ ξ 𝔇)
    (hD : ∀ᵐ ω ∂P, ∀ u v, 0 ≤ D ω (u, v) ∧
      ENNReal.ofReal (D ω (u, v)) =
        weylScaling (𝔇 (hC ω)) ξ (fun x => -α₀ * Real.log ‖x‖) u v)
    (hD' : ∀ᵐ ω ∂P', ∀ u v, 0 ≤ D' ω (u, v) ∧
      ENNReal.ofReal (D' ω (u, v)) =
        weylScaling (𝔇 (hC' ω)) ξ (fun x => -α₀ * Real.log ‖x‖) u v)
    (haxioms : LQGMetricFieldAxioms (mixMeasure.prod (P.prod P')) γ ξ α₀
      (fun x => if x.1 = 0 then hC x.2.1 else hC' x.2.2)
      (fun x => if x.1 = 0 then hcirc x.2.1 else hcirc' x.2.2))
    (hγ : 0 < γ) (hγ₂ : γ < 2) (hα : α₀ < lqgQ γ) :
    IdentDistrib (fun ω => (μ ω, D ω)) (fun ω => (μ' ω, D' ω)) P P' := by
  obtain ⟨F, hF, hEq, hEq'⟩ := h.exists_common_singularMetric_observable
    h' 𝔇 h𝔇 hD hD' haxioms hγ hγ₂ hα
  exact h.identDistrib_lqgMeasure_metric_of_common_observable h' hμ hμ' F hF hEq hEq'

#print axioms IsWholePlaneGFF.exists_common_singularMetric_observable
#print axioms IsWholePlaneGFF.identDistrib_lqgMeasure_singularMetric

end HarmonicBalls
