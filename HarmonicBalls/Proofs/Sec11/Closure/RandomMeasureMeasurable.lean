import HarmonicBalls.Proofs.Sec11.Closure.PinchEventTypeZero
import HarmonicBalls.Proofs.Sec6.PotentialRatioAEMeasurable

/-!
# Measurability of the measure-valued LQG field (discharge of `haem`)

A family `μ : Ω → Measure ℂ` whose open-set evaluations `ω ↦ μ ω U` are a.e. measurable, and which is a.s. locally
finite, is a.e. measurable for the Giry σ-algebra of `Measure ℂ` (Mathlib `Measure.instMeasurableSpace`).
Proof: the countable π-system `piQ` of the sets `S ∩ B(0,k)` (`S` a finite intersection of countable-basis sets)
generates the Borel σ-algebra; the Dynkin (π–λ) argument on the balls `B(0,k)` gives the measurability of all
evaluations of the modification `G.indicator μ`, where `G` is a measurable set of full measure on which the countably
many evaluations on `piQ` agree with measurable versions.

Applied to the LQG measure, this discharges `haem` of `PinchEventTypeZero.lean` from the staged input
`LQGMeasureLocality` (Fact 2.1 II, `Proposed/LQG.lean`, pending operator source-check). The original theorem is not
changed. No LatticeProb.Bonanno code is used.
-/

namespace HarmonicBalls

open MeasureTheory Filter Topology Set Metric TopologicalSpace
open scoped ENNReal

namespace RandomMeasureMeasurable

/-- The open ball `B(0, k)` of `ℂ`, `k : ℕ`. -/
def ballK (k : ℕ) : Set ℂ := Metric.ball 0 (k : ℝ)

/-- Finite intersections of countable-basis sets of `ℂ` (the empty intersection is `univ`). -/
def basisInter : Set (Set ℂ) :=
  (fun T : Set (Set ℂ) => ⋂₀ T) '' {T | T.Finite ∧ T ⊆ countableBasis ℂ}

/-- The countable π-system `{S ∩ B(0,k)}` generating the Borel σ-algebra of `ℂ`. -/
def piQ : Set (Set ℂ) :=
  (fun p : Set ℂ × ℕ => p.1 ∩ ballK p.2) '' (basisInter ×ˢ (univ : Set ℕ))

lemma countable_basisInter : basisInter.Countable :=
  (Set.countable_ofPred_finite_subset (countable_countableBasis ℂ)).image _

lemma countable_piQ : piQ.Countable :=
  (countable_basisInter.prod Set.countable_univ).image _

lemma isOpen_of_mem_basisInter {S : Set ℂ} (hS : S ∈ basisInter) : IsOpen S := by
  obtain ⟨T, ⟨hTf, hTB⟩, rfl⟩ := hS
  exact hTf.isOpen_sInter fun s hs => isOpen_of_mem_countableBasis (hTB hs)

lemma isOpen_of_mem_piQ {Q : Set ℂ} (hQ : Q ∈ piQ) : IsOpen Q := by
  obtain ⟨⟨S, k⟩, ⟨hS, -⟩, rfl⟩ := hQ
  exact (isOpen_of_mem_basisInter hS).inter Metric.isOpen_ball

lemma univ_mem_basisInter : (univ : Set ℂ) ∈ basisInter :=
  ⟨∅, ⟨Set.finite_empty, Set.empty_subset _⟩, by simp⟩

lemma mem_basisInter_of_mem {b : Set ℂ} (hb : b ∈ countableBasis ℂ) : b ∈ basisInter :=
  ⟨{b}, ⟨Set.finite_singleton b, Set.singleton_subset_iff.2 hb⟩, Set.sInter_singleton b⟩

lemma ballK_mono {i j : ℕ} (hij : i ≤ j) : ballK i ⊆ ballK j :=
  Metric.ball_subset_ball (by exact_mod_cast hij)

lemma ballK_inter (m k : ℕ) : ballK m ∩ ballK k = ballK (min m k) := by
  rcases le_total m k with h | h
  · rw [min_eq_left h]
    exact Set.inter_eq_left.2 (ballK_mono h)
  · rw [min_eq_right h]
    exact Set.inter_eq_right.2 (ballK_mono h)

lemma iUnion_ballK : ⋃ k : ℕ, ballK k = univ := by
  refine Set.eq_univ_of_forall fun x => ?_
  obtain ⟨n, hn⟩ := exists_nat_gt ‖x‖
  exact Set.mem_iUnion.2 ⟨n, by simpa [ballK, Metric.mem_ball, dist_zero_right] using hn⟩

lemma basisInter_inter {S T : Set ℂ} (hS : S ∈ basisInter) (hT : T ∈ basisInter) :
    S ∩ T ∈ basisInter := by
  obtain ⟨A, ⟨hAf, hAB⟩, rfl⟩ := hS
  obtain ⟨B, ⟨hBf, hBB⟩, rfl⟩ := hT
  exact ⟨A ∪ B, ⟨hAf.union hBf, Set.union_subset hAB hBB⟩, Set.sInter_union A B⟩

lemma mem_piQ_ballK (k : ℕ) : ballK k ∈ piQ :=
  ⟨⟨univ, k⟩, ⟨univ_mem_basisInter, Set.mem_univ _⟩, by simp⟩

lemma mem_piQ_of_basis {b : Set ℂ} (hb : b ∈ countableBasis ℂ) (k : ℕ) : b ∩ ballK k ∈ piQ :=
  ⟨⟨b, k⟩, ⟨mem_basisInter_of_mem hb, Set.mem_univ _⟩, rfl⟩

lemma piQ_inter {Q Q' : Set ℂ} (hQ : Q ∈ piQ) (hQ' : Q' ∈ piQ) : Q ∩ Q' ∈ piQ := by
  obtain ⟨⟨S, m⟩, ⟨hS, -⟩, rfl⟩ := hQ
  obtain ⟨⟨T, k⟩, ⟨hT, -⟩, rfl⟩ := hQ'
  refine ⟨⟨S ∩ T, min m k⟩, ⟨basisInter_inter hS hT, Set.mem_univ _⟩, ?_⟩
  show (S ∩ T) ∩ ballK (min m k) = (S ∩ ballK m) ∩ (T ∩ ballK k)
  rw [← ballK_inter]
  ext x
  simp only [Set.mem_inter_iff]
  tauto

lemma piQ_isPiSystem : IsPiSystem piQ := fun _ hs _ ht _ => piQ_inter hs ht

lemma piQ_inter_ball {Q : Set ℂ} (hQ : Q ∈ piQ) (k : ℕ) : Q ∩ ballK k ∈ piQ :=
  piQ_inter hQ (mem_piQ_ballK k)

/-- The σ-algebra of `ℂ` is generated by the countable π-system `piQ`. -/
lemma borel_eq_generateFrom_piQ :
    (inferInstance : MeasurableSpace ℂ) = MeasurableSpace.generateFrom piQ := by
  refine le_antisymm ?_
    (MeasurableSpace.generateFrom_le fun Q hQ => (isOpen_of_mem_piQ hQ).measurableSet)
  refine (BorelSpace.measurable_eq (α := ℂ)).trans_le ?_
  show MeasurableSpace.generateFrom {s : Set ℂ | IsOpen s} ≤ MeasurableSpace.generateFrom piQ
  refine MeasurableSpace.generateFrom_le fun U hU => ?_
  rw [(isBasis_countableBasis ℂ).open_eq_sUnion' hU]
  refine MeasurableSet.sUnion (Set.Countable.mono (fun b hb => hb.1) (countable_countableBasis ℂ))
    fun b hb => ?_
  have hb' : b = ⋃ k : ℕ, b ∩ ballK k := by
    rw [← Set.inter_iUnion, iUnion_ballK, Set.inter_univ]
  rw [hb']
  exact MeasurableSet.iUnion fun k =>
    MeasurableSpace.measurableSet_generateFrom (mem_piQ_of_basis hb.1 k)

/-- Dynkin argument: evaluations on the balls `B(0,k)` of a family of measures that are finite on the balls
are measurable on all Borel sets, from measurability on `piQ`. -/
lemma measurable_measure_inter_ball {Ω : Type*} [MeasurableSpace Ω] (ν : Ω → Measure ℂ)
    (hfin : ∀ (ω : Ω) (k : ℕ), ν ω (ballK k) ≠ ∞)
    (hpi : ∀ Q ∈ piQ, Measurable fun ω => ν ω Q) (A : Set ℂ) (hA : MeasurableSet A) (k : ℕ) :
    Measurable fun ω => ν ω (A ∩ ballK k) := by
  refine MeasurableSpace.induction_on_inter
    (C := fun s _ => ∀ k : ℕ, Measurable fun ω => ν ω (s ∩ ballK k))
    borel_eq_generateFrom_piQ piQ_isPiSystem ?_ ?_ ?_ ?_ A hA k
  · intro k
    simp
  · intro t ht k
    exact hpi _ (piQ_inter_ball ht k)
  · intro t htm ih k
    have hB : Measurable fun ω => ν ω (ballK k) := hpi _ (mem_piQ_ballK k)
    have hid : ∀ ω, ν ω (tᶜ ∩ ballK k) = ν ω (ballK k) - ν ω (t ∩ ballK k) := by
      intro ω
      have h1 := measure_inter_add_sdiff (μ := ν ω) (ballK k) htm
      have e1 : tᶜ ∩ ballK k = ballK k \ t := by
        ext x
        simp [and_comm]
      have e2 : t ∩ ballK k = ballK k ∩ t := Set.inter_comm _ _
      have hc : ν ω (ballK k ∩ t) ≠ ∞ :=
        ne_top_of_le_ne_top (hfin ω k) (measure_mono Set.inter_subset_left)
      rw [e1, e2]
      exact ENNReal.eq_sub_of_add_eq hc (by rw [add_comm]; exact h1)
    have hfun : (fun ω => ν ω (tᶜ ∩ ballK k)) = fun ω => ν ω (ballK k) - ν ω (t ∩ ballK k) :=
      funext hid
    rw [hfun]
    exact hB.sub (ih k)
  · intro f hdisj hfm ih k
    have hsplit : ∀ ω, ν ω ((⋃ i, f i) ∩ ballK k) = ∑' i, ν ω (f i ∩ ballK k) := by
      intro ω
      rw [Set.iUnion_inter]
      exact measure_iUnion
        (fun i j hij => Disjoint.mono Set.inter_subset_left Set.inter_subset_left (hdisj hij))
        (fun i => (hfm i).inter Metric.isOpen_ball.measurableSet)
    have hfun : (fun ω => ν ω ((⋃ i, f i) ∩ ballK k)) = fun ω => ∑' i, ν ω (f i ∩ ballK k) :=
      funext hsplit
    rw [hfun]
    exact Measurable.tsum fun i => ih i k

/-- Measurability of all evaluations of a family of measures finite on the balls, from measurability on `piQ`. -/
lemma measurable_measure_of_piQ {Ω : Type*} [MeasurableSpace Ω] (ν : Ω → Measure ℂ)
    (hfin : ∀ (ω : Ω) (k : ℕ), ν ω (ballK k) ≠ ∞)
    (hpi : ∀ Q ∈ piQ, Measurable fun ω => ν ω Q) (A : Set ℂ) (hA : MeasurableSet A) :
    Measurable fun ω => ν ω A := by
  have hmono : Monotone fun k : ℕ => A ∩ ballK k :=
    fun i j hij => Set.inter_subset_inter_right _ (ballK_mono hij)
  have hU : ⋃ k : ℕ, A ∩ ballK k = A := by
    rw [← Set.inter_iUnion, iUnion_ballK, Set.inter_univ]
  have hval : ∀ ω, ν ω A = ⨆ k : ℕ, ν ω (A ∩ ballK k) := fun ω => by
    have h := hmono.measure_iUnion (μ := ν ω)
    rw [hU] at h
    exact h
  have hfun : (fun ω => ν ω A) = fun ω => ⨆ k : ℕ, ν ω (A ∩ ballK k) := funext hval
  rw [hfun]
  exact Measurable.iSup fun k => measurable_measure_inter_ball ν hfin hpi A hA k

/-- A family of measures, whose open-set evaluations are a.e. measurable and which is a.s. locally finite, is
a.e. measurable for the Giry σ-algebra of `Measure ℂ`. -/
theorem aemeasurable_of_open_aemeasurable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    (μ : Ω → Measure ℂ) (hopen : ∀ U : Set ℂ, IsOpen U → AEMeasurable (fun ω => μ ω U) P)
    (hloc : ∀ᵐ ω ∂P, IsLocallyFiniteMeasure (μ ω)) : AEMeasurable μ P := by
  have : Countable piQ := countable_piQ.to_subtype
  have hm : ∀ Q : piQ, ∃ m : Ω → ℝ≥0∞, Measurable m ∧ ∀ᵐ ω ∂P, μ ω Q = m ω := by
    rintro ⟨Q, hQ⟩
    obtain ⟨m, hm, hae⟩ := hopen Q (isOpen_of_mem_piQ hQ)
    exact ⟨m, hm, hae⟩
  choose m hmeas hae using hm
  have hgood : ∀ᵐ ω ∂P, (∀ Q : piQ, μ ω Q = m Q ω) ∧ IsLocallyFiniteMeasure (μ ω) :=
    (ae_all_iff.2 hae).and hloc
  obtain ⟨t, hsub, htm, ht0⟩ := exists_measurable_superset_of_null (ae_iff.1 hgood)
  obtain ⟨G, hG, hGgood, hPG⟩ : ∃ G : Set Ω, MeasurableSet G ∧
      (∀ ω ∈ G, (∀ Q : piQ, μ ω Q = m Q ω) ∧ IsLocallyFiniteMeasure (μ ω)) ∧
      ∀ᵐ ω ∂P, ω ∈ G := by
    refine ⟨tᶜ, htm.compl, fun ω hω => ?_, ?_⟩
    · by_contra hbad
      exact hω (hsub hbad)
    · rw [ae_iff]
      simpa using ht0
  let μ' : Ω → Measure ℂ := G.indicator μ
  have hμ'_apply : ∀ (ω : Ω) (A : Set ℂ), μ' ω A = G.indicator (fun ω => μ ω A) ω := by
    intro ω A
    by_cases h : ω ∈ G
    · simp [μ', Set.indicator_of_mem h]
    · simp [μ', Set.indicator_of_notMem h]
  have hfin : ∀ (ω : Ω) (k : ℕ), μ' ω (ballK k) ≠ ∞ := by
    intro ω k
    by_cases h : ω ∈ G
    · have := (hGgood ω h).2
      rw [hμ'_apply, Set.indicator_of_mem h]
      exact (measure_ball_lt_top (μ := μ ω) (x := (0 : ℂ)) (r := (k : ℝ))).ne
    · simp [μ', Set.indicator_of_notMem h]
  have hpi : ∀ Q ∈ piQ, Measurable fun ω => μ' ω Q := by
    intro Q hQ
    have hfun : (fun ω => μ' ω Q) = G.indicator (m ⟨Q, hQ⟩) := by
      funext ω
      by_cases h : ω ∈ G
      · simp only [hμ'_apply, Set.indicator_of_mem h]
        exact (hGgood ω h).1 ⟨Q, hQ⟩
      · simp [μ', Set.indicator_of_notMem h]
    rw [hfun]
    exact (hmeas ⟨Q, hQ⟩).indicator hG
  have hmeas' : Measurable μ' :=
    Measure.measurable_of_measurable_coe μ' fun A hA => measurable_measure_of_piQ μ' hfin hpi A hA
  refine ⟨μ', hmeas', ?_⟩
  filter_upwards [hPG] with ω hω
  exact (Set.indicator_of_mem hω μ).symm

/-- The LQG measure is a.e. measurable from the staged locality input (`LQGMeasureLocality`, Fact 2.1 II). -/
theorem aemeasurable_lqg_measure_zero_of_locality {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {γ : ℝ} {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {μ : Ω → Measure ℂ}
    (hγ : 0 < γ) (hγ2 : γ < 2) (hGFF : IsWholePlaneGFF P hC hcirc)
    (hμ : IsLQGMeasureOfField P γ 0 hcirc μ) (hloc : LQGMeasureLocality P γ 0 hC hcirc) :
    AEMeasurable μ P := by
  have hQ : (0 : ℝ) < lqgQ γ := by
    unfold lqgQ
    exact add_pos (div_pos two_pos hγ) (half_pos hγ)
  exact aemeasurable_of_open_aemeasurable μ
    (fun U hU => HarmonicBalls.Section6.aemeasurable_lqg_measure_open hγ hγ2 hQ hGFF hμ hloc hU)
    (Eventually.mono hμ (fun ω hω => hω.isLocallyFiniteMeasure))

end RandomMeasureMeasurable

open RandomMeasureMeasurable in
/-- The body of Lemma 11.12 at `α₀ = 0` for `Ω : Type`, as `pinchEventPositive_typeZero_of_raw`, with the
measurability of the measure-valued field derived from the staged locality input `hLocal` (`LQGMeasureLocality`,
Fact 2.1 II) instead of the separate premise `haem`. The raw canonical positivity `hraw` is unchanged. -/
theorem pinchEventPositive_typeZero_of_raw_locality {U T Q' Q : Set ℂ}
    (hconfig : IsPinchPointConfiguration U T Q' Q) (hraw : RawCanonicalPositiveStmt U T Q' Q)
    (hLocal : ∀ (γ : ℝ) (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
      (hcirc : Ω → ℝ → ℂ → ℝ), LQGMeasureLocality P γ 0 hC hcirc) :
    ∀ (γ ξ : ℝ), 0 < γ → γ < 2 →
    ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
      (hcirc : Ω → ℝ → ℂ → ℝ) (μ : Ω → Measure ℂ) (D : Ω → ℂ → ℂ → ℝ),
      IsWholePlaneGFF P hC hcirc → IsLQGMeasureOfField P γ 0 hcirc μ →
      IsLQGMetricOfField P γ ξ 0 hC D → ∀ M : ℝ, 0 < M →
      ∃ A ⊆ {ω | pinchPointEvent (μ ω) (D ω) U T Q' Q M 1 0}, MeasurableSet A ∧ 0 < P A := by
  intro γ ξ hγ hγ' Ω _ P hC hcirc μ D hgff hμ hD M hM
  obtain ⟨𝔇, h𝔇, hbridge⟩ := ae_metric_eq_canonical_of_isLQGMetricOfField_zero hgff hD
  have hpos := hraw γ ξ hγ hγ' Ω P hC hcirc μ 𝔇 hgff hμ h𝔇 M hM
  have hmetric : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (𝔇 (hC ω)) := by
    filter_upwards [ae_isEuclideanLengthMetric_of_isLQGMetricOfField_zero hgff hD, hbridge]
      with ω h1 h2
    rw [← h2]
    exact h1
  have hloc : ∀ᵐ ω ∂P, IsLocallyFiniteMeasure (μ ω) :=
    Eventually.mono hμ (fun ω hω => hω.isLocallyFiniteMeasure)
  obtain ⟨E, hsub, hE, hEpos⟩ :=
    exists_measurable_pos_subset_pinch P hconfig M 0 (by norm_num : (0 : ℝ) < 1)
      (D := fun ω => 𝔇 (hC ω)) (fun x y => measurable_canonical_metric hgff 𝔇 h𝔇 x y)
      hmetric (aemeasurable_lqg_measure_zero_of_locality hγ hγ' hgff hμ (hLocal γ Ω P hC hcirc))
      hloc hpos
  set S : Set Ω := {ω | ¬ (D ω = 𝔇 (hC ω))} with hS
  have hS0 : P (toMeasurable P S) = 0 := by
    rw [measure_toMeasurable]
    exact ae_iff.1 hbridge
  refine ⟨E \ toMeasurable P S, ?_, ?_, ?_⟩
  · intro ω hω
    have hωS : ω ∉ toMeasurable P S := hω.2
    have heq : D ω = 𝔇 (hC ω) := by
      by_contra hne
      exact hωS (subset_toMeasurable P S hne)
    have hpe : pinchPointEvent (μ ω) (𝔇 (hC ω)) U T Q' Q M 1 0 := (hsub hω.1).1
    show pinchPointEvent (μ ω) (D ω) U T Q' Q M 1 0
    rw [heq]
    exact hpe
  · exact hE.diff (measurableSet_toMeasurable P S)
  · rw [measure_sdiff_null hS0]
    exact hEpos

