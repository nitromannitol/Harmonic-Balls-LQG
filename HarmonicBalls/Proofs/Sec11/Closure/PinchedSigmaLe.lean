import HarmonicBalls.Proofs.Sec11.Closure.FixedRawPositiveStaged
import HarmonicBalls.Proofs.Sec11.ModConstPairingLaw

/-!
# The pinned σ-algebra is contained in the ambient one (Section 11, draft lines 447–513)

The premise `hm : fixedPinnedSigma hC ≤ m₀` of `Closure/FixedRawPositiveStaged.lean` is a measurability fact:
the zero-mean local pairings `φ ↦ fieldPairing 0 (hC ω) φ` are measurable because the GFF pairings
`hC ω φ` are measurable for every test function (`IsWholePlaneGFF.measurable_pairing`), and a test function
supported in the open set `O` is a test function on `ℂ`. Hence the σ-algebra generated by the pairings is
contained in the ambient one. This removes `hm` from the leftover premises.
-/

namespace HarmonicBalls

open MeasureTheory Metric Set
open scoped ENNReal

/-- The local zero-mean pairings of a whole-plane GFF are measurable (for `α₀ = 0` the pairing is `hC ω φ`). -/
lemma measurable_localModConstPairings_zero {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hgff : IsWholePlaneGFF P hC hcirc)
    (U : Set ℂ) : Measurable (localModConstPairings 0 hC U) := by
  refine measurable_pi_iff.2 (fun φ => ?_)
  have hφ : IsTestFunction Set.univ φ.1 := ⟨φ.2.1.1, φ.2.1.2.1, Set.subset_univ _⟩
  have heq : (fun ω => localModConstPairings 0 hC U ω φ) = fun ω => hC ω φ.1 := by
    funext ω
    simp [localModConstPairings, fieldPairing]
  rw [heq]
  exact hgff.measurable_pairing φ.1 hφ

/-- The pinned σ-algebra of the fixed configuration is contained in the ambient σ-algebra: premise `hm`. -/
lemma fixedPinnedSigma_le {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} (hgff : IsWholePlaneGFF P hC hcirc) :
    fixedPinnedSigma hC ≤ ‹MeasurableSpace Ω› :=
  (measurable_localModConstPairings_zero hgff fixedOutside).comap_le

/-- Raw strengthened positivity of the fixed corrected configuration for `ξ > 0`, with the volume-growth input
derived from the staged inputs `hDG`, `hCC`, `hE` and the pinned-σ-algebra premise `hm` proved. -/
theorem fixed_raw_positive_staged_no_hm
    (hDG : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), WholePlaneLQGBallMassBounds P γ hC hcirc)
    (hCC : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (γ : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), LQGMeasureCoordChange P γ 0 hC hcirc)
    (hE : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (γ α : ℝ)
      (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ), LQGMeasureExistence P γ α hC hcirc)
    {γ ξ : ℝ} (hγ : 0 < γ) (hγ₂ : γ < 2) (hξ : 0 < ξ)
    {Ω : Type} [m₀ : MeasurableSpace Ω] (P : Measure Ω)
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ} {μ : Ω → Measure ℂ}
    (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) (h𝔇 : IsLQGMetric γ ξ 𝔇)
    (hgff : IsWholePlaneGFF P hC hcirc) (hμ : IsLQGMeasureOfField P γ 0 hcirc μ)
    (M : ℝ)
    (hfront : ∀ᵐ ω ∂P, μ ω (frontier (closedSquare fixedSquareCorner fixedSquareSide)) = 0)
    (hdata : SquareDyadicTailInput P ξ hC hcirc 𝔇 fixedSquareCorner fixedSquareSide)
    (hmeasIns : ∀ n k : ℕ, 0 < n →
      @MeasurableSet Ω m₀ {ω | internalDiam (𝔇 (hC ω)) fixedDelta fixedV < (n : ℝ≥0∞)⁻¹ ∧
        (k : ℝ≥0∞) < μ ω fixedU})
    (A : Set Ω) (hA : MeasurableSet[fixedPinnedSigma hC] A)
    (hArep : A =ᵐ[P] {ω | correctedOpenFirstCertificate (𝔇 (hC ω)) fixedW fixedT fixedQ' fixedQ fixedDelta})
    (ha : @Measurable Ω ℝ≥0∞ (fixedPinnedSigma hC) _ (fun ω => ENNReal.ofReal
      (setDist (𝔇 (hC ω)) (sphere 0 fixedDelta) (sphere 0 (2 * fixedDelta)))))
    (hb : @Measurable Ω ℝ≥0∞ (fixedPinnedSigma hC) _ (fun ω =>
      ENNReal.ofReal M * annulusGreenPotentialSup (μ ω) 0 3 6)) :
    0 < P {ω | pinchPointEventWithInternalBounds (μ ω) (𝔇 (hC ω)) fixedU fixedT fixedQ' fixedQ M 1 0} :=
  fixed_raw_positive_of_staged_volume_growth hDG hCC hE hγ hγ₂ hξ P 𝔇 h𝔇 hgff hμ M hfront hdata hmeasIns
    (fixedPinnedSigma_le hgff) A hA hArep ha hb

#print axioms fixed_raw_positive_staged_no_hm

end HarmonicBalls
