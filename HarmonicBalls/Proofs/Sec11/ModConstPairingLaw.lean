import HarmonicBalls.Proofs.Sec11.PinchModConstGerm

/-! # Pairing-law comparison modulo constants

The Section 8 germ and Birkhoff proofs use Leonardo Bonanno's LatticeProb
formalization. All comparisons below concern the full joint law of the
zero-integral test pairings.
-/

namespace HarmonicBalls

open Set Metric Filter MeasureTheory

/-- Local test functions whose integral is zero. -/
def LocalZeroMeanTest (U : Set ℂ) :=
  {φ : ℂ → ℝ // IsTestFunction U φ ∧ ∫ x, φ x = 0}

/-- The joint process of local field pairings with zero-integral tests. -/
noncomputable def localModConstPairings {Ω : Type*} (α : ℝ)
    (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) (ω : Ω) : LocalZeroMeanTest U → ℝ :=
  fun φ => fieldPairing α (hC ω) φ.1

/-- The modulo-constant field sigma algebra is generated by the joint process
of pairings with all local zero-integral tests. -/
theorem fieldSigmaAlgebraModConst_eq_comap_localModConstPairings {Ω : Type*}
    (α : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    Section6.fieldSigmaAlgebraModConst α hC U =
      MeasurableSpace.comap (localModConstPairings α hC U) inferInstance := by
  apply le_antisymm
  · unfold Section6.fieldSigmaAlgebraModConst
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    have hp : Measurable[MeasurableSpace.comap (localModConstPairings α hC U) inferInstance]
        (fun ω => fieldPairing α (hC ω) φ) := by
      exact (measurable_pi_apply (⟨φ, hφ⟩ : LocalZeroMeanTest U)).comp
        (comap_measurable (localModConstPairings α hC U))
    exact measurable_iff_comap_le.mp hp
  · apply measurable_iff_comap_le.mp
    let : MeasurableSpace Ω := Section6.fieldSigmaAlgebraModConst α hC U
    apply measurable_pi_iff.mpr
    intro φ
    apply measurable_iff_comap_le.mpr
    unfold Section6.fieldSigmaAlgebraModConst
    exact le_iSup_of_le φ.1 (le_iSup_of_le φ.2 le_rfl)

/-- Absolute continuity of the joint zero-integral pairing laws is equivalent
to absolute continuity on the local field sigma algebra modulo constants. -/
theorem fieldSigmaAlgebraModConst_trim_ac_iff_pairing_law
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P Q : Measure Ω)
    (α : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ)
    (hm : Section6.fieldSigmaAlgebraModConst α hC U ≤ mΩ) :
    P.trim hm ≪ Q.trim hm ↔
      P.map (localModConstPairings α hC U) ≪ Q.map (localModConstPairings α hC U) := by
  have hf : Measurable (localModConstPairings α hC U) := by
    apply measurable_iff_comap_le.mpr
    rw [← fieldSigmaAlgebraModConst_eq_comap_localModConstPairings]
    exact hm
  constructor
  · intro hac
    apply Measure.AbsolutelyContinuous.mk
    intro s hs hz
    have hpre : MeasurableSet[Section6.fieldSigmaAlgebraModConst α hC U]
        (localModConstPairings α hC U ⁻¹' s) := by
      rw [fieldSigmaAlgebraModConst_eq_comap_localModConstPairings]
      exact MeasurableSpace.measurableSet_comap.mpr ⟨s, hs, rfl⟩
    rw [Measure.map_apply hf hs] at hz ⊢
    have hz' : Q.trim hm (localModConstPairings α hC U ⁻¹' s) = 0 := by
      rwa [trim_measurableSet_eq hm hpre]
    have hp := hac hz'
    rwa [trim_measurableSet_eq hm hpre] at hp
  · intro hac
    apply Measure.AbsolutelyContinuous.mk
    intro s hs hz
    have hs' : MeasurableSet[MeasurableSpace.comap (localModConstPairings α hC U)
        inferInstance] s := by
      rw [← fieldSigmaAlgebraModConst_eq_comap_localModConstPairings]
      exact hs
    obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs'
    rw [trim_measurableSet_eq hm hs] at hz ⊢
    rw [← Measure.map_apply hf ht] at hz ⊢
    exact hac hz

/-- Full local pairing-law absolute continuity implies the corresponding
comparison modulo constants, by restricting the joint observation. -/
theorem localModConstPairings_ac_of_localFieldPairings_ac
    {Ω : Type*} [MeasurableSpace Ω] (P Q : Measure Ω)
    (α : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ)
    (hf : Measurable (localFieldPairings α hC U))
    (hac : P.map (localFieldPairings α hC U) ≪ Q.map (localFieldPairings α hC U)) :
    P.map (localModConstPairings α hC U) ≪ Q.map (localModConstPairings α hC U) := by
  let R : (LocalFieldTest U → ℝ) → LocalZeroMeanTest U → ℝ :=
    fun v φ => v ⟨φ.1, φ.2.1⟩
  have hR : Measurable R := by
    apply measurable_pi_iff.mpr
    intro φ
    exact measurable_pi_apply (⟨φ.1, φ.2.1⟩ : LocalFieldTest U)
  have heq : localModConstPairings α hC U = R ∘ localFieldPairings α hC U := rfl
  rw [heq, ← Measure.map_map hR hf, ← Measure.map_map hR hf]
  exact hac.map hR

/-- A local comparison of zero-integral pairing laws at one radius suffices
for triviality of the origin germ modulo constants. -/
theorem origin_modConst_germ_trivial_of_modConst_pairing_law
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P Q : Measure Ω) [IsProbabilityMeasure P]
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (hQ : IsWholePlaneGFF Q hC hcirc) (α : ℝ) {r : ℝ} (hr : 0 < r)
    (hAC : P.map (localModConstPairings α hC (ball 0 r)) ≪
      Q.map (localModConstPairings α hC (ball 0 r))) :
    ∀ A : Set Ω, (∀ ε : ℝ, 0 < ε →
      MeasurableSet[Section6.fieldSigmaAlgebraModConst α hC (ball 0 ε)] A) →
      P A = 0 ∨ P A = 1 := by
  let : IsProbabilityMeasure Q := hQ.isProbabilityMeasure
  have hm : Section6.fieldSigmaAlgebraModConst α hC (ball 0 r) ≤ mΩ :=
    (Section6.fieldSigmaAlgebraModConst_le α hC _).trans (hQ.fieldSigmaAlgebra_le α _)
  have hac := (fieldSigmaAlgebraModConst_trim_ac_iff_pairing_law P Q α hC _ hm).mpr hAC
  intro A hA
  have hAm := hA r hr
  have hAambient : MeasurableSet A := hm A hAm
  have htransfer : ∀ B : Set Ω,
      MeasurableSet[Section6.fieldSigmaAlgebraModConst α hC (ball 0 r)] B →
      Q B = 0 → P B = 0 := by
    intro B hB hQB
    have hz : Q.trim hm B = 0 := by rwa [trim_measurableSet_eq hm hB]
    have hp := hac hz
    rwa [trim_measurableSet_eq hm hB] at hp
  rcases hQ.origin_germ_trivial α A hA with hzero | hone
  · exact Or.inl (htransfer A hAm hzero)
  · right
    have hQc : Q Aᶜ = 0 := by
      rw [measure_compl hAambient (measure_ne_top Q A), hone]
      simp
    simpa using measure_of_measure_compl_eq_zero (htransfer Aᶜ hAm.compl hQc)

open Classical in
/-- The fixed-point pinch-frequency bridge only needs local comparison of
the joint zero-integral pairing laws. Stationarity, the local representatives,
and the probability bound remain explicit. -/
theorem ae_internal_pinchBlockDensity_of_modConst_pairing_law
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P Q : Measure Ω) [IsProbabilityMeasure P]
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (hQ : IsWholePlaneGFF Q hC hcirc) (α : ℝ) {r : ℝ} (hr : 0 < r)
    (hAC : P.map (localModConstPairings α hC (ball 0 r)) ≪
      Q.map (localModConstPairings α hC (ball 0 r)))
    (μ : Ω → Measure ℂ) (D : Ω → ℂ → ℂ → ℝ)
    (U T Q' V : Set ℂ) (M : ℝ) (X : ℕ → Ω → ℝ)
    (hXm : ∀ n, Measurable (X n)) (hbound : ∀ n ω, X n ω ∈ Icc (0 : ℝ) 1)
    (hX : ∀ᵐ ω ∂P, ∀ n, X n ω = if pinchPointEventWithInternalBounds (μ ω) (D ω)
      U T Q' V M ((2 : ℝ)⁻¹ ^ n) 0 then 1 else 0)
    (hXgerm : ∀ ε, 0 < ε → ∃ K, ∀ n, K ≤ n →
      Measurable[Section6.fieldSigmaAlgebraModConst α hC (ball 0 ε)] (X n))
    (hstat : P.map (fun ω n => X (n + 2) ω) = P.map (fun ω n => X (n + 1) ω))
    (δ : ℝ) (hδ : δ < (P {ω | pinchPointEventWithInternalBounds (μ ω) (D ω)
      U T Q' V M ((2 : ℝ)⁻¹ ^ 1) 0}).toReal) :
    ∀ᵐ ω ∂P, ∀ᶠ N : ℕ in atTop, δ * N ≤
      ({n : ℕ | N + 1 ≤ n ∧ n ≤ 2 * N ∧
        pinchPointEventWithInternalBounds (μ ω) (D ω) U T Q' V M ((2 : ℝ)⁻¹ ^ n) 0}.ncard : ℝ) := by
  let F : Ω → ℕ → ℝ := fun ω n => X (n + 1) ω
  let : IsFiniteMeasure (P.map F) := P.isFiniteMeasure_map F
  exact ae_eventually_internal_pinch_block_density_of_ae_rep_of_lt_prob P μ D U T Q' V M 0 X
    (fun ε => Section6.fieldSigmaAlgebraModConst α hC (ball 0 ε))
    (fun ε _ => (Section6.fieldSigmaAlgebraModConst_le α hC _).trans
      (hQ.fieldSigmaAlgebra_le α _)) hXgerm
    (origin_modConst_germ_trivial_of_modConst_pairing_law P Q hQ α hr hAC)
    hXm hbound hX (pointwiseBirkhoff_of_latticeProb _ _ _) hstat δ hδ


end HarmonicBalls
