import Mathlib.MeasureTheory.Constructions.Cylinders
import Mathlib.MeasureTheory.Integral.BoundedContinuousFunction
import Mathlib.MeasureTheory.Measure.MeasuredSets
import Mathlib.MeasureTheory.SetAlgebra
import Mathlib.MeasureTheory.Function.ContinuousMapDense
import Mathlib.MeasureTheory.Integral.IntegrableOn
import Mathlib.MeasureTheory.Integral.Bochner.Set
import Mathlib.Dynamics.Ergodic.MeasurePreserving

/-! # Mixing for coordinate cylinders

The hypotheses below separate the finite-dimensional factorization from the
measure-theoretic extension to the sigma-algebra generated by the coordinates.
-/

open MeasureTheory Filter
open scoped Topology symmDiff ENNReal

noncomputable section
namespace HarmonicBalls

/-- The sigma-algebra generated by a family of real-valued coordinates. -/
@[instance_reducible]
def coordinateSigma {Ω I : Type*} (X : I → Ω → ℝ) : MeasurableSpace Ω :=
  ⨆ i, (borel ℝ).comap (X i)

/-- Asymptotic product factorization for bounded continuous finite-coordinate observables. -/
def cylinderFactorization {Ω I : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (X : I → Ω → ℝ) (T : Ω → Ω) : Prop :=
  ∀ (m k : ℕ) (a : Fin m → I) (b : Fin k → I)
    (f : BoundedContinuousFunction (Fin m → ℝ) ℝ)
    (g : BoundedContinuousFunction (Fin k → ℝ) ℝ),
    Tendsto (fun n : ℕ => ∫ ω, f (fun i => X (a i) ω) *
      g (fun j => X (b j) ((T^[n]) ω)) ∂P) atTop
      (𝓝 ((∫ ω, f (fun i => X (a i) ω) ∂P) *
        (∫ ω, g (fun j => X (b j) ω) ∂P)))

/-- The desired event-level consequence for the coordinate sigma-algebra. -/
def coordinateSigmaMixing {Ω I : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (X : I → Ω → ℝ) (T : Ω → Ω) : Prop :=
  ∀ A B : Set Ω, MeasurableSet[coordinateSigma X] A →
    MeasurableSet[coordinateSigma X] B →
    Tendsto (fun n : ℕ => (P (A ∩ (T^[n]) ⁻¹' B)).toReal) atTop
      (𝓝 ((P A).toReal * (P B).toReal))

/-- The exact conditional extension statement; no GFF-specific invariance is assumed. -/
def cylinderMixingExtensionStatement {Ω I : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : I → Ω → ℝ) (T : Ω → Ω) : Prop :=
  (∀ i, Measurable (X i)) → MeasurePreserving T P P →
    cylinderFactorization P X T → coordinateSigmaMixing P X T

/-- The coordinate sigma-algebra is the pullback of the product sigma-algebra. -/
theorem coordinateSigma_eq_comap {Ω I : Type*} (X : I → Ω → ℝ) :
    coordinateSigma X = MeasurableSpace.comap (fun ω i => X i ω) MeasurableSpace.pi := by
  simp only [coordinateSigma, MeasurableSpace.pi, MeasurableSpace.comap_iSup,
    MeasurableSpace.comap_comp, Function.comp_def, BorelSpace.measurable_eq]

/-- The coordinate sigma-algebra is generated by measurable finite cylinders. -/
theorem coordinateSigma_eq_generateFrom_cylinders {Ω I : Type*} (X : I → Ω → ℝ) :
    coordinateSigma X = MeasurableSpace.generateFrom
      ((fun S : Set (I → ℝ) => (fun ω i => X i ω) ⁻¹' S) ''
        measurableCylinders (fun _ : I => ℝ)) := by
  rw [coordinateSigma_eq_comap, ← generateFrom_measurableCylinders,
    MeasurableSpace.comap_generateFrom]

/-- Measurable sets in a product can be approximated in finite measure by
measurable finite-coordinate cylinders, without a countability assumption on
the index type. -/
theorem exists_measurableCylinder_symmDiff_lt {I : Type*}
    (Q : Measure (I → ℝ)) [IsFiniteMeasure Q] {S : Set (I → ℝ)}
    (hS : MeasurableSet S) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ C ∈ measurableCylinders (fun _ : I => ℝ), Q (C ∆ S) < ε := by
  have hA : IsSetAlgebra (measurableCylinders (fun _ : I => ℝ)) := by
    refine ⟨?_, ?_, ?_⟩
    · exact empty_mem_measurableCylinders _
    · intro s hs
      exact compl_mem_measurableCylinders hs
    · intro s t hs ht
      exact union_mem_measurableCylinders hs ht
  apply exists_measure_symmDiff_lt_of_generateFrom_isSetRing hA.isSetRing ?_
    generateFrom_measurableCylinders.symm hS hε
  refine ⟨{Set.univ}, Set.countable_singleton _, ?_, ?_⟩
  · exact Set.singleton_subset_iff.mpr hA.univ_mem
  · simp

/-- Any event in the coordinate sigma-algebra is approximated in measure by
the pullback of a measurable finite-coordinate cylinder. -/
theorem exists_coordinateCylinder_symmDiff_lt {Ω I : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsFiniteMeasure P] (X : I → Ω → ℝ)
    (hX : ∀ i, Measurable (X i)) {A : Set Ω}
    (hA : MeasurableSet[coordinateSigma X] A) {ε : ℝ≥0∞} (hε : 0 < ε) :
    ∃ C ∈ measurableCylinders (fun _ : I => ℝ),
      P (((fun ω i => X i ω) ⁻¹' C) ∆ A) < ε := by
  let Y : Ω → I → ℝ := fun ω i => X i ω
  have hY : Measurable Y := Measurable.of_eval hX
  rw [coordinateSigma_eq_comap, MeasurableSpace.measurableSet_comap] at hA
  obtain ⟨S, hS, hSA⟩ := hA
  let Q : Measure (I → ℝ) := P.map Y
  let _ : IsFiniteMeasure Q := Measure.isFiniteMeasure_map P Y
  obtain ⟨C, hC, hCS⟩ := exists_measurableCylinder_symmDiff_lt Q hS hε
  refine ⟨C, hC, ?_⟩
  have hm : MeasurableSet (C ∆ S) := (MeasurableSet.of_mem_measurableCylinders hC).symmDiff hS
  rw [Measure.map_apply hY hm] at hCS
  simpa only [Y, Set.preimage_symmDiff, hSA] using hCS

/-- Every coordinate is measurable in the sigma-algebra it generates. -/
theorem measurable_coordinate {Ω I : Type*} (X : I → Ω → ℝ) (i : I) :
    Measurable[coordinateSigma X] (X i) := by
  exact Measurable.of_comap_le (le_iSup (fun i => (borel ℝ).comap (X i)) i)

/-- Measurable coordinates generate a sub-sigma-algebra of the ambient one. -/
theorem coordinateSigma_le {Ω I : Type*} [MeasurableSpace Ω] (X : I → Ω → ℝ)
    (hX : ∀ i, Measurable (X i)) : coordinateSigma X ≤ ‹MeasurableSpace Ω› := by
  exact iSup_le fun i => (hX i).comap_le

/-- Finite coordinate vectors are measurable for the generated sigma-algebra. -/
theorem measurable_coordinate_vector {Ω I : Type*} (X : I → Ω → ℝ)
    {m : ℕ} (a : Fin m → I) :
    Measurable[coordinateSigma X] (fun ω i => X (a i) ω) := by
  let _ : MeasurableSpace Ω := coordinateSigma X
  exact Measurable.of_eval fun i => measurable_coordinate X (a i)

/-- Intersecting two events with the same measurable event is non-expansive
for the symmetric-difference distance in finite measure. -/
theorem abs_measureReal_inter_sub_le_symmDiff {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsFiniteMeasure P] {A A' B : Set Ω}
    (hA : MeasurableSet A) (hA' : MeasurableSet A') (hB : MeasurableSet B) :
    |P.real (A ∩ B) - P.real (A' ∩ B)| ≤ P.real (A ∆ A') := by
  calc
    _ ≤ P.real ((A ∩ B) ∆ (A' ∩ B)) :=
      abs_measureReal_sub_le_measureReal_symmDiff (hA.inter hB).nullMeasurableSet
        (hA'.inter hB).nullMeasurableSet
    _ = P.real ((A ∆ A') ∩ B) := by rw [Set.inter_symmDiff_distrib_right]
    _ ≤ P.real (A ∆ A') := measureReal_mono Set.inter_subset_left

/-- The event correlations of a measure-preserving iterate change by at most
the sum of the symmetric-difference distances of the two events. -/
theorem abs_measureReal_inter_preimage_sub_le {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsFiniteMeasure P] {T : Ω → Ω} (hT : MeasurePreserving T P P)
    {A A' B B' : Set Ω} (hA : MeasurableSet A) (hA' : MeasurableSet A')
    (hB : MeasurableSet B) (hB' : MeasurableSet B') (n : ℕ) :
    |P.real (A ∩ (T^[n]) ⁻¹' B) - P.real (A' ∩ (T^[n]) ⁻¹' B')| ≤
      P.real (A ∆ A') + P.real (B ∆ B') := by
  have hn := hT.iterate n
  have h₁ := abs_measureReal_inter_sub_le_symmDiff P hA hA' (hn.measurable hB)
  have h₂ := abs_measureReal_inter_sub_le_symmDiff P (hn.measurable hB)
    (hn.measurable hB') hA'
  rw [← Set.preimage_symmDiff, hn.measureReal_preimage (hB.symmDiff hB').nullMeasurableSet] at h₂
  calc
    _ ≤ |P.real (A ∩ (T^[n]) ⁻¹' B) - P.real (A' ∩ (T^[n]) ⁻¹' B)| +
        |P.real (A' ∩ (T^[n]) ⁻¹' B) - P.real (A' ∩ (T^[n]) ⁻¹' B')| :=
      abs_sub_le _ _ _
    _ ≤ P.real (A ∆ A') + P.real (B ∆ B') := by
      apply add_le_add h₁
      simpa only [Set.inter_comm] using h₂

/-- Products of probabilities inherit the symmetric-difference bound. -/
theorem abs_measureReal_mul_sub_le {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] {A A' B B' : Set Ω}
    (hA : MeasurableSet A) (hA' : MeasurableSet A')
    (hB : MeasurableSet B) (hB' : MeasurableSet B') :
    |P.real A * P.real B - P.real A' * P.real B'| ≤
      P.real (A ∆ A') + P.real (B ∆ B') := by
  have ha := abs_measureReal_sub_le_measureReal_symmDiff
    (μ := P) hA.nullMeasurableSet hA'.nullMeasurableSet
  have hb := abs_measureReal_sub_le_measureReal_symmDiff
    (μ := P) hB.nullMeasurableSet hB'.nullMeasurableSet
  have hA0 : 0 ≤ P.real A' := measureReal_nonneg
  have hA1 : P.real A' ≤ 1 := measureReal_le_one
  have hB0 : 0 ≤ P.real B := measureReal_nonneg
  have hB1 : P.real B ≤ 1 := measureReal_le_one
  calc
    _ = |(P.real A - P.real A') * P.real B + P.real A' * (P.real B - P.real B')| := by
      congr 1; ring
    _ ≤ |(P.real A - P.real A') * P.real B| + |P.real A' * (P.real B - P.real B')| :=
      abs_add_le _ _
    _ = |P.real A - P.real A'| * P.real B + P.real A' * |P.real B - P.real B'| := by
      rw [abs_mul, abs_mul, abs_of_nonneg hA0, abs_of_nonneg hB0]
    _ ≤ P.real (A ∆ A') + P.real (B ∆ B') := by
      nlinarith [abs_nonneg (P.real A - P.real A'), abs_nonneg (P.real B - P.real B')]

/-- Mixing on measurable finite cylinders extends to all events in the
coordinate sigma-algebra. -/
theorem coordinateSigmaMixing_of_cylinder_events {Ω I : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : I → Ω → ℝ)
    (hX : ∀ i, Measurable (X i)) (T : Ω → Ω) (hT : MeasurePreserving T P P)
    (h : ∀ C D : Set (I → ℝ), C ∈ measurableCylinders (fun _ : I => ℝ) →
      D ∈ measurableCylinders (fun _ : I => ℝ) →
      Tendsto (fun n : ℕ => P.real (((fun ω i => X i ω) ⁻¹' C) ∩
        (T^[n]) ⁻¹' ((fun ω i => X i ω) ⁻¹' D))) atTop
        (𝓝 (P.real ((fun ω i => X i ω) ⁻¹' C) *
          P.real ((fun ω i => X i ω) ⁻¹' D)))) : coordinateSigmaMixing P X T := by
  intro A B hA hB
  have hAm : MeasurableSet A := coordinateSigma_le X hX A hA
  have hBm : MeasurableSet B := coordinateSigma_le X hX B hB
  let Y : Ω → I → ℝ := fun ω i => X i ω
  have hY : Measurable Y := Measurable.of_eval hX
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  have hδ : 0 < ε / 8 := by positivity
  obtain ⟨C, hC, hCA⟩ := exists_coordinateCylinder_symmDiff_lt P X hX hA
    (ENNReal.ofReal_pos.mpr hδ)
  obtain ⟨D, hD, hDB⟩ := exists_coordinateCylinder_symmDiff_lt P X hX hB
    (ENNReal.ofReal_pos.mpr hδ)
  have hCA' : P.real (A ∆ (Y ⁻¹' C)) < ε / 8 := by
    have hh := (ENNReal.toReal_lt_toReal (measure_ne_top P _) ENNReal.ofReal_ne_top).2 hCA
    simpa only [Measure.real, ENNReal.toReal_ofReal hδ.le, symmDiff_comm, Y] using hh
  have hDB' : P.real (B ∆ (Y ⁻¹' D)) < ε / 8 := by
    have hh := (ENNReal.toReal_lt_toReal (measure_ne_top P _) ENNReal.ofReal_ne_top).2 hDB
    simpa only [Measure.real, ENNReal.toReal_ofReal hδ.le, symmDiff_comm, Y] using hh
  have hCm : MeasurableSet (Y ⁻¹' C) := hY (MeasurableSet.of_mem_measurableCylinders hC)
  have hDm : MeasurableSet (Y ⁻¹' D) := hY (MeasurableSet.of_mem_measurableCylinders hD)
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp (h C D hC hD) (ε / 2) (by positivity)
  refine ⟨N, fun n hn => ?_⟩
  have hn := hN n hn
  rw [Real.dist_eq] at hn ⊢
  have h₁ := abs_measureReal_inter_preimage_sub_le P hT hAm hCm hBm hDm n
  have h₂ := abs_measureReal_mul_sub_le P hAm hCm hBm hDm
  change |P.real (A ∩ (T^[n]) ⁻¹' B) - P.real A * P.real B| < ε
  calc
    _ ≤ |P.real (A ∩ (T^[n]) ⁻¹' B) - P.real ((Y ⁻¹' C) ∩ (T^[n]) ⁻¹' (Y ⁻¹' D))| +
        |P.real ((Y ⁻¹' C) ∩ (T^[n]) ⁻¹' (Y ⁻¹' D)) - P.real (Y ⁻¹' C) * P.real (Y ⁻¹' D)| +
        |P.real (Y ⁻¹' C) * P.real (Y ⁻¹' D) - P.real A * P.real B| := by
      linarith [abs_sub_le (P.real (A ∩ (T^[n]) ⁻¹' B))
        (P.real ((Y ⁻¹' C) ∩ (T^[n]) ⁻¹' (Y ⁻¹' D))) (P.real A * P.real B),
        abs_sub_le (P.real ((Y ⁻¹' C) ∩ (T^[n]) ⁻¹' (Y ⁻¹' D)))
        (P.real (Y ⁻¹' C) * P.real (Y ⁻¹' D)) (P.real A * P.real B)]
    _ < ε := by
      have h₂' : |P.real (Y ⁻¹' C) * P.real (Y ⁻¹' D) - P.real A * P.real B| ≤
          P.real (A ∆ (Y ⁻¹' C)) + P.real (B ∆ (Y ⁻¹' D)) := by
        simpa only [abs_sub_comm] using h₂
      change |P.real ((Y ⁻¹' C) ∩ (T^[n]) ⁻¹' (Y ⁻¹' D)) -
        P.real (Y ⁻¹' C) * P.real (Y ⁻¹' D)| < ε / 2 at hn
      linarith

/-- A measurable event can be approximated in L¹ by bounded continuous
functions taking values in the unit interval. -/
theorem exists_unit_boundedContinuous_indicator_approx
    {α : Type*} [TopologicalSpace α] [NormalSpace α] [SecondCountableTopology α]
    [MeasurableSpace α] [BorelSpace α] (Q : Measure α) [IsFiniteMeasure Q]
    [Q.WeaklyRegular] {S : Set α} (hS : MeasurableSet S) {ε : ℝ} (hε : 0 < ε) :
    ∃ g : BoundedContinuousFunction α ℝ,
      (∀ x, 0 ≤ g x ∧ g x ≤ 1) ∧
      (∫ x, ‖S.indicator (fun _ => (1 : ℝ)) x - g x‖ ∂Q) ≤ ε := by
  let F : α → ℝ := S.indicator (fun _ => (1 : ℝ))
  have hF : Integrable F Q := (integrable_const (1 : ℝ)).indicator hS
  obtain ⟨f, hf, _⟩ := hF.exists_boundedContinuous_integral_sub_le hε
  let g : BoundedContinuousFunction α ℝ := (f ⊔ 0) ⊓ 1
  have hgb : ∀ x, 0 ≤ g x ∧ g x ≤ 1 := by
    intro x
    change 0 ≤ min (max (f x) 0) 1 ∧ min (max (f x) 0) 1 ≤ 1
    exact ⟨le_min (le_max_right _ _) zero_le_one, min_le_right _ _⟩
  refine ⟨g, hgb, ?_⟩
  have hg : Integrable g Q := BoundedContinuousFunction.integrable Q g
  have hfi : Integrable f Q := BoundedContinuousFunction.integrable Q f
  calc
    _ ≤ ∫ x, ‖F x - f x‖ ∂Q := by
      apply integral_mono (hF.sub hg).norm (hF.sub hfi).norm
      intro x
      have hFx : 0 ≤ F x ∧ F x ≤ 1 := by
        by_cases hx : x ∈ S <;> simp [F, hx]
      have hclip : min (max (F x) 0) 1 = F x := by
        rw [max_eq_left hFx.1, min_eq_left hFx.2]
      have ha := abs_min_sub_min_le_max (max (F x) 0) (1 : ℝ) (max (f x) 0) 1
      simp only [sub_self, abs_zero, max_eq_left (abs_nonneg (max (F x) 0 - max (f x) 0)), hclip] at ha
      have hb := abs_max_sub_max_le_abs (F x) (f x) (0 : ℝ)
      change |F x - min (max (f x) 0) 1| ≤ |F x - f x|
      exact ha.trans hb
    _ ≤ ε := hf

/-- Unit-interval products are Lipschitz in each factor. -/
private theorem abs_mul_sub_mul_le_unit {a b c d : ℝ}
    (_ha : 0 ≤ a ∧ a ≤ 1) (hb : 0 ≤ b ∧ b ≤ 1)
    (hc : 0 ≤ c ∧ c ≤ 1) (_hd : 0 ≤ d ∧ d ≤ 1) :
    |a * b - c * d| ≤ |a - c| + |b - d| := by
  calc
    _ = |(a - c) * b + c * (b - d)| := by congr 1; ring
    _ ≤ |(a - c) * b| + |c * (b - d)| := abs_add_le _ _
    _ = |a - c| * b + c * |b - d| := by
      rw [abs_mul, abs_mul, abs_of_nonneg hb.1, abs_of_nonneg hc.1]
    _ ≤ |a - c| + |b - d| := by
      nlinarith [abs_nonneg (a - c), abs_nonneg (b - d)]

/-- L¹ approximation controls product expectations for unit-interval functions. -/
theorem abs_integral_mul_sub_le {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    {u v f g : Ω → ℝ} (hu : Integrable u P) (hv : Integrable v P)
    (hf : Integrable f P) (hg : Integrable g P)
    (huv : ∀ ω, 0 ≤ u ω ∧ u ω ≤ 1) (hvv : ∀ ω, 0 ≤ v ω ∧ v ω ≤ 1)
    (hfv : ∀ ω, 0 ≤ f ω ∧ f ω ≤ 1) (hgv : ∀ ω, 0 ≤ g ω ∧ g ω ≤ 1) :
    |(∫ ω, u ω * v ω ∂P) - (∫ ω, f ω * g ω ∂P)| ≤
      (∫ ω, |u ω - f ω| ∂P) + (∫ ω, |v ω - g ω| ∂P) := by
  have huv' : Integrable (fun ω => u ω * v ω) P := hu.mul_bdd hv.1
    (Filter.Eventually.of_forall fun ω => by rw [Real.norm_eq_abs, abs_of_nonneg (hvv ω).1]; exact (hvv ω).2)
  have hfg' : Integrable (fun ω => f ω * g ω) P := hf.mul_bdd hg.1
    (Filter.Eventually.of_forall fun ω => by rw [Real.norm_eq_abs, abs_of_nonneg (hgv ω).1]; exact (hgv ω).2)
  have hErr : Integrable (fun ω => |u ω - f ω| + |v ω - g ω|) P :=
    (hu.sub hf).abs.add (hv.sub hg).abs
  have hEq : (∫ ω, |u ω - f ω| ∂P) + (∫ ω, |v ω - g ω| ∂P) =
      ∫ ω, |u ω - f ω| + |v ω - g ω| ∂P := by
    simpa only [Pi.sub_apply] using (integral_add (hu.sub hf).abs (hv.sub hg).abs).symm
  rw [← integral_sub huv' hfg', hEq]
  rw [← Real.norm_eq_abs]
  exact norm_integral_le_of_norm_le hErr (Filter.Eventually.of_forall fun ω => by
    rw [Real.norm_eq_abs]
    exact abs_mul_sub_mul_le_unit (huv ω) (hvv ω) (hfv ω) (hgv ω))

/-- A measurable function valued in the unit interval is integrable on a finite measure space. -/
private theorem integrable_of_measurable_unit {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsFiniteMeasure P] {f : Ω → ℝ} (hf : Measurable f)
    (hbound : ∀ ω, 0 ≤ f ω ∧ f ω ≤ 1) : Integrable f P := by
  exact integrable_of_le_of_le hf.aestronglyMeasurable
    (Filter.Eventually.of_forall fun ω => (hbound ω).1)
    (Filter.Eventually.of_forall fun ω => (hbound ω).2)
    (integrable_const 0) (integrable_const 1)

/-- The integral of a unit-interval valued measurable function is a probability. -/
private theorem integral_mem_unit {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] {f : Ω → ℝ} (hf : Measurable f)
    (hbound : ∀ ω, 0 ≤ f ω ∧ f ω ≤ 1) :
    0 ≤ ∫ ω, f ω ∂P ∧ (∫ ω, f ω ∂P) ≤ 1 := by
  refine ⟨integral_nonneg (fun ω => (hbound ω).1), ?_⟩
  have h := integral_mono (integrable_of_measurable_unit P hf hbound)
    (integrable_const (1 : ℝ)) (fun ω => (hbound ω).2)
  simpa only [integral_const, Measure.real, measure_univ, ENNReal.toReal_one, one_smul] using h

/-- Factorization extends to indicators of finite-dimensional Borel sets. -/
theorem tendsto_indicator_cylinder_product {Ω I : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : I → Ω → ℝ)
    (hX : ∀ i, Measurable (X i)) (T : Ω → Ω) (hT : MeasurePreserving T P P)
    (hfact : cylinderFactorization P X T) {m k : ℕ} (a : Fin m → I) (b : Fin k → I)
    {S : Set (Fin m → ℝ)} {R : Set (Fin k → ℝ)} (hS : MeasurableSet S)
    (hR : MeasurableSet R) :
    Tendsto (fun n : ℕ => ∫ ω,
      S.indicator (fun _ => (1 : ℝ)) (fun i => X (a i) ω) *
      R.indicator (fun _ => (1 : ℝ)) (fun j => X (b j) ((T^[n]) ω)) ∂P) atTop
      (𝓝 ((∫ ω, S.indicator (fun _ => (1 : ℝ)) (fun i => X (a i) ω) ∂P) *
        (∫ ω, R.indicator (fun _ => (1 : ℝ)) (fun j => X (b j) ω) ∂P))) := by
  let U : Ω → Fin m → ℝ := fun ω i => X (a i) ω
  let V : Ω → Fin k → ℝ := fun ω i => X (b i) ω
  have hU : Measurable U := Measurable.of_eval fun i => hX (a i)
  have hV : Measurable V := Measurable.of_eval fun i => hX (b i)
  let s : (Fin m → ℝ) → ℝ := S.indicator (fun _ => (1 : ℝ))
  let r : (Fin k → ℝ) → ℝ := R.indicator (fun _ => (1 : ℝ))
  have hs : Measurable s := measurable_const.indicator hS
  have hr : Measurable r := measurable_const.indicator hR
  have hs1 : ∀ x, 0 ≤ s x ∧ s x ≤ 1 := by
    intro x
    by_cases hx : x ∈ S <;> simp [s, hx]
  have hr1 : ∀ x, 0 ≤ r x ∧ r x ≤ 1 := by
    intro x
    by_cases hx : x ∈ R <;> simp [r, hx]
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  have hδ : 0 < ε / 16 := by positivity
  let Q := P.map U
  let R' := P.map V
  let _ : IsFiniteMeasure Q := Measure.isFiniteMeasure_map P U
  let _ : IsFiniteMeasure R' := Measure.isFiniteMeasure_map P V
  obtain ⟨f, hf1, hferr⟩ := exists_unit_boundedContinuous_indicator_approx Q hS hδ
  obtain ⟨g, hg1, hgerr⟩ := exists_unit_boundedContinuous_indicator_approx R' hR hδ
  let u : Ω → ℝ := s ∘ U
  let v : Ω → ℝ := r ∘ V
  let f' : Ω → ℝ := f ∘ U
  let g' : Ω → ℝ := g ∘ V
  have hum : Measurable u := hs.comp hU
  have hvm : Measurable v := hr.comp hV
  have hfm : Measurable f' := f.continuous.measurable.comp hU
  have hgm : Measurable g' := g.continuous.measurable.comp hV
  have hu1 : ∀ ω, 0 ≤ u ω ∧ u ω ≤ 1 := fun ω => hs1 (U ω)
  have hv1 : ∀ ω, 0 ≤ v ω ∧ v ω ≤ 1 := fun ω => hr1 (V ω)
  have hf1' : ∀ ω, 0 ≤ f' ω ∧ f' ω ≤ 1 := fun ω => hf1 (U ω)
  have hg1' : ∀ ω, 0 ≤ g' ω ∧ g' ω ≤ 1 := fun ω => hg1 (V ω)
  have hui := integrable_of_measurable_unit P hum hu1
  have hvi := integrable_of_measurable_unit P hvm hv1
  have hfi := integrable_of_measurable_unit P hfm hf1'
  have hgi := integrable_of_measurable_unit P hgm hg1'
  have heU : (∫ ω, |u ω - f' ω| ∂P) ≤ ε / 16 := by
    have hm : AEStronglyMeasurable (fun x => ‖s x - f x‖) Q :=
      (hs.sub f.continuous.measurable).norm.aestronglyMeasurable
    rw [integral_map hU.aemeasurable hm] at hferr
    simpa only [u, f', s, Function.comp_apply, Real.norm_eq_abs] using hferr
  have heV : (∫ ω, |v ω - g' ω| ∂P) ≤ ε / 16 := by
    have hm : AEStronglyMeasurable (fun x => ‖r x - g x‖) R' :=
      (hr.sub g.continuous.measurable).norm.aestronglyMeasurable
    rw [integral_map hV.aemeasurable hm] at hgerr
    simpa only [v, g', r, Function.comp_apply, Real.norm_eq_abs] using hgerr
  have hdu : |(∫ ω, u ω ∂P) - ∫ ω, f' ω ∂P| ≤ ε / 16 := by
    rw [← integral_sub hui hfi]
    exact (abs_integral_le_integral_abs).trans heU
  have hdv : |(∫ ω, v ω ∂P) - ∫ ω, g' ω ∂P| ≤ ε / 16 := by
    rw [← integral_sub hvi hgi]
    exact (abs_integral_le_integral_abs).trans heV
  have hprod := abs_mul_sub_mul_le_unit (integral_mem_unit P hum hu1)
    (integral_mem_unit P hvm hv1) (integral_mem_unit P hfm hf1')
    (integral_mem_unit P hgm hg1')
  have hprod' : |(∫ ω, u ω ∂P) * (∫ ω, v ω ∂P) -
      (∫ ω, f' ω ∂P) * (∫ ω, g' ω ∂P)| ≤ ε / 8 := by linarith
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp (hfact m k a b f g) (ε / 2) (by positivity)
  refine ⟨N, fun n hn => ?_⟩
  have hN' := hN n hn
  rw [Real.dist_eq] at hN' ⊢
  have hnT := hT.iterate n
  have hvi' := integrable_of_measurable_unit P (hvm.comp hnT.measurable) (fun ω => hv1 _)
  have hgi' := integrable_of_measurable_unit P (hgm.comp hnT.measurable) (fun ω => hg1' _)
  have hdiff : (∫ ω, |v ((T^[n]) ω) - g' ((T^[n]) ω)| ∂P) =
      ∫ ω, |v ω - g' ω| ∂P := by
    have hh := integral_map (μ := P) hnT.measurable.aemeasurable (hvm.sub hgm).norm.aestronglyMeasurable
    rw [hnT.map_eq] at hh
    simpa only [Pi.sub_apply, Real.norm_eq_abs] using hh.symm
  have hclose := abs_integral_mul_sub_le P hui hvi' hfi hgi' hu1 (fun ω => hv1 _)
    hf1' (fun ω => hg1' _)
  simp only [Function.comp_apply] at hclose
  rw [hdiff] at hclose
  change |(∫ ω, u ω * v ((T^[n]) ω) ∂P) - (∫ ω, u ω ∂P) * (∫ ω, v ω ∂P)| < ε
  change |(∫ ω, f' ω * g' ((T^[n]) ω) ∂P) -
    (∫ ω, f' ω ∂P) * (∫ ω, g' ω ∂P)| < ε / 2 at hN'
  have htri := abs_sub_le (∫ ω, u ω * v ((T^[n]) ω) ∂P)
    (∫ ω, f' ω * g' ((T^[n]) ω) ∂P) ((∫ ω, u ω ∂P) * (∫ ω, v ω ∂P))
  have htri' := abs_sub_le (∫ ω, f' ω * g' ((T^[n]) ω) ∂P)
    ((∫ ω, f' ω ∂P) * (∫ ω, g' ω ∂P)) ((∫ ω, u ω ∂P) * (∫ ω, v ω ∂P))
  rw [abs_sub_comm] at hprod'
  linarith

/-- Factorization extends to events described by finite coordinate vectors. -/
theorem tendsto_measure_coordinate_events {Ω I : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : I → Ω → ℝ)
    (hX : ∀ i, Measurable (X i)) (T : Ω → Ω) (hT : MeasurePreserving T P P)
    (hfact : cylinderFactorization P X T) {m k : ℕ} (a : Fin m → I) (b : Fin k → I)
    {S : Set (Fin m → ℝ)} {R : Set (Fin k → ℝ)} (hS : MeasurableSet S)
    (hR : MeasurableSet R) :
    Tendsto (fun n : ℕ => P.real (((fun ω i => X (a i) ω) ⁻¹' S) ∩
      (T^[n]) ⁻¹' ((fun ω i => X (b i) ω) ⁻¹' R))) atTop
      (𝓝 (P.real ((fun ω i => X (a i) ω) ⁻¹' S) *
        P.real ((fun ω i => X (b i) ω) ⁻¹' R))) := by
  let U : Ω → Fin m → ℝ := fun ω i => X (a i) ω
  let V : Ω → Fin k → ℝ := fun ω i => X (b i) ω
  let A := U ⁻¹' S
  let B := V ⁻¹' R
  have hU : Measurable U := Measurable.of_eval fun i => hX (a i)
  have hV : Measurable V := Measurable.of_eval fun i => hX (b i)
  have hA : MeasurableSet A := hU hS
  have hB : MeasurableSet B := hV hR
  have h1 : (∫ ω, S.indicator (fun _ => (1 : ℝ)) (U ω) ∂P) = P.real A := by
    have he : (fun ω => S.indicator (fun _ => (1 : ℝ)) (U ω)) = A.indicator 1 := by
      funext ω
      by_cases hx : U ω ∈ S <;> simp [A, hx]
    rw [he, integral_indicator_one hA]
  have h2 : (∫ ω, R.indicator (fun _ => (1 : ℝ)) (V ω) ∂P) = P.real B := by
    have he : (fun ω => R.indicator (fun _ => (1 : ℝ)) (V ω)) = B.indicator 1 := by
      funext ω
      by_cases hx : V ω ∈ R <;> simp [B, hx]
    rw [he, integral_indicator_one hB]
  have h3 (n : ℕ) : (∫ ω, S.indicator (fun _ => (1 : ℝ)) (U ω) *
      R.indicator (fun _ => (1 : ℝ)) (V ((T^[n]) ω)) ∂P) =
      P.real (A ∩ (T^[n]) ⁻¹' B) := by
    have he : (fun ω => S.indicator (fun _ => (1 : ℝ)) (U ω) *
        R.indicator (fun _ => (1 : ℝ)) (V ((T^[n]) ω))) =
        (A ∩ (T^[n]) ⁻¹' B).indicator 1 := by
      funext ω
      by_cases hx : U ω ∈ S <;> by_cases hy : V ((T^[n]) ω) ∈ R <;>
        simp [A, B, hx, hy]
    rw [he, integral_indicator_one (hA.inter ((hT.iterate n).measurable hB))]
  have hh := tendsto_indicator_cylinder_product P X hX T hT hfact a b hS hR
  change Tendsto (fun n : ℕ => ∫ ω, S.indicator (fun _ => (1 : ℝ)) (U ω) *
    R.indicator (fun _ => (1 : ℝ)) (V ((T^[n]) ω)) ∂P) atTop
    (𝓝 ((∫ ω, S.indicator (fun _ => (1 : ℝ)) (U ω) ∂P) *
      (∫ ω, R.indicator (fun _ => (1 : ℝ)) (V ω) ∂P))) at hh
  simp only [h3, h1, h2] at hh
  exact hh

/-- A measurable cylinder can be presented using a `Fin m` coordinate list. -/
theorem measurableCylinder_eq_fin_preimage {I : Type*} {C : Set (I → ℝ)}
    (hC : C ∈ measurableCylinders (fun _ : I => ℝ)) :
    ∃ (m : ℕ) (a : Fin m → I) (S : Set (Fin m → ℝ)), MeasurableSet S ∧
      C = (fun x i => x (a i)) ⁻¹' S := by
  classical
  obtain ⟨s, B, hB, rfl⟩ := (mem_measurableCylinders C).mp hC
  let e : ↥s ≃ Fin (Fintype.card ↥s) := Fintype.equivFin ↥s
  let a : Fin (Fintype.card ↥s) → I := fun i => (e.symm i).1
  let F : (Fin (Fintype.card ↥s) → ℝ) → (↥s → ℝ) := fun x i => x (e i)
  refine ⟨Fintype.card ↥s, a, F ⁻¹' B, ?_, ?_⟩
  · exact (Measurable.of_eval fun i => measurable_pi_apply (e i)) hB
  · ext x
    simp only [mem_cylinder, Set.mem_preimage]
    have he : s.restrict x = F (fun i => x (a i)) := by
      funext i
      simp only [F, a, Finset.restrict, Equiv.symm_apply_apply]
    rw [he]

/-- The bounded continuous cylinder premise implies mixing for all events in
the coordinate sigma-algebra. -/
theorem coordinateSigmaMixing_of_cylinderFactorization {Ω I : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : I → Ω → ℝ)
    (hX : ∀ i, Measurable (X i)) (T : Ω → Ω) (hT : MeasurePreserving T P P)
    (hfact : cylinderFactorization P X T) : coordinateSigmaMixing P X T := by
  apply coordinateSigmaMixing_of_cylinder_events P X hX T hT
  intro C D hC hD
  obtain ⟨m, a, S, hS, rfl⟩ := measurableCylinder_eq_fin_preimage hC
  obtain ⟨k, b, R, hR, rfl⟩ := measurableCylinder_eq_fin_preimage hD
  simpa only [Set.preimage_preimage, Function.comp_def] using
    (tendsto_measure_coordinate_events P X hX T hT hfact a b hS hR)

/-- Continuous finite-coordinate factorization implies event mixing in the
sigma-algebra generated by the coordinates. -/
theorem tendsto_measure_inter_preimage_iterate_of_cylinderFactorization
    {Ω I : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (X : I → Ω → ℝ) (hX : ∀ i, Measurable (X i)) (T : Ω → Ω)
    (hT : MeasurePreserving T P P)
    (hfact : ∀ (m k : ℕ) (a : Fin m → I) (b : Fin k → I)
      (f : BoundedContinuousFunction (Fin m → ℝ) ℝ)
      (g : BoundedContinuousFunction (Fin k → ℝ) ℝ),
      Tendsto (fun n : ℕ => ∫ ω, f (fun i => X (a i) ω) *
        g (fun j => X (b j) ((T^[n]) ω)) ∂P) atTop
        (𝓝 ((∫ ω, f (fun i => X (a i) ω) ∂P) *
          (∫ ω, g (fun j => X (b j) ω) ∂P))))
    {A B : Set Ω} (hA : MeasurableSet[coordinateSigma X] A)
    (hB : MeasurableSet[coordinateSigma X] B) :
    Tendsto (fun n : ℕ => (P (A ∩ (T^[n]) ⁻¹' B)).toReal) atTop
      (𝓝 ((P A).toReal * (P B).toReal)) :=
  coordinateSigmaMixing_of_cylinderFactorization P X hX T hT hfact A B hA hB

/-- Exact formulation of the generic extension. -/
theorem cylinderMixingExtensionStatement_holds {Ω I : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : I → Ω → ℝ) (T : Ω → Ω) :
    cylinderMixingExtensionStatement P X T :=
  fun hX hT hfact => coordinateSigmaMixing_of_cylinderFactorization P X hX T hT hfact

