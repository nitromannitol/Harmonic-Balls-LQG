import Mathlib
import HarmonicBalls.Defs.GFF
import HarmonicBalls.Defs.Notation

/-! # The γ-LQG metric

Section 2.2 of Bou-Rabee and Gwynne, *Harmonic balls in Liouville quantum gravity* (arXiv:2208.11795),
paper/lqg_harmonic_ball-corrected.tex, lines 420-466.

## Deterministic metric notions (for a function `D : ℂ → ℂ → ℝ`)

* `curveLength D p a b`: the `D`-length of a curve `p : ℝ → ℂ` on `[a, b]` (supremum over partitions);
  `pathLength D P = len(P; D)` for a Euclidean-continuous path `P : Path z w` (line 424).
* `internalMetric D U z w = D(z, w; U)`, the infimum of `len(P; D)` over paths `P` from `z` to `w` in `U`
  (eq:internal-metric, line 428), valued in `[0, ∞]` (`= ∞` if no path in `U` joins `z` to `w`). The paper uses
  it for open sets `U` (Fact 2.2 II) and for closed sets (lines 2963-3028), so `U` is an arbitrary set.
* `setDist D A B = D(A, B) = inf_{x ∈ A, y ∈ B} D(x, y)` (eq:set-dist, line 461).
* `lqgMetricBall D z s = 𝓑_s(z; D)`, the open metric ball (line 3157).
* `IsEuclideanLengthMetric D`: `D` is a metric on `ℂ` inducing the Euclidean topology, and a length metric
  (Fact 2.2 I, line 435).
* `weylScaling D ξ f = e^{ξ f} · D`, `(u, v) ↦ inf_P ∫_0^{len(P; D)} e^{ξ f(P(t))} dt` over paths `P` from `u`
  to `v` parametrized by `D`-length (Fact 2.2 III, line 445).

## Fields and the LQG metric

As in `Defs/GFF.lean`, a generalized function is represented by its pairing functional `T : (ℂ → ℝ) → ℝ`
(`T φ = (h, φ)`, meaningful for test functions `φ`). Following Gwynne-Miller 2021 (GM21: *Existence and
uniqueness of the Liouville quantum gravity metric for γ ∈ (0, 2)*, Invent. Math. 223, arXiv:1905.00383),
Section 1.2, p. 6 (unnumbered definition), a γ-LQG metric is a deterministic map
`𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ`, `h ↦ D_h`, measurable for the σ-algebra generated by the pairings with test
functions, such that whenever `h` is a whole-plane GFF plus a continuous function, `D_h` satisfies the axioms
I-IV of Fact 2.2 (lines 432-453): `SatisfiesLQGMetricAxioms` and `IsLQGMetric γ ξ 𝔇`. Here `ξ = γ / d_γ`
(eq:xi, line 440; GM21 (1.5), p. 4) and `Q = 2/γ + γ/2` (`lqgQ`, eq:Q). By GM21, Theorem 1.2 (p. 6), such a
map exists and is unique up to a deterministic positive multiplicative constant; the constant is harmless for
the statements of the paper (e.g. the family of LQG metric balls `lqgMetricBall (C • D_h) 0 s`, `s > 0`, does
not depend on `C > 0`).

The field of the paper is `h = h^ℂ - α₀ log |·|` (eq:gff, line 380). For `α₀ ≠ 0` it is not a whole-plane GFF
plus a continuous function, and `D_h` is defined from `D_{h^ℂ}` by Weyl scaling with the function
`-α₀ log |·|`, which is continuous on `ℂ ∖ {0}` (Dubédat-Falconet-Gwynne-Pfeffer-Sun 2020, p. 9; GM21,
Remark 1.5, p. 8): `IsLQGMetricOfField P γ ξ α₀ hC D` (see its docstring). The axioms of Fact 2.2 for this
field are literature inputs, staged in `HarmonicBalls/Proposed/LQG.lean`.
-/

namespace HarmonicBalls

open MeasureTheory Set
open scoped ENNReal NNReal

/-! ### Lengths of paths, internal metrics, metric balls -/

/-- The `D`-length of the curve `p : ℝ → ℂ` on the parameter interval `[a, b]`: the supremum over finite monotone
sequences `a ≤ t₀ ≤ t₁ ≤ ... ≤ tₙ ≤ b` of `∑ D(p(tᵢ₊₁), p(tᵢ))` (line 424). For `D = dist` this is
`eVariationOn p (Icc a b)` (`curveLength_dist`). -/
noncomputable def curveLength (D : ℂ → ℂ → ℝ) (p : ℝ → ℂ) (a b : ℝ) : ℝ≥0∞ :=
  ⨆ q : ℕ × { u : ℕ → ℝ // Monotone u ∧ ∀ i, u i ∈ Icc a b },
    ∑ i ∈ Finset.range q.1, ENNReal.ofReal (D (p (q.2.1 (i + 1))) (p (q.2.1 i)))

/-- `len(P; D)`, the `D`-length of a Euclidean-continuous path `P` from `z` to `w` (line 424). -/
noncomputable def pathLength (D : ℂ → ℂ → ℝ) {z w : ℂ} (P : Path z w) : ℝ≥0∞ :=
  curveLength D P.extend 0 1

/-- The internal metric `D(z, w; U) = inf {len(P; D) : P is a path from z to w in U}` (eq:internal-metric,
line 428), with value `∞` when no path in `U` joins `z` to `w`. -/
noncomputable def internalMetric (D : ℂ → ℂ → ℝ) (U : Set ℂ) (z w : ℂ) : ℝ≥0∞ :=
  ⨅ (P : Path z w) (_ : ∀ t, P t ∈ U), pathLength D P

/-- The distance `D(A, B) = inf_{x ∈ A, y ∈ B} D(x, y)` between two sets (eq:set-dist, line 461). It is the
infimum of the image `{D x y | x ∈ A, y ∈ B}`, which is bounded below when `D ≥ 0`; the value for empty `A` or `B`
is a junk value. -/
noncomputable def setDist (D : ℂ → ℂ → ℝ) (A B : Set ℂ) : ℝ :=
  sInf (image2 D A B)

/-- The open metric ball `𝓑_s(z; D) = {w : D(z, w) < s}` (line 3157); for `D = D_h` the open LQG metric ball of
radius `s` centered at `z`. -/
def lqgMetricBall (D : ℂ → ℂ → ℝ) (z : ℂ) (s : ℝ) : Set ℂ :=
  {w | D z w < s}

/-- `D` is a metric on `ℂ` which induces the Euclidean topology and is a length metric: `D(z, w)` is the infimum of
the `D`-lengths of (Euclidean-continuous) paths from `z` to `w` (Fact 2.2 I, line 435). -/
structure IsEuclideanLengthMetric (D : ℂ → ℂ → ℝ) : Prop where
  /-- `D(z, z) = 0`. -/
  self_eq_zero : ∀ z, D z z = 0
  /-- `D` separates points. -/
  eq_of_eq_zero : ∀ z w, D z w = 0 → z = w
  /-- `D` is symmetric. -/
  symm : ∀ z w, D z w = D w z
  /-- The triangle inequality. -/
  triangle : ∀ x y z, D x z ≤ D x y + D y z
  /-- The `D`-open sets are the Euclidean open sets. -/
  isOpen_iff : ∀ U : Set ℂ, IsOpen U ↔ ∀ z ∈ U, ∃ ε > 0, ∀ w, D z w < ε → w ∈ U
  /-- Length metric: `D(z, w) = D(z, w; ℂ)`. -/
  ofReal_eq_internalMetric : ∀ z w, ENNReal.ofReal (D z w) = internalMetric D univ z w

/-! ### Weyl scaling -/

/-- The curve `p` is parametrized by `D`-length on `[0, T]`: it is Euclidean-continuous on `[0, T]` and the
`D`-length of `p|_{[s, t]}` is `t - s` for `0 ≤ s ≤ t ≤ T` (Fact 2.2 III, line 445). -/
def IsLengthParametrized (D : ℂ → ℂ → ℝ) (p : ℝ → ℂ) (T : ℝ) : Prop :=
  0 ≤ T ∧ ContinuousOn p (Icc 0 T) ∧
    ∀ s t, 0 ≤ s → s ≤ t → t ≤ T → curveLength D p s t = ENNReal.ofReal (t - s)

/-- The Weyl scaling `e^{ξ f} · D` of `D` by `f` (Fact 2.2 III, line 445; GM21, (1.8), p. 6):
`(u, v) ↦ inf_P ∫_0^{len(P; D)} e^{ξ f(P(t))} dt`, the infimum over paths `P` from `u` to `v` parametrized by
`D`-length (so that `len(P; D) = T` for `P : [0, T] → ℂ`). The integral is a lower Lebesgue integral in `[0, ∞]`, so
it is meaningful for weights which are not integrable along the path (e.g. `f = -α₀ log |·|`). -/
noncomputable def weylScaling (D : ℂ → ℂ → ℝ) (ξ : ℝ) (f : ℂ → ℝ) (u v : ℂ) : ℝ≥0∞ :=
  ⨅ (T : ℝ) (p : ℝ → ℂ) (_ : IsLengthParametrized D p T) (_ : p 0 = u) (_ : p T = v),
    ∫⁻ t in Icc 0 T, ENNReal.ofReal (Real.exp (ξ * f (p t)))

/-! ### Fields as pairing functionals -/

/-- The σ-algebra on the space `(ℂ → ℝ) → ℝ` of pairing functionals generated by the pairings `T ↦ T φ` with test
functions `φ`; the analogue of the Borel σ-algebra of the space of distributions (GM21,
Section 1.2, p. 6, requires `h ↦ D_h` to be measurable for the Borel σ-algebra of distributions). -/
@[instance_reducible]
noncomputable def distributionMeasurableSpace : MeasurableSpace ((ℂ → ℝ) → ℝ) :=
  ⨆ (φ : ℂ → ℝ) (_ : IsTestFunction univ φ), MeasurableSpace.comap (fun T => T φ) inferInstance

/-- The pairing functional of `h + f` for a function `f : ℂ → ℝ`: `(h + f, φ) = (h, φ) + ∫ f φ` (line 430). -/
noncomputable def addFunPairing (T : (ℂ → ℝ) → ℝ) (f : ℂ → ℝ) : (ℂ → ℝ) → ℝ :=
  fun φ => T φ + ∫ x, f x * φ x

/-- The pairing functional of `h(r · + z)` for `r > 0`, `z ∈ ℂ` (Fact 2.2 IV, line 451):
`(h(r · + z), φ) = ∫ h(r x + z) φ(x) dx = r⁻² (h, φ((· - z) / r))`. -/
noncomputable def affinePullbackPairing (T : (ℂ → ℝ) → ℝ) (r : ℝ) (z : ℂ) : (ℂ → ℝ) → ℝ :=
  fun φ => (r ^ 2)⁻¹ * T fun y => φ ((y - z) / r)

/-- The σ-algebra `σ(h|_U)` of a random generalized function `h : Ω → (ℂ → ℝ) → ℝ` (pairing functionals),
generated by the pairings `(h, φ)` with test functions `φ` with `tsupport φ ⊆ U` (Fact 2.2 II, line 437). For the
field of the paper it is `fieldSigmaAlgebra` (`fieldSigmaAlgebra_eq_pairingSigmaAlgebra`). -/
@[instance_reducible]
noncomputable def pairingSigmaAlgebra {Ω : Type*} (h : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) : MeasurableSpace Ω :=
  ⨆ (φ : ℂ → ℝ) (_ : IsTestFunction U φ), MeasurableSpace.comap (fun ω => h ω φ) inferInstance

/-! ### The axioms of the LQG metric -/

/-- The axioms I-IV of Fact 2.2 (lines 432-453; GM21, Section 1.2, p. 6) for the metric `D_h = 𝔇 (h ω)`
of a random generalized function `h` on `(Ω, P)`, given a map `𝔇 : h ↦ D_h`:
* I (Euclidean topology and length metric): a.s. `D_h` is a length metric inducing the Euclidean topology;
* II (locality): for each deterministic open `U`, the internal metric `D_h(·, ·; U)` is a.s. equal to a function of
  `h|_U`, i.e. to a random function `G` whose values are `σ(h|_U)`-measurable;
* III (Weyl scaling): a.s., for every continuous `f`, `D_{h+f} = e^{ξ f} · D_h`;
* IV (coordinate change for scaling and translation): for each `r > 0` and `z ∈ ℂ`, a.s.
  `D_h(r u + z, r v + z) = D_{h(r · + z) + Q log r}(u, v)` for all `u, v`. -/
structure SatisfiesLQGMetricAxioms {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (γ ξ : ℝ)
    (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) (h : Ω → (ℂ → ℝ) → ℝ) : Prop where
  /-- I. Euclidean topology and length metric. -/
  ae_isEuclideanLengthMetric : ∀ᵐ ω ∂P, IsEuclideanLengthMetric (𝔇 (h ω))
  /-- II. Locality. -/
  locality : ∀ U : Set ℂ, IsOpen U → ∃ G : Ω → ℂ → ℂ → ℝ≥0∞,
    (∀ z w, Measurable[pairingSigmaAlgebra h U] fun ω => G ω z w) ∧
      ∀ᵐ ω ∂P, ∀ z ∈ U, ∀ w ∈ U, internalMetric (𝔇 (h ω)) U z w = G ω z w
  /-- III. Weyl scaling. -/
  ae_weylScaling : ∀ᵐ ω ∂P, ∀ f : ℂ → ℝ, Continuous f → ∀ u v,
    ENNReal.ofReal (𝔇 (addFunPairing (h ω) f) u v) = weylScaling (𝔇 (h ω)) ξ f u v
  /-- IV. Coordinate change for scaling and translation. -/
  coordChange : ∀ r : ℝ, 0 < r → ∀ z : ℂ, ∀ᵐ ω ∂P, ∀ u v : ℂ,
    𝔇 (h ω) (r * u + z) (r * v + z) =
      𝔇 (addFunPairing (affinePullbackPairing (h ω) r z) fun _ => lqgQ γ * Real.log r) u v

/-- `𝔇 : h ↦ D_h` is a γ-LQG metric with Weyl exponent `ξ` (GM21, Section 1.2, p. 6, unnumbered definition;
Fact 2.2, lines 432-457; `ξ = γ / d_γ`, eq:xi, line 440): `𝔇` is measurable for
`distributionMeasurableSpace`, and whenever `h = h^ℂ + f` with `h^ℂ` a whole-plane GFF (`IsWholePlaneGFF`)
and `f` a (measurable) random continuous function on the same probability space, `D_h` satisfies the axioms
I-IV (`SatisfiesLQGMetricAxioms`). The whole-plane GFF in
other normalizations is covered, since it differs from `h^ℂ` by a random constant. GM21 also require `D_T` to be a
Euclidean-continuous metric for every distribution `T` and `T ↦ D_T` to be Borel for the local uniform topology;
here `D_h` is a metric a.s. for the relevant fields (axiom I), and measurability is that of the evaluations.

The Weyl exponent is a parameter: GM21 fix `ξ = γ / d_γ` ((1.5), p. 4), `d_γ` being the exponent of
Ding-Gwynne 2018, which is the Hausdorff dimension of `(ℂ, D_h)` (Gwynne-Pfeffer, *KPZ formulas for the Liouville
quantum gravity metric*, arXiv:1905.11790, Corollary 1.7, p. 7).

By GM21, Theorem 1.2 (p. 6), for `γ ∈ (0, 2)` and `ξ = γ / d_γ` such a map exists, and any two are a.s.
equal up to a deterministic positive constant on every whole-plane GFF plus a continuous function. Probability
spaces are taken in `Type`; this is no restriction, since the axioms only involve the joint law of the field and
the metric. -/
structure IsLQGMetric (γ ξ : ℝ) (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) : Prop where
  /-- `h ↦ D_h(z, w)` is measurable for the σ-algebra generated by the pairings with test functions. -/
  measurable_apply : ∀ z w, Measurable[distributionMeasurableSpace] fun T => 𝔇 T z w
  /-- The axioms I-IV hold for every whole-plane GFF plus a random continuous function. -/
  satisfiesLQGMetricAxioms : ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) (hC : Ω → (ℂ → ℝ) → ℝ)
    (hcirc : Ω → ℝ → ℂ → ℝ) (f : Ω → ℂ → ℝ), IsWholePlaneGFF P hC hcirc → (∀ ω, Continuous (f ω)) →
    (∀ x, Measurable fun ω => f ω x) → SatisfiesLQGMetricAxioms P γ ξ 𝔇 fun ω => addFunPairing (hC ω) (f ω)

/-- `D = D_h`, the γ-LQG metric (Section 2.2, lines 418-457) of the field `h = h^ℂ - α₀ log |·|` of the paper
(eq:gff, line 380), where `hC ω` are the pairings of the whole-plane GFF `h^ℂ` (`IsWholePlaneGFF`): for some γ-LQG
metric `𝔇` with Weyl exponent `ξ` (`IsLQGMetric`), a.s. `D_h = e^{-ξ α₀ log |·|} · D_{h^ℂ}`, i.e. for all `u, v`,
`D_h(u, v) = inf_P ∫_0^{len(P; D_{h^ℂ})} |P(t)|^{-ξ α₀} dt` over paths `P` from `u` to `v` parametrized by
`D_{h^ℂ}`-length (with `D_h ≥ 0`, so that `D_h` is pinned down exactly by the formula).

The Weyl scaling formula is how the metric of a whole-plane GFF plus a log singularity is defined in the literature:
`D_{h - α log |·|} = |·|^{-α ξ} · D_h` on `ℂ ∖ {0}`, extended to `ℂ` by infima of path lengths
(Dubédat-Falconet-Gwynne-Pfeffer-Sun 2020, *Weak LQG metrics and Liouville first passage percolation*, PTRF 178,
arXiv:1905.00380, p. 9; GM21, Remark 1.5, p. 8). Here the infimum is taken directly over paths in `ℂ`
(`-α₀ log |·|` is continuous on `ℂ ∖ {0}`; the value of the weight at the single point `0` does not affect the
integral, a path parametrized by length spending zero Lebesgue time at a point). The Prop requires `D_h` to be
finite, which holds a.s. for `α₀ < Q` (DFGPS20, Theorem 1.10, p. 10, and Proposition 3.17, p. 43; line 373) and
fails for `α₀ > Q`, so statements using it assume `0 < γ < 2` and
`α₀ < lqgQ γ`. By the uniqueness of `𝔇` (GM21, Theorem 1.2), `D_h` is determined up to a
deterministic positive multiplicative constant. For `α₀ = 0` it is `D_{h^ℂ} = 𝔇 (hC ω)` (Weyl scaling by `0`). -/
def IsLQGMetricOfField {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (γ ξ α₀ : ℝ)
    (hC : Ω → (ℂ → ℝ) → ℝ) (D : Ω → ℂ → ℂ → ℝ) : Prop :=
  ∃ 𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ, IsLQGMetric γ ξ 𝔇 ∧ ∀ᵐ ω ∂P, ∀ u v, 0 ≤ D ω u v ∧
    ENNReal.ofReal (D ω u v) = weylScaling (𝔇 (hC ω)) ξ (fun x => -α₀ * Real.log ‖x‖) u v

/-! ### Sanity checks -/

/-- For the Euclidean metric, `curveLength` is Mathlib's variation `eVariationOn`. -/
theorem curveLength_dist (p : ℝ → ℂ) (a b : ℝ) :
    curveLength (fun z w => dist z w) p a b = eVariationOn p (Icc a b) := by
  simp only [curveLength, eVariationOn, edist_dist]

/-- The internal metric is antitone in the domain. -/
theorem internalMetric_anti (D : ℂ → ℂ → ℝ) {U V : Set ℂ} (hUV : U ⊆ V) (z w : ℂ) :
    internalMetric D V z w ≤ internalMetric D U z w :=
  iInf_mono fun _ => iInf_mono' fun hP => ⟨fun t => hUV (hP t), le_rfl⟩

/-- The distance between two singletons is the distance between the points. -/
theorem setDist_singleton (D : ℂ → ℂ → ℝ) (x y : ℂ) : setDist D {x} {y} = D x y := by
  simp [setDist]

/-- The center lies in every metric ball of positive radius. -/
theorem mem_lqgMetricBall_self {D : ℂ → ℂ → ℝ} {z : ℂ} {s : ℝ} (hD : D z z = 0) (hs : 0 < s) :
    z ∈ lqgMetricBall D z s := by
  simpa [lqgMetricBall, hD] using hs

/-- The Euclidean metric is a length metric: `|z - w| = inf len(P; |·|)`, attained by the segment. -/
theorem internalMetric_dist_univ (z w : ℂ) :
    internalMetric (fun z w => dist z w) univ z w = ENNReal.ofReal (dist z w) := by
  apply le_antisymm
  · refine (iInf₂_le (Path.segment z w) fun _ => mem_univ _).trans ?_
    rw [pathLength, curveLength_dist, eVariationOn.eq_of_eqOn (Path.eqOn_extend_segment z w)]
    have hL : LipschitzWith (nndist z w) (AffineMap.lineMap z w : ℝ → ℂ) :=
      lipschitzWith_lineMap z w
    calc eVariationOn (AffineMap.lineMap z w : ℝ → ℂ) (Icc 0 1)
        = eVariationOn ((AffineMap.lineMap z w : ℝ → ℂ) ∘ id) (Icc 0 1) := rfl
      _ ≤ nndist z w * eVariationOn (id : ℝ → ℝ) (Icc 0 1) :=
          (hL.lipschitzOnWith (s := univ)).comp_eVariationOn_le (mapsTo_univ _ _)
      _ ≤ nndist z w * ENNReal.ofReal (1 - 0) := by
          gcongr
          simp
      _ = ENNReal.ofReal (dist z w) := by
          rw [sub_zero, ENNReal.ofReal_one, mul_one, ← edist_nndist, edist_dist]
  · refine le_iInf₂ fun P _ => ?_
    rw [pathLength, curveLength_dist]
    have := eVariationOn.edist_le P.extend (s := Icc (0 : ℝ) 1)
      (left_mem_Icc.2 zero_le_one) (right_mem_Icc.2 zero_le_one)
    simpa [edist_dist, dist_comm] using this

/-- The Euclidean metric satisfies Fact 2.2 I: it is a length metric inducing the Euclidean topology. -/
theorem isEuclideanLengthMetric_dist : IsEuclideanLengthMetric fun z w => dist z w where
  self_eq_zero := dist_self
  eq_of_eq_zero _ _ := dist_eq_zero.1
  symm := dist_comm
  triangle := dist_triangle
  isOpen_iff U := by
    rw [Metric.isOpen_iff]
    refine forall₂_congr fun z _ => exists_congr fun ε => and_congr_right fun _ => ?_
    simp [Set.subset_def, Metric.mem_ball, dist_comm]
  ofReal_eq_internalMetric z w := (internalMetric_dist_univ z w).symm

/-- The Euclidean length of a curve dominates the distance between its endpoints. -/
theorem edist_le_curveLength_dist (p : ℝ → ℂ) {s t : ℝ} (hst : s ≤ t) :
    edist (p t) (p s) ≤ curveLength (fun z w => dist z w) p s t := by
  rw [curveLength_dist]
  exact eVariationOn.edist_le p (right_mem_Icc.2 hst) (left_mem_Icc.2 hst)

/-- Non-vacuity of `weylScaling`: Weyl scaling of the Euclidean metric by `f = 0` is the Euclidean metric (the
infimum is attained by the segment parametrized by arc length). -/
theorem weylScaling_dist_zero (ξ : ℝ) (u v : ℂ) :
    weylScaling (fun z w => dist z w) ξ 0 u v = ENNReal.ofReal (dist u v) := by
  have hint : ∀ T : ℝ, 0 ≤ T → ∀ p : ℝ → ℂ,
      ∫⁻ t in Icc 0 T, ENNReal.ofReal (Real.exp (ξ * (0 : ℂ → ℝ) (p t))) = ENNReal.ofReal T := by
    intro T _ p
    simp
  apply le_antisymm
  · set T := dist u v with hT
    let p : ℝ → ℂ := fun t => AffineMap.lineMap u v (t / T)
    have hiso : ∀ a b, edist (p a) (p b) = if u = v then 0 else edist a b := by
      intro a b
      split_ifs with huv
      · simp [p, huv]
      · have hT0 : T ≠ 0 := dist_ne_zero.2 huv
        rw [edist_dist, edist_dist, dist_lineMap_lineMap, Real.dist_eq, Real.dist_eq, ← sub_div,
          abs_div, abs_of_pos (dist_pos.2 huv), div_mul_cancel₀ _ hT0]
    have hpar : IsLengthParametrized (fun z w => dist z w) p T := by
      refine ⟨dist_nonneg, by fun_prop, fun s t _ hst _ => ?_⟩
      rw [curveLength_dist]
      by_cases huv : u = v
      · have : eVariationOn p (Icc s t) = 0 := by
          refine eVariationOn.constant_on ?_
          rintro _ ⟨a, -, rfl⟩ _ ⟨b, -, rfl⟩
          simp [p, huv]
        rw [this]
        have hTz : T = 0 := by simp [hT, huv]
        have : t - s = 0 := by linarith
        simp [this]
      · have h1 : eVariationOn p (Icc s t) = eVariationOn (id : ℝ → ℝ) (Icc s t) := by
          simp only [eVariationOn, hiso, huv, ↓reduceIte, id]
        rw [h1]
        simp
    have hp0 : p 0 = u := by simp [p]
    have hpT : p T = v := by
      by_cases huv : u = v
      · simp [p, huv]
      · have hT0 : T ≠ 0 := dist_ne_zero.2 huv
        simp only [p, div_self hT0, AffineMap.lineMap_apply_one]
    refine (iInf₂_le T p).trans ((iInf₂_le hpar hp0).trans ((iInf_le _ hpT).trans ?_))
    rw [hint T dist_nonneg]
  · refine le_iInf fun T => le_iInf fun p => le_iInf fun hp => le_iInf fun hp0 => le_iInf fun hpT => ?_
    rw [hint T hp.1, ← hp0, ← hpT, ← edist_dist, edist_comm]
    have := edist_le_curveLength_dist p hp.1
    rwa [hp.2.2 0 T le_rfl hp.1 le_rfl, sub_zero] at this

/-- `fieldSigmaAlgebra α₀ hC U = σ(h|_U)` is the σ-algebra `pairingSigmaAlgebra` of the field
`h = h^ℂ - α₀ log |·|`. -/
theorem fieldSigmaAlgebra_eq_pairingSigmaAlgebra {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    fieldSigmaAlgebra α₀ hC U = pairingSigmaAlgebra (fun ω => fieldPairing α₀ (hC ω)) U :=
  rfl

end HarmonicBalls
