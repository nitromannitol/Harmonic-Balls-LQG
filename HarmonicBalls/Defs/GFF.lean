import Mathlib
import HarmonicBalls.Defs.Laplacian

/-! # The whole-plane Gaussian free field

Section 2.1 of Bou-Rabee and Gwynne, *Harmonic balls in Liouville quantum gravity* (arXiv:2208.11795),
paper/lqg_harmonic_ball-corrected.tex, lines 355-387.

* `wholePlaneCov z w = log (max(|z|,1) max(|w|,1) / |z - w|)`: the covariance kernel (eq:cov-kernel, line 359).
* `GFFObservable`: the observables of the field used in the paper, namely the pairing `(h, φ)` with a smooth
  compactly supported test function `φ` and the circle average `h_r(z)` (line 362).
* `IsWholePlaneGFF P hC hcirc`: `hC : Ω → (ℂ → ℝ) → ℝ` (pairings `ω ↦ (h^ℂ, φ)`) together with
  `hcirc : Ω → ℝ → ℂ → ℝ` (circle averages `ω ↦ h^ℂ_r(z)`) is the whole-plane GFF normalized so that
  `h^ℂ_1(0) = 0`: every finite family of observables is a centered Gaussian vector with covariance given by the
  kernel integrated against `φ(x) dx` and the uniform measure on `∂B_r(z)`, and the circle average process
  `(r, z) ↦ h^ℂ_r(z)` is a.s. continuous on `(0, ∞) × ℂ` (Duplantier-Sheffield 2011, Prop. 3.1).
* `fieldPairing`, `fieldCircleAverage`: the field `h = h^ℂ - α₀ log |·|` of the paper (eq:gff, line 380).
* `fieldSigmaAlgebra α₀ hC U`: the σ-algebra `σ(h|_U)` generated by the pairings of `h` with test functions
  supported in `U` (used by Prop. 1.3 and Fact 2.1 II).

Test functions are those of `HarmonicBalls/Defs/Laplacian.lean`: `IsTestFunction U φ` (smooth, compactly supported,
`tsupport φ ⊆ U`); the pairings of the whole-plane field use `U = Set.univ`.

Normalization (line 365): the covariance pins down `h^ℂ_1(0) = 0`. Indeed for `|x| = |y| = 1` the kernel is
`-log |x - y|`, whose average over `y ∈ ∂B_1(0)` vanishes (Mathlib's `circleAverage_log_norm_sub_const₁`), so the
variance of `h^ℂ_1(0)` is `0` (`wholePlaneGFFCov_circle_one_zero`) and `h^ℂ_1(0) = 0` a.s.
(`IsWholePlaneGFF.ae_circleAverage_one_zero`).
-/

namespace HarmonicBalls

open MeasureTheory ProbabilityTheory

/-- The covariance kernel of the whole-plane GFF normalized so that its average over the unit circle vanishes,
`Cov(h^ℂ(z), h^ℂ(w)) = log (max(|z|,1) max(|w|,1) / |z - w|)` (eq:cov-kernel, line 359). On the diagonal `z = w`
the paper's value `+∞` is replaced by the junk value `log (·/0) = 0`; the diagonal is Lebesgue-null for every
smearing measure used below (Lebesgue measure and uniform measure on circles), so it does not affect
`wholePlaneGFFCov`. -/
noncomputable def wholePlaneCov (z w : ℂ) : ℝ :=
  Real.log (max ‖z‖ 1 * max ‖w‖ 1 / ‖z - w‖)

/-- The observables of a random generalized function on `ℂ` used in the paper: the pairing with a test function
`φ`, and the circle average over `∂B_r(z)` (line 362; Duplantier-Sheffield 2011, Section 3.1). -/
inductive GFFObservable
  /-- The pairing `(h, φ)` with a function `φ : ℂ → ℝ` (admissible when `φ` is a test function). -/
  | pairing (φ : ℂ → ℝ)
  /-- The circle average `h_r(z)` (admissible when `r > 0`). -/
  | circle (r : ℝ) (z : ℂ)

namespace GFFObservable

/-- An observable is admissible if its test function is smooth and compactly supported, resp. its radius is
positive. -/
def IsAdmissible : GFFObservable → Prop
  | pairing φ => IsTestFunction Set.univ φ
  | circle r _ => 0 < r

/-- The value of an observable on a sample `(hC, hcirc)` of pairings and circle averages. -/
def eval (hC : (ℂ → ℝ) → ℝ) (hcirc : ℝ → ℂ → ℝ) : GFFObservable → ℝ
  | pairing φ => hC φ
  | circle r z => hcirc r z

/-- The integral of `f` against the (signed) smearing measure of an observable: `∫ φ(x) f(x) dx` for a pairing,
and the average of `f` over `∂B_r(z)` (Mathlib's `Real.circleAverage`) for a circle average. -/
noncomputable def smear : GFFObservable → (ℂ → ℝ) → ℝ
  | pairing φ, f => ∫ x, φ x * f x
  | circle r z, f => Real.circleAverage f z r

end GFFObservable

/-- The admissible observables, the index set of the Gaussian process `o ↦ o.eval (hC ω) (hcirc ω)`. -/
def GFFObservable.Admissible : Type :=
  {o : GFFObservable // o.IsAdmissible}

/-- The covariance of two observables of the whole-plane GFF: the kernel `wholePlaneCov` (eq:cov-kernel,
line 359) integrated against the smearing measures of both observables. -/
noncomputable def wholePlaneGFFCov (o o' : GFFObservable) : ℝ :=
  o.smear fun x => o'.smear fun y => wholePlaneCov x y

/-- `IsWholePlaneGFF P hC hcirc`: under the probability measure `P`, the pairings `hC ω φ = (h^ℂ, φ)` and the
circle averages `hcirc ω r z = h^ℂ_r(z)` are those of the whole-plane Gaussian free field `h^ℂ` normalized so
that `h^ℂ_1(0) = 0` (Section 2.1, lines 356-365):

* each pairing with a test function and each circle average of positive radius is a random variable;
* every finite family of them is a Gaussian vector (`IsGaussianProcess`, Mathlib), centered, with covariance
  `wholePlaneGFFCov` (eq:cov-kernel, line 359); since a centered Gaussian vector is determined in law by its
  covariance, this fixes the joint law of all observables;
* a.s. the circle average process `(r, z) ↦ h^ℂ_r(z)` is continuous on `(0, ∞) × ℂ` (Duplantier-Sheffield 2011,
  Prop. 3.1, which proves that it has such a modification).

The values of `hC ω` on non-test functions and of `hcirc ω r z` for `r ≤ 0` are unconstrained. The normalization
`h^ℂ_1(0) = 0` (line 365) is a consequence: `IsWholePlaneGFF.ae_circleAverage_one_zero`. -/
structure IsWholePlaneGFF {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (hC : Ω → (ℂ → ℝ) → ℝ) (hcirc : Ω → ℝ → ℂ → ℝ) : Prop where
  /-- Each pairing with a test function is a random variable. -/
  measurable_pairing : ∀ φ, IsTestFunction Set.univ φ → Measurable fun ω => hC ω φ
  /-- Each circle average of positive radius is a random variable. -/
  measurable_circle : ∀ r z, 0 < r → Measurable fun ω => hcirc ω r z
  /-- Finite families of admissible observables are jointly Gaussian. -/
  isGaussianProcess :
    IsGaussianProcess (fun (o : GFFObservable.Admissible) ω => o.1.eval (hC ω) (hcirc ω)) P
  /-- The field is centered. -/
  integral_eq_zero : ∀ o : GFFObservable, o.IsAdmissible → ∫ ω, o.eval (hC ω) (hcirc ω) ∂P = 0
  /-- The covariance is the kernel `wholePlaneCov` integrated against the smearing measures. -/
  covariance_eq : ∀ o o' : GFFObservable, o.IsAdmissible → o'.IsAdmissible →
    cov[fun ω => o.eval (hC ω) (hcirc ω), fun ω => o'.eval (hC ω) (hcirc ω); P] = wholePlaneGFFCov o o'
  /-- A.s. the circle average process is continuous in `(r, z) ∈ (0, ∞) × ℂ`. -/
  ae_continuousOn_circle :
    ∀ᵐ ω ∂P, ContinuousOn (fun p : ℝ × ℂ => hcirc ω p.1 p.2) (Set.Ioi 0 ×ˢ Set.univ)

/-- The pairing `(h, φ) = (h^ℂ, φ) - α₀ ∫ φ(x) log |x| dx` of the field `h = h^ℂ - α₀ log |·|` of the paper
(eq:gff, line 380), given the pairings `hC` of `h^ℂ`. -/
noncomputable def fieldPairing (α₀ : ℝ) (hC : (ℂ → ℝ) → ℝ) (φ : ℂ → ℝ) : ℝ :=
  hC φ - α₀ * ∫ x, φ x * Real.log ‖x‖

/-- The circle average `h_r(z) = h^ℂ_r(z) - α₀ · (average of log |·| over ∂B_r(z))` of the field
`h = h^ℂ - α₀ log |·|` of the paper (eq:gff, line 380), given the circle averages `hcirc` of `h^ℂ`. -/
noncomputable def fieldCircleAverage (α₀ : ℝ) (hcirc : ℝ → ℂ → ℝ) (r : ℝ) (z : ℂ) : ℝ :=
  hcirc r z - α₀ * Real.circleAverage (fun x => Real.log ‖x‖) z r

/-- The σ-algebra `σ(h|_U)` generated by the restriction of the field `h = h^ℂ - α₀ log |·|` to `U`, i.e. by the
pairings `(h, φ)` with test functions `φ` with `tsupport φ ⊆ U` (Prop. 1.3, Fact 2.1 II, line 407). It does not
depend on `α₀` (`fieldSigmaAlgebra_eq`). It is not completed: for open `U`, a functional of `h|_U` such as a
circle average over a circle in `U` is in general only a.s. equal to a `σ(h|_U)`-measurable random variable. -/
@[instance_reducible]
noncomputable def fieldSigmaAlgebra {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) : MeasurableSpace Ω :=
  ⨆ (φ : ℂ → ℝ) (_ : IsTestFunction U φ),
    MeasurableSpace.comap (fun ω => fieldPairing α₀ (hC ω) φ) inferInstance

/-! ### Sanity checks -/

/-- The covariance kernel is symmetric. -/
theorem wholePlaneCov_comm (z w : ℂ) : wholePlaneCov z w = wholePlaneCov w z := by
  rw [wholePlaneCov, wholePlaneCov, mul_comm (max ‖z‖ 1), norm_sub_rev]

/-- In the closed unit disk the covariance kernel is `-log |z - w|`. -/
theorem wholePlaneCov_eq_neg_log {z w : ℂ} (hz : ‖z‖ ≤ 1) (hw : ‖w‖ ≤ 1) :
    wholePlaneCov z w = -Real.log ‖z - w‖ := by
  rw [wholePlaneCov, max_eq_right hz, max_eq_right hw, one_mul, one_div, Real.log_inv]

/-- The kernel averaged over `y ∈ ∂B_1(0)` vanishes at every point `x` of the unit circle. -/
theorem circleAverage_wholePlaneCov_of_norm_eq_one {x : ℂ} (hx : ‖x‖ = 1) :
    Real.circleAverage (fun y => wholePlaneCov x y) 0 1 = 0 := by
  have h : Real.circleAverage (fun y => wholePlaneCov x y) 0 1 =
      Real.circleAverage (fun y => -Real.log ‖y - x‖) 0 1 := by
    apply Real.circleAverage_congr_sphere
    intro y hy
    have hy' : ‖y‖ = 1 := by simpa using hy
    simp only
    rw [wholePlaneCov_eq_neg_log hx.le hy'.le, norm_sub_rev]
  have h0 := circleAverage_log_norm_sub_const₁ hx
  rw [Real.circleAverage_def] at h0
  rw [h, Real.circleAverage_def, intervalIntegral.integral_neg, smul_neg, h0, neg_zero]

/-- The variance of the unit circle average `h^ℂ_1(0)` vanishes: the covariance `eq:cov-kernel` encodes the
normalization `h^ℂ_1(0) = 0` (line 365). -/
theorem wholePlaneGFFCov_circle_one_zero :
    wholePlaneGFFCov (.circle 1 0) (.circle 1 0) = 0 := by
  change Real.circleAverage (fun x => Real.circleAverage (fun y => wholePlaneCov x y) 0 1) 0 1 = 0
  rw [Real.circleAverage_congr_sphere (f₂ := fun _ => (0 : ℝ)), Real.circleAverage_const]
  intro x hx
  exact circleAverage_wholePlaneCov_of_norm_eq_one (by simpa using hx)

/-- Jensen's formula for `log |·|`: its average over `∂B_r(z)` is `log max(r, |z|)` (Mathlib's
`circleAverage_log_norm_sub_const_eq_log_radius_add_posLog`). -/
theorem circleAverage_log_norm {r : ℝ} (hr : 0 < r) (z : ℂ) :
    Real.circleAverage (fun x => Real.log ‖x‖) z r = Real.log (max r ‖z‖) := by
  have h := circleAverage_log_norm_sub_const_eq_log_radius_add_posLog (c := z) (a := 0) hr.ne'
  simp only [sub_zero] at h
  rw [h, Real.posLog_eq_log_max_one (by positivity), ← Real.log_mul hr.ne' (by positivity),
    mul_max_of_nonneg _ _ hr.le, mul_one, mul_inv_cancel_left₀ hr.ne']

/-- The circle averages of `h = h^ℂ - α₀ log |·|` are `h_r(z) = h^ℂ_r(z) - α₀ log max(r, |z|)`; in particular
`h_r(0) = h^ℂ_r(0) - α₀ log r`. -/
theorem fieldCircleAverage_eq (α₀ : ℝ) (hcirc : ℝ → ℂ → ℝ) {r : ℝ} (hr : 0 < r) (z : ℂ) :
    fieldCircleAverage α₀ hcirc r z = hcirc r z - α₀ * Real.log (max r ‖z‖) := by
  rw [fieldCircleAverage, circleAverage_log_norm hr]

namespace IsWholePlaneGFF

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω} {hC : Ω → (ℂ → ℝ) → ℝ}
  {hcirc : Ω → ℝ → ℂ → ℝ}

/-- The whole-plane GFF lives on a probability space. -/
theorem isProbabilityMeasure (hh : IsWholePlaneGFF P hC hcirc) : IsProbabilityMeasure P :=
  have : Nonempty GFFObservable.Admissible := ⟨⟨.circle 1 0, one_pos⟩⟩
  hh.isGaussianProcess.isProbabilityMeasure

/-- Each circle average of positive radius is Gaussian. -/
theorem hasGaussianLaw_circle (hh : IsWholePlaneGFF P hC hcirc) {r : ℝ} (hr : 0 < r) (z : ℂ) :
    HasGaussianLaw (fun ω => hcirc ω r z) P :=
  hh.isGaussianProcess.hasGaussianLaw_eval (⟨.circle r z, hr⟩ : GFFObservable.Admissible)

/-- The normalization `h^ℂ_1(0) = 0` (line 365) holds a.s. -/
theorem ae_circleAverage_one_zero (hh : IsWholePlaneGFF P hC hcirc) : ∀ᵐ ω ∂P, hcirc ω 1 0 = 0 := by
  have := hh.isProbabilityMeasure
  have hG := hh.hasGaussianLaw_circle one_pos 0
  have hL2 : MemLp (fun ω => hcirc ω 1 0) 2 P := hG.memLp (by simp)
  have hcov := hh.covariance_eq (.circle 1 0) (.circle 1 0) one_pos one_pos
  rw [wholePlaneGFFCov_circle_one_zero] at hcov
  have hvar : Var[fun ω => hcirc ω 1 0; P] = 0 := by
    rw [← covariance_self hG.aemeasurable]
    exact hcov
  have hmean : ∫ ω, hcirc ω 1 0 ∂P = 0 := hh.integral_eq_zero (.circle 1 0) one_pos
  filter_upwards [ae_eq_integral_of_variance_eq_zero hL2 hvar] with ω hω
  rw [hω, hmean]

/-- The σ-algebra `σ(h|_U)` is a sub-σ-algebra of the ambient one. -/
theorem fieldSigmaAlgebra_le (hh : IsWholePlaneGFF P hC hcirc) (α₀ : ℝ) (U : Set ℂ) :
    fieldSigmaAlgebra α₀ hC U ≤ ‹MeasurableSpace Ω› := by
  refine iSup₂_le fun φ hφ => ?_
  exact ((hh.measurable_pairing φ ⟨hφ.1, hφ.2.1, Set.subset_univ _⟩).sub_const _).comap_le

end IsWholePlaneGFF

/-- `σ(h|_U) = σ(h^ℂ|_U)`: the deterministic log singularity does not change the σ-algebra. -/
theorem fieldSigmaAlgebra_eq {Ω : Type*} (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    fieldSigmaAlgebra α₀ hC U = fieldSigmaAlgebra 0 hC U := by
  unfold fieldSigmaAlgebra
  congr 1; ext1 φ; congr 1; ext1 _
  have h1 : (fun ω => fieldPairing α₀ (hC ω) φ) =
      (fun t : ℝ => t - α₀ * ∫ x, φ x * Real.log ‖x‖) ∘ fun ω => fieldPairing 0 (hC ω) φ := by
    funext ω; simp [fieldPairing]
  rw [h1, ← MeasurableSpace.comap_comp]
  congr 1
  exact (MeasurableEquiv.subRight (α₀ * ∫ x, φ x * Real.log ‖x‖)).measurableEmbedding.comap_eq

end HarmonicBalls
