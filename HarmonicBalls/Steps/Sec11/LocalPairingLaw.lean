import HarmonicBalls.Defs.GFF
import Mathlib.MeasureTheory.Measure.Trim
import Mathlib.MeasureTheory.Measure.AbsolutelyContinuous

/-! # Local pairing laws

The restriction of a field is recorded by all of its test-function pairings.
Absolute continuity of these observable laws yields absolute continuity on
the local field sigma algebra.
-/

namespace HarmonicBalls

open Set MeasureTheory

/-- Test functions supported in the open set used to observe the field. -/
def LocalFieldTest (U : Set ℂ) := {φ : ℂ → ℝ // IsTestFunction U φ}

/-- The process of local pairings of the log-singular field. -/
noncomputable def localFieldPairings {Ω : Type*} (α₀ : ℝ)
    (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) (ω : Ω) : LocalFieldTest U → ℝ :=
  fun φ => fieldPairing α₀ (hC ω) φ.1

/-- The local field sigma algebra is generated by the full local pairing
process, including all finite joint observations. -/
theorem fieldSigmaAlgebra_eq_comap_localFieldPairings {Ω : Type*}
    (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) :
    fieldSigmaAlgebra α₀ hC U =
      MeasurableSpace.comap (localFieldPairings α₀ hC U) inferInstance := by
  apply le_antisymm
  · unfold fieldSigmaAlgebra
    refine iSup_le fun φ => iSup_le fun hφ => ?_
    have hp : Measurable[MeasurableSpace.comap (localFieldPairings α₀ hC U) inferInstance]
        (fun ω => fieldPairing α₀ (hC ω) φ) := by
      exact (measurable_pi_apply (⟨φ, hφ⟩ : LocalFieldTest U)).comp
        (comap_measurable (localFieldPairings α₀ hC U))
    exact measurable_iff_comap_le.mp hp
  · apply measurable_iff_comap_le.mp
    let : MeasurableSpace Ω := fieldSigmaAlgebra α₀ hC U
    apply measurable_pi_iff.mpr
    intro φ
    apply measurable_iff_comap_le.mpr
    unfold fieldSigmaAlgebra
    exact le_iSup_of_le φ.1 (le_iSup_of_le φ.2 le_rfl)

/-- Absolute continuity of observable pushforward laws is equivalent to
absolute continuity on the sigma algebra generated by the observable. -/
theorem trim_comap_absolutelyContinuous_iff
    {Ω A : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace A]
    (P Q : Measure Ω) (f : Ω → A) (hf : Measurable f) :
    P.trim hf.comap_le ≪ Q.trim hf.comap_le ↔ P.map f ≪ Q.map f := by
  constructor
  · intro h
    simpa only [map_trim_comap hf] using
      h.map (Measurable.of_comap_le (le_rfl : MeasurableSpace.comap f _ ≤ _))
  · intro h
    apply Measure.AbsolutelyContinuous.mk
    intro s hs hQs
    obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs
    rw [trim_comap_apply hf ht] at hQs ⊢
    exact h hQs

/-- A comparison of local pairing laws gives the local-field comparison used
in the rooted pinch-scale transfer. -/
theorem fieldSigmaAlgebra_trim_absolutelyContinuous_of_pairing_law
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P Q : Measure Ω)
    (α₀ : ℝ) (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ)
    (hm : fieldSigmaAlgebra α₀ hC U ≤ mΩ)
    (hAC : P.map (localFieldPairings α₀ hC U) ≪ Q.map (localFieldPairings α₀ hC U)) :
    P.trim hm ≪ Q.trim hm := by
  have hf : Measurable (localFieldPairings α₀ hC U) := by
    apply measurable_iff_comap_le.mpr
    rw [← fieldSigmaAlgebra_eq_comap_localFieldPairings]
    exact hm
  apply Measure.AbsolutelyContinuous.mk
  intro s hs hQs
  have hs' : MeasurableSet[MeasurableSpace.comap (localFieldPairings α₀ hC U)
      inferInstance] s := by
    rw [← fieldSigmaAlgebra_eq_comap_localFieldPairings]
    exact hs
  obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs'
  rw [trim_measurableSet_eq hm hs] at hQs ⊢
  rw [← Measure.map_apply hf ht] at hQs ⊢
  exact hAC hQs


end HarmonicBalls
