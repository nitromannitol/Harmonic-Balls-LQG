import HarmonicBalls.Proofs.Sec11.LQGBaseMetricObservable
import HarmonicBalls.Steps.Sec11.WholePlaneWeylShift
import HarmonicBalls.Steps.Sec11.WeylMetricConstantScaling

/-! # Composition of continuous field shifts

Distribution-measurable observables depend only on test-function pairings.
This permits composition of continuous shifts even when the pairing
functional is represented by an arbitrary function on all inputs.
-/

namespace HarmonicBalls

open MeasureTheory Set

/-- Distribution-measurable observables agree on functionals with the same
test-function pairings. -/
theorem eq_of_distribution_measurable_of_testPairing_eq
    {E : Type*} [MeasurableSpace E] [StandardBorelSpace E] [Nonempty E]
    (F : ((ℂ → ℝ) → ℝ) → E) (hF : Measurable[distributionMeasurableSpace] F)
    {T S : (ℂ → ℝ) → ℝ}
    (hTS : ∀ φ, IsTestFunction univ φ → T φ = S φ) : F T = F S := by
  obtain ⟨G, _, hG⟩ := exists_common_observable_of_distribution_measurable F hF
  rw [← hG T (fun _ _ => 0), ← hG S (fun _ _ => 0)]
  congr 1
  funext o
  rcases o with ⟨o, ho⟩
  cases o with
  | pairing φ => exact hTS φ ho
  | circle r z => rfl

/-- Adding two continuous functions in succession agrees on all test
functions with adding their sum. -/
theorem addFunPairing_addFunPairing_apply_test
    (T : (ℂ → ℝ) → ℝ) {f g : ℂ → ℝ} (hf : Continuous f) (hg : Continuous g)
    {φ : ℂ → ℝ} (hφ : IsTestFunction univ φ) :
    addFunPairing (addFunPairing T f) g φ =
      addFunPairing T (fun x => f x + g x) φ := by
  have hfi : Integrable (fun x => f x * φ x) :=
    (hf.mul hφ.1.continuous).integrable_of_hasCompactSupport hφ.2.1.mul_left
  have hgi : Integrable (fun x => g x * φ x) :=
    (hg.mul hφ.1.continuous).integrable_of_hasCompactSupport hφ.2.1.mul_left
  simp only [addFunPairing, add_mul, integral_add hfi hgi]
  ring

/-- The LQG metric respects composition of continuous field shifts. -/
theorem IsLQGMetric.addFunPairing_addFunPairing
    {γ ξ : ℝ} {𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ}
    (h𝔇 : IsLQGMetric γ ξ 𝔇) (T : (ℂ → ℝ) → ℝ)
    {f g : ℂ → ℝ} (hf : Continuous f) (hg : Continuous g) :
    𝔇 (addFunPairing (addFunPairing T f) g) =
      𝔇 (addFunPairing T (fun x => f x + g x)) := by
  funext u v
  exact eq_of_distribution_measurable_of_testPairing_eq (fun T => 𝔇 T u v)
    (h𝔇.measurable_apply u v) (fun φ hφ =>
      addFunPairing_addFunPairing_apply_test T hf hg hφ)

/-- A deterministic function shift does not change the local field sigma
algebra. No regularity is needed because the shift contributes a fixed
constant to each test-function pairing. -/
theorem fieldSigmaAlgebra_addFunPairing {Ω : Type*} (α₀ : ℝ)
    (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) (f : ℂ → ℝ) :
    fieldSigmaAlgebra α₀ (fun ω => addFunPairing (hC ω) f) U =
      fieldSigmaAlgebra α₀ hC U := by
  unfold fieldSigmaAlgebra
  congr 1; ext1 φ; congr 1; ext1 _
  have heq : (fun ω => fieldPairing α₀ (addFunPairing (hC ω) f) φ) =
      (fun t : ℝ => t + ∫ x, f x * φ x) ∘
        fun ω => fieldPairing α₀ (hC ω) φ := by
    funext ω
    simp only [Function.comp_apply, fieldPairing, addFunPairing]
    ring
  rw [heq, ← MeasurableSpace.comap_comp]
  congr 1
  exact (MeasurableEquiv.addRight (∫ x, f x * φ x)).measurableEmbedding.comap_eq

/-- Adding a deterministic continuous background alongside a random constant
preserves the sigma algebra generated by the random-constant shifted field. -/
theorem fieldSigmaAlgebra_background_add_random_constant {Ω : Type*} (α₀ : ℝ)
    (hC : Ω → (ℂ → ℝ) → ℝ) (U : Set ℂ) (f : ℂ → ℝ) (hf : Continuous f)
    (c : Ω → ℝ) :
    fieldSigmaAlgebra α₀ (fun ω => addFunPairing (hC ω) (fun z => f z + c ω)) U =
      fieldSigmaAlgebra α₀ (fun ω => addFunPairing (hC ω) (fun _ => c ω)) U := by
  calc
    _ = fieldSigmaAlgebra α₀
      (fun ω => addFunPairing (addFunPairing (hC ω) (fun _ => c ω)) f) U := by
        unfold fieldSigmaAlgebra
        congr 1; ext1 φ; congr 1; ext1 hφ
        congr 1
        funext ω
        unfold fieldPairing
        congr 1
        simpa only [add_comm (c ω)] using
          (addFunPairing_addFunPairing_apply_test (hC ω)
            (f := fun _ => c ω) (g := f) continuous_const hf
            (hφ.mono_set (subset_univ U))).symm
    _ = _ := fieldSigmaAlgebra_addFunPairing α₀ _ U f

/-- After a deterministic continuous background, a measurable random constant
rescales the LQG metric by its exponential Weyl factor. -/
theorem IsWholePlaneGFF.ae_metric_background_add_random_constant
    {Ω : Type} [MeasurableSpace Ω] {P : Measure Ω} {γ ξ : ℝ}
    {hC : Ω → (ℂ → ℝ) → ℝ} {hcirc : Ω → ℝ → ℂ → ℝ}
    (h : IsWholePlaneGFF P hC hcirc)
    (𝔇 : ((ℂ → ℝ) → ℝ) → ℂ → ℂ → ℝ) (h𝔇 : IsLQGMetric γ ξ 𝔇)
    (f : ℂ → ℝ) (hf : Continuous f) (c : Ω → ℝ) (hc : Measurable c) :
    ∀ᵐ ω ∂P, ∀ u v,
      𝔇 (addFunPairing (hC ω) (fun z => f z + c ω)) u v =
        Real.exp (ξ * c ω) * 𝔇 (addFunPairing (hC ω) f) u v := by
  have hb := h𝔇.satisfiesLQGMetricAxioms Ω P hC hcirc (fun _ => f) h
    (fun _ => hf) (fun _ => measurable_const)
  have hs := h𝔇.satisfiesLQGMetricAxioms Ω P hC hcirc
    (fun ω z => f z + c ω) h (fun _ => hf.add continuous_const)
    (fun _ => measurable_const.add hc)
  filter_upwards [hb.ae_isEuclideanLengthMetric, hb.ae_weylScaling,
    hs.ae_isEuclideanLengthMetric] with ω hb hw hs u v
  have horig : 0 ≤ 𝔇 (addFunPairing (hC ω) f) u v := by
    have htri := hb.triangle u v u
    rw [hb.self_eq_zero, hb.symm v u] at htri
    linarith
  have hshift : 0 ≤ 𝔇 (addFunPairing (hC ω) (fun z => f z + c ω)) u v := by
    have htri := hs.triangle u v u
    rw [hs.self_eq_zero, hs.symm v u] at htri
    linarith
  have hscale := weylScaling_add_const (𝔇 (addFunPairing (hC ω) f)) ξ (c ω) 0 u v
  simp only [Pi.zero_apply, zero_add] at hscale
  have heq := hw (fun _ => c ω) continuous_const u v
  rw [h𝔇.addFunPairing_addFunPairing (hC ω) hf continuous_const, hscale] at heq
  have hzero := hw (fun _ => 0) continuous_const u v
  have hz : addFunPairing (addFunPairing (hC ω) f) (fun _ => 0) =
      addFunPairing (hC ω) f := by
    funext φ
    simp [addFunPairing]
  rw [hz] at hzero
  change ENNReal.ofReal (𝔇 (addFunPairing (hC ω) f) u v) =
    weylScaling (𝔇 (addFunPairing (hC ω) f)) ξ 0 u v at hzero
  rw [← hzero] at heq
  have hr := congrArg ENNReal.toReal heq
  rw [ENNReal.toReal_ofReal hshift, ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (Real.exp_nonneg _), ENNReal.toReal_ofReal horig] at hr
  exact hr


end HarmonicBalls
